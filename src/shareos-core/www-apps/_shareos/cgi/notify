#!/usr/bin/ucode -S
// ShareOS app platform: messages through the box's notification service
// (web interface, e-mail, push), for apps with the permissions "files" and
// "notify" – admin accounts only
//   POST /_shareos/cgi/notify?g=<grant>   body: {"op": "send", …}
// ops: send {level info|warn|error, key, title, text}, clear {key}
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appnotify.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appnotify',
	ops: {
		send: [ 'level', 'key', 'title', 'text' ],
		clear: [ 'key' ]
	}
};
include('/usr/share/shareos/app-cgi.uc');
