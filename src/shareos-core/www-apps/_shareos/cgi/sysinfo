#!/usr/bin/ucode -S
// ShareOS app platform: the box's values (CPU, memory, temperature, fan,
// drives, processes), for apps with the permissions "files" and "sysinfo" –
// admin accounts only
//   POST /_shareos/cgi/sysinfo?g=<grant>   body: {"op": "info"}
// ops: info, processes, kill {pid, signal TERM|KILL|HUP}
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appsys.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appsys',
	ops: {
		info: [], processes: [],
		kill: [ 'pid', 'signal' ]
	}
};
include('/usr/share/shareos/app-cgi.uc');
