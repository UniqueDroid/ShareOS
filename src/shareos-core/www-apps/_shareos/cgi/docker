#!/usr/bin/ucode -S
// ShareOS app platform: Docker hosts of the homelab through their Docker
// Engine API (http://host:2375 or https://host:2376), for apps with the
// permissions "files" and "docker" – admin accounts only. Docker does not run
// on the box; the box talks to the hosts the admin added.
//   POST /_shareos/cgi/docker?g=<grant>   body: {"op": "containers", "host": "nuc", "all": true}
// ops: hosts, host_set {name, label, url, insecure}, host_del {name},
//      version {host}, info {host}, containers {host, all}, inspect {host, id},
//      logs {host, id, tail}, stats {host, id}, images {host},
//      action {host, id, action: start|stop|restart|pause|unpause}
// Only these fixed API calls – no exec, no new containers, no other paths.
// Grant and host addresses come from rpcd (shareos.appdocker); the calls run
// here (not in rpcd, which must not wait for the network).
import { stdin, stdout, readfile, popen, mkdtemp, unlink, rmdir } from 'fs';
import * as ubus from 'ubus';

const MGMT = { hosts: [], host_set: [ 'name', 'label', 'url', 'insecure' ], host_del: [ 'name' ] };
const ACTIONS = { start: 1, stop: 1, restart: 1, pause: 1, unpause: 1 };

function reply(status, obj) {
	stdout.write(sprintf('Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n%J\n', status, obj));
	exit(0);
}
function shq(s) { return "'" + replace(s, "'", "'\\''") + "'"; }

let g = match(getenv('QUERY_STRING') ?? '', /(^|&)g=([0-9a-f]{32})(&|$)/);
if (!g) reply('403 Forbidden', { error: 'no access' });
if (getenv('REQUEST_METHOD') != 'POST') reply('405 Method Not Allowed', { error: 'method not allowed' });
let len = +(getenv('CONTENT_LENGTH') ?? 0);
if (!(len > 0) || len > 4096) reply('413 Payload Too Large', { error: 'invalid request' });
let req = json(stdin.read(len) ?? 'null');
if (type(req) != 'object' || type(req.op) != 'string') reply('400 Bad Request', { error: 'invalid request' });

let conn = ubus.connect();
if (!conn) reply('503 Service Unavailable', { error: 'not ready' });

// managing the list of hosts: rpcd does it
if (exists(MGMT, req.op)) {
	let args = { grant: g[2] };
	for (let k in MGMT[req.op]) if (req[k] != null) args[k] = req[k];
	let r = conn.call('shareos.appdocker', req.op, args);
	if (r == null) reply('500 Internal Server Error', { error: 'failed' });
	reply(r.error == 'no access' ? '403 Forbidden' : '200 OK', r);
}

// one call to the Docker Engine API of a host
let id = req.id;
let id_ok = type(id) == 'string' && !!match(id, /^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/);
let method = 'GET', path = null;
if (req.op == 'version') path = '/version';
else if (req.op == 'info') path = '/info';
else if (req.op == 'images') path = '/images/json';
else if (req.op == 'containers') path = '/containers/json?all=' + (req.all === false ? '0' : '1');
else if (req.op == 'inspect' && id_ok) path = '/containers/' + id + '/json';
else if (req.op == 'stats' && id_ok) path = '/containers/' + id + '/stats?stream=false';
else if (req.op == 'logs' && id_ok) {
	let n = +(req.tail ?? 200);
	if (!(n >= 1 && n <= 2000)) n = 200;
	path = sprintf('/containers/%s/logs?stdout=1&stderr=1&timestamps=1&tail=%d', id, n);
} else if (req.op == 'action' && id_ok && ACTIONS[req.action]) { method = 'POST'; path = '/containers/' + id + '/' + req.action; }
if (!path) reply('400 Bad Request', { error: id_ok || !exists({ inspect: 1, stats: 1, logs: 1, action: 1 }, req.op) ? 'invalid request' : 'invalid container' });

let t = conn.call('shareos.appdocker', 'target', { grant: g[2], host: req.host ?? '' });
if (t == null) reply('500 Internal Server Error', { error: 'failed' });
if (t.error) reply(t.error == 'no access' ? '403 Forbidden' : '200 OK', t);

let dir = mkdtemp('/tmp/docker.XXXXXX');
if (!dir) reply('500 Internal Server Error', { error: 'failed' });
let fname = dir + '/body';
let p = popen(sprintf("curl -sS %s --connect-timeout 5 --max-time %d --max-filesize 8388608 -X %s -H 'Content-Type: application/json' -o %s -w '%%{http_code}' %s 2>&1",
	t.insecure ? '-k' : '', req.op == 'stats' ? 25 : 15, method, shq(fname), shq(t.url + path)), 'r');
let w = trim(p ? (p.read('all') ?? '') : '');
p?.close();
let body = readfile(fname) ?? '';
unlink(fname); rmdir(dir);
let m = match(w, /([0-9]{3})$/);
let code = m ? +m[1] : 0;
if (!code) reply('200 OK', { error: 'host not reachable: ' + (replace(w, /[0-9]{3}$/, '') || 'no answer') });

// logs of a container without TTY come in frames: 8-byte header (stream, 0, 0, 0, size)
function demux(s) {
	if (length(s) < 8 || ord(s, 0) > 2 || ord(s, 1) != 0 || ord(s, 2) != 0 || ord(s, 3) != 0) return s;
	let o = '', i = 0;
	while (i + 8 <= length(s)) {
		let n = (ord(s, i + 4) << 24) | (ord(s, i + 5) << 16) | (ord(s, i + 6) << 8) | ord(s, i + 7);
		o += substr(s, i + 8, n);
		i += 8 + n;
	}
	return o;
}

if (req.op == 'logs' && code < 300) {
	let text = demux(body);
	if (length(text) > 262144) text = substr(text, length(text) - 262144);
	reply('200 OK', { status: code, text });
}
let data = null;
try { data = json(body); } catch (e) { }
if (code >= 300) reply('200 OK', { status: code, error: data?.message ?? (code == 304 ? 'already in that state' : 'Docker answered ' + code) });
reply('200 OK', { status: code, data: data ?? (body == '' ? null : substr(body, 0, 4096)) });
