#!/usr/bin/ucode -S
// ShareOS app platform: the folders of the account, for apps with the
// permission "files" (e.g. a file manager, an editor that saves on the box)
//   POST /_shareos/cgi/fs?g=<grant>   body: {"op": "list", "root": …, …}
// ops: roots, list, mkdir, rename, move, delete, open (a ticket for
// /_shareos/cgi/file to read or write one file). The grant comes from the
// admin interface when the app is opened (rpcd shareos.files.app_grant): one
// app, one account, 8 hours. Everything is checked and done by the rpcd
// object shareos.appfs with the rights of that account.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appfs',
	ops: {
		roots: [],
		list: [ 'root', 'path', 'hidden' ],
		mkdir: [ 'root', 'path', 'name' ],
		rename: [ 'root', 'path', 'name', 'to' ],
		move: [ 'root', 'path', 'names', 'dest_root', 'dest', 'copy' ],
		delete: [ 'root', 'path', 'names' ],
		job: [ 'id' ],
		open: [ 'root', 'path', 'name', 'write', 'create' ],
		grant_app: [ 'app' ]
	},
	max: 65536
};
include('/usr/share/shareos/app-cgi.uc');
