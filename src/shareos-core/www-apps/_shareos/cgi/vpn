#!/usr/bin/ucode -S
// ShareOS app platform: the box as a VPN client (OpenVPN system app), for
// apps with the permissions "files" and "vpn" – admin accounts only (a VPN
// changes the network of the whole box)
//   POST /_shareos/cgi/vpn?g=<grant>   body: {"op": "list", …}
// ops: list, status, log, import {name, text, user, pass, full}, set {name,
// autostart, full, user, pass}, remove {name}, connect {name}, disconnect;
// server: server_status, server_log, server_set {enabled, port, proto, net,
// host, lan}, device_add / device_profile / device_remove {name}.
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appvpn.
import { stdin, stdout } from 'fs';
import * as ubus from 'ubus';

const OPS = {
	list: [], status: [], log: [], disconnect: [],
	import: [ 'name', 'text', 'user', 'pass', 'full' ],
	set: [ 'name', 'autostart', 'full', 'user', 'pass' ],
	remove: [ 'name' ],
	connect: [ 'name' ],
	server_status: [], server_log: [],
	server_set: [ 'enabled', 'port', 'proto', 'net', 'host', 'lan' ],
	device_add: [ 'name' ], device_profile: [ 'name' ], device_remove: [ 'name' ]
};

function reply(status, obj) {
	stdout.write(sprintf('Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n%J\n', status, obj));
	exit(0);
}

let g = match(getenv('QUERY_STRING') ?? '', /(^|&)g=([0-9a-f]{32})(&|$)/);
if (!g) reply('403 Forbidden', { error: 'no access' });
if (getenv('REQUEST_METHOD') != 'POST') reply('405 Method Not Allowed', { error: 'method not allowed' });
let len = +(getenv('CONTENT_LENGTH') ?? 0);
if (!(len > 0) || len > 300000) reply('413 Payload Too Large', { error: 'invalid request' });
let body = '';
while (length(body) < len) {
	let chunk = stdin.read(len - length(body));
	if (chunk == null || chunk == '') break;
	body += chunk;
}
let req = json(body || 'null');
if (type(req) != 'object' || type(req.op) != 'string' || !exists(OPS, req.op))
	reply('400 Bad Request', { error: 'invalid request' });

let args = { grant: g[2] };
for (let k in OPS[req.op])
	if (req[k] != null) args[k] = req[k];

let conn = ubus.connect();
if (!conn) reply('503 Service Unavailable', { error: 'not ready' });
let r = conn.call('shareos.appvpn', req.op, args);
if (r == null) reply('500 Internal Server Error', { error: 'failed' });
if (r.error == 'no access') reply('403 Forbidden', r);
reply('200 OK', r);
