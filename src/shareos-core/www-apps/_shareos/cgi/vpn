#!/usr/bin/ucode -S
// ShareOS app platform: the box as a VPN client (OpenVPN system app), for
// apps with the permissions "files" and "vpn" – admin accounts only (a VPN
// changes the network of the whole box)
//   POST /_shareos/cgi/vpn?g=<grant>   body: {"op": "list", …}
// ops: list, status, log, import {name, text, user, pass, full}, set {name,
// autostart, full, user, pass}, remove {name}, connect {name}, disconnect;
// server: server_status, server_log, server_set {enabled, port, proto, net,
// host, lan}, device_add / device_profile / device_remove {name}.
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appvpn.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appvpn',
	ops: {
		list: [], status: [], log: [], disconnect: [],
		import: [ 'name', 'text', 'user', 'pass', 'full' ],
		set: [ 'name', 'autostart', 'full', 'user', 'pass' ],
		remove: [ 'name' ],
		connect: [ 'name' ],
		server_status: [], server_log: [],
		server_set: [ 'enabled', 'port', 'proto', 'net', 'host', 'lan' ],
		device_add: [ 'name' ], device_profile: [ 'name' ], device_remove: [ 'name' ]
	},
	max: 300000
};
include('/usr/share/shareos/app-cgi.uc');
