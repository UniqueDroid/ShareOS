#!/usr/bin/ucode -S
// ShareOS app platform: vault shares (locked SMB shares that are unlocked on
// demand, discussion #88), for apps with the permissions "files" and "vault"
//   POST /_shareos/cgi/vault?g=<grant>   body: {"op": "status", …}
// ops: status, unlock {share, minutes, password}, lock {share},
// set {share, vault, default_ttl} (admin accounts only)
// The grant comes from the interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appvault.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appvault',
	ops: {
		status: [],
		unlock: [ 'share', 'minutes', 'password' ],
		lock: [ 'share' ],
		set: [ 'share', 'vault', 'default_ttl' ]
	}
};
include('/usr/share/shareos/app-cgi.uc');
