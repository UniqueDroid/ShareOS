#!/usr/bin/ucode -S
// ShareOS app platform: media jobs of the account (ffmpeg system app), for
// apps with the permissions "files" and "media"
//   POST /_shareos/cgi/media?g=<grant>   body: {"op": "probe", …}
// ops: probe (streams of a file), start (a job from fixed choices – no
// ffmpeg command line from the app), jobs, cancel, remove. The grant comes
// from the admin interface (one app, one account, 8 hours); everything is
// checked and done by the rpcd object shareos.appmedia.
import { stdin, stdout } from 'fs';
import * as ubus from 'ubus';

const OPS = {
	probe: [ 'root', 'path', 'name' ],
	start: [ 'input', 'output', 'action', 'format', 'bitrate', 'stream', 'start', 'duration' ],
	jobs: [],
	cancel: [ 'id' ],
	remove: [ 'id' ]
};

function reply(status, obj) {
	stdout.write(sprintf('Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n%J\n', status, obj));
	exit(0);
}

let g = match(getenv('QUERY_STRING') ?? '', /(^|&)g=([0-9a-f]{32})(&|$)/);
if (!g) reply('403 Forbidden', { error: 'no access' });
if (getenv('REQUEST_METHOD') != 'POST') reply('405 Method Not Allowed', { error: 'method not allowed' });
let len = +(getenv('CONTENT_LENGTH') ?? 0);
if (!(len > 0) || len > 65536) reply('413 Payload Too Large', { error: 'invalid request' });
let req = json(stdin.read(len) ?? 'null');
if (type(req) != 'object' || type(req.op) != 'string' || !exists(OPS, req.op))
	reply('400 Bad Request', { error: 'invalid request' });

let args = { grant: g[2] };
for (let k in OPS[req.op])
	if (req[k] != null) args[k] = req[k];

let conn = ubus.connect();
if (!conn) reply('503 Service Unavailable', { error: 'not ready' });
let r = conn.call('shareos.appmedia', req.op, args);
if (r == null) reply('500 Internal Server Error', { error: 'failed' });
if (r.error == 'no access') reply('403 Forbidden', r);
reply('200 OK', r);
