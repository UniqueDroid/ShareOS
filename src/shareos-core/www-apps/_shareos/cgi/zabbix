#!/usr/bin/ucode -S
// ShareOS app platform: the Zabbix agent of the box (system app
// "zabbix-agent"), for apps with the permissions "files" and "zabbix" – admin
// accounts only (one agent for the whole box)
//   POST /_shareos/cgi/zabbix?g=<grant>   body: {"op": "status", …}
// ops: status, log, restart, set {enabled, server, hostname, metadata,
//      psk_identity, psk, passive, allow, port, disk_interval} (as
//      shareos-zabbix set: every value is checked, psk "" removes the key)
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appzabbix. The
// pre-shared key is never sent back (status: psk true/false).
import { stdin, stdout } from 'fs';
import * as ubus from 'ubus';

// JSON text -> value; null when the text is not JSON (never an exception:
// a damaged file or a tool that printed an error must not end the call)
function jparse(s) { try { return json(s); } catch (e) { return null; } }

const OPS = {
	status: [], log: [], restart: [],
	set: [ 'enabled', 'server', 'hostname', 'metadata', 'psk_identity', 'psk', 'passive', 'allow', 'port', 'disk_interval' ]
};

function reply(status, obj) {
	stdout.write(sprintf('Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n%J\n', status, obj));
	exit(0);
}

let g = match(getenv('QUERY_STRING') ?? '', /(^|&)g=([0-9a-f]{32})(&|$)/);
if (!g) reply('403 Forbidden', { error: 'no access' });
if (getenv('REQUEST_METHOD') != 'POST') reply('405 Method Not Allowed', { error: 'method not allowed' });
let len = +(getenv('CONTENT_LENGTH') ?? 0);
if (!(len > 0) || len > 65536) reply('413 Payload Too Large', { error: 'invalid request' });
let body = '';
while (length(body) < len) {
	let chunk = stdin.read(len - length(body));
	if (chunk == null || chunk == '') break;
	body += chunk;
}
let req = jparse(body || 'null');
if (type(req) != 'object' || type(req.op) != 'string' || !exists(OPS, req.op))
	reply('400 Bad Request', { error: 'invalid request' });

let args = { grant: g[2] };
for (let k in OPS[req.op])
	if (req[k] != null) args[k] = req[k];

// set restarts the agent: that can take a while
let conn = ubus.connect(null, 120);
if (!conn) reply('503 Service Unavailable', { error: 'not ready' });
let r = conn.call('shareos.appzabbix', req.op, args);
if (r == null) reply('400 Bad Request', { error: 'invalid values' });
if (r.error == 'no access') reply('403 Forbidden', r);
reply('200 OK', r);
