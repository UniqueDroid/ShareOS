#!/usr/bin/ucode -S
// ShareOS app platform: download automation with autobrr (system app
// "autobrr"), for apps with the permissions "files" and "autobrr" – admin
// accounts only (one autobrr for the whole box)
//   POST /_shareos/cgi/autobrr?g=<grant>   body: {"op": "status", …}
// ops: status, log, start, accounts, set {enabled, ui, account},
//      password {password}, api {method, path, body} (autobrr's REST API)
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.appautobrr.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appautobrr',
	ops: {
		status: [], log: [], start: [], accounts: [],
		set: [ 'enabled', 'ui', 'account' ],
		password: [ 'password' ],
		api: [ 'method', 'path', 'body' ]
	},
	max: 262144
};
include('/usr/share/shareos/app-cgi.uc');
