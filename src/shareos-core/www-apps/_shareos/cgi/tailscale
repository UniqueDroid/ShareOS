#!/usr/bin/ucode -S
// ShareOS app platform: remote access with Tailscale (system app "tailscaled"),
// for apps with the permissions "files" and "tailscale" – admin accounts only
// (it changes the network of the whole box)
//   POST /_shareos/cgi/tailscale?g=<grant>   body: {"op": "status", …}
// ops: status, log, up {authkey}, login, down, logout, ping {ip}
// The grant comes from the admin interface (one app, one account, 8 hours);
// everything is checked and done by the rpcd object shareos.apptailscale.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.apptailscale',
	ops: {
		status: [], log: [], login: [], down: [], logout: [],
		up: [ 'authkey' ],
		ping: [ 'ip' ]
	}
};
include('/usr/share/shareos/app-cgi.uc');
