#!/usr/bin/ucode -S
// ShareOS app platform: Tuya smart-home devices in the local network
// (protocol 3.3/3.4, no cloud), for apps with the permissions "files" and
// "tuya" – admin accounts only
//   POST /_shareos/cgi/tuya?g=<grant>
//   body: {"op": "discover", "seconds": 6}
//         {"op": "status", "ip": "192.168.1.40", "id": "<device id>", "key": "<local key>", "version": "3.3"}
//         {"op": "set", …same…, "dps": {"1": true}}
// The app keeps its devices and local keys (in the user's folder); the box
// only talks to them with /usr/sbin/shareos-tuya. The grant is checked by
// rpcd (shareos.apptuya), the network work runs here.
import { stdin, stdout, popen } from 'fs';
import * as ubus from 'ubus';

function reply(status, obj) {
	stdout.write(sprintf('Status: %s\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n%J\n', status, obj));
	exit(0);
}
function shq(s) { return "'" + replace(s, "'", "'\\''") + "'"; }

let g = match(getenv('QUERY_STRING') ?? '', /(^|&)g=([0-9a-f]{32})(&|$)/);
if (!g) reply('403 Forbidden', { error: 'no access' });
if (getenv('REQUEST_METHOD') != 'POST') reply('405 Method Not Allowed', { error: 'method not allowed' });
let len = +(getenv('CONTENT_LENGTH') ?? 0);
if (!(len > 0) || len > 4096) reply('413 Payload Too Large', { error: 'invalid request' });
let req = json(stdin.read(len) ?? 'null');
if (type(req) != 'object' || !(req.op in { discover: 1, status: 1, set: 1 })) reply('400 Bad Request', { error: 'invalid request' });

let conn = ubus.connect();
if (!conn) reply('503 Service Unavailable', { error: 'not ready' });
if (conn.call('shareos.apptuya', 'allowed', { grant: g[2] })?.ok !== true) reply('403 Forbidden', { error: 'no access' });

function run(args) {
	let p = popen('/usr/sbin/shareos-tuya ' + join(' ', map(args, shq)) + ' 2>&1', 'r');
	let out = trim(p ? (p.read('all') ?? '') : '');
	p?.close();
	let j = null;
	try { j = json(out); } catch (e) { }
	return type(j) == 'object' ? j : { ok: false, error: out || 'failed' };
}

if (req.op == 'discover') {
	let s = +(req.seconds ?? 6);
	let r = run([ 'discover', '' + (s >= 1 && s <= 20 ? int(s) : 6) ]);
	if (!r.ok) reply('200 OK', { error: r.error });
	// the devices' own announcement: ip, gwId (device id), productKey, version …
	reply('200 OK', { devices: map(r.devices ?? [], (d) => ({ ip: d.info?.ip ?? d.from, id: d.info?.gwId ?? null,
		product: d.info?.productKey ?? null, version: d.info?.version ?? null, encrypted: d.info?.encrypt ?? null })) });
}

let ip = req.ip, id = req.id, key = req.key, ver = req.version ?? '3.3';
if (type(ip) != 'string' || !match(ip, /^([0-9]{1,3}\.){3}[0-9]{1,3}$/)) reply('200 OK', { error: 'invalid IP address' });
if (type(id) != 'string' || !match(id, /^[A-Za-z0-9]{6,32}$/)) reply('200 OK', { error: 'invalid device id' });
if (type(key) != 'string' || length(key) != 16 || match(key, /[[:cntrl:]]/)) reply('200 OK', { error: 'the local key has 16 characters' });
if (!(ver in { '3.3': 1, '3.4': 1 })) reply('200 OK', { error: 'protocol version 3.3 or 3.4' });
let args = [ req.op, ip, id, key, ver ];
if (req.op == 'set') {
	if (type(req.dps) != 'object' || !length(req.dps) || length(req.dps) > 16) reply('200 OK', { error: 'invalid dps' });
	for (let k, v in req.dps)
		if (!match(k, /^[0-9]{1,3}$/) || !(type(v) in { bool: 1, int: 1, double: 1, string: 1 }) || (type(v) == 'string' && length(v) > 255))
			reply('200 OK', { error: 'invalid dps' });
	push(args, sprintf('%J', req.dps));
}
let r = run(args);
if (!r.ok) reply('200 OK', { error: r.error });
// 3.3 answers {devId, dps}, 3.4 {protocol, t, data: {dps}}
let dps = r.data?.dps ?? r.data?.data?.dps ?? null;
reply('200 OK', { ok: true, dps });
