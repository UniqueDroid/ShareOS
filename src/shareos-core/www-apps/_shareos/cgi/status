#!/usr/bin/ucode -S
// ShareOS app platform: the status chip of an app in the header of the
// ShareOS interface, for apps with the permissions "files" and "status"
//   POST /_shareos/cgi/status?g=<grant>   body: {"op": "set", "text": …}
// ops: set {text (max 24 characters), state ok|warn|err|info, ttl seconds
// (max 600; the chip goes when it is not set again)}, clear. Shown to the
// account that opened the app; checked and kept by rpcd shareos.appstatus.
// What all these CGIs share is in /usr/share/shareos/app-cgi.uc.
global.APP_CGI = {
	object: 'shareos.appstatus',
	ops: {
		set: [ 'text', 'state', 'ttl' ],
		clear: []
	}
};
include('/usr/share/shareos/app-cgi.uc');
