#!/bin/sh
# Transmission daemons of the accounts that used Transmission (one per
# account, see shareos-transmission). Only when the system app
# "transmission-daemon" is installed; started in the background so the box
# is up before the drives are read.
case "$1" in
	start)
		[ -x /opt/shareos/bin/transmission-daemon ] || exit 0
		(sleep 5; /usr/sbin/shareos-transmission boot | logger -t shareos-transmission) >/dev/null 2>&1 &
		;;
	stop)
		[ -d /tmp/shareos-transmission ] && /usr/sbin/shareos-transmission stop-all >/dev/null 2>&1
		;;
	restart)
		"$0" stop; "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"; exit 1
		;;
esac
exit 0
