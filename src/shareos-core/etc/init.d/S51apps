#!/bin/sh
# Web server for ShareOS web apps: /www-apps on its own port (apps.store.port),
# another origin than the admin interface on port 80/443.
# /_shareos/ (from the firmware): theme.css and app.js for the apps, and
# /_shareos/cgi/file – the file an app was opened with (ticket).
# Supervised by shareos-uhttpd (restarts it if it exits, reads the
# certificate again on every start).
PID=/var/run/shareos-uhttpd-apps.pid
DIR=/www-apps

start() {
	# system apps readable for every account (older versions made them root-only)
	/usr/sbin/shareos-apps fix-perms >/dev/null 2>&1
	# area "Apps" switched off under System -> Appearance
	[ "$(uci -q get shareos.ui.area_apps)" = 0 ] && return 0
	mkdir -p $DIR
	[ -f $DIR/index.html ] || cat > $DIR/index.html <<'X'
<!doctype html><meta charset="utf-8"><title>ShareOS Apps</title>
<script>location.replace(location.protocol + '//' + location.hostname + '/#/apps');</script>
X
	# the web server of older versions (without supervisor)
	[ -f /var/run/uhttpd-apps.pid ] && { start-stop-daemon -K -q -p /var/run/uhttpd-apps.pid; rm -f /var/run/uhttpd-apps.pid; }
	start-stop-daemon -S -q -b -m -p $PID -x /bin/sh -- /usr/sbin/shareos-uhttpd apps
}

stop() {
	start-stop-daemon -K -q -p $PID 2>/dev/null
	rm -f $PID
	# the supervisor stops its uhttpd on TERM; one still running is ended here
	sleep 1; pgrep -f 'uhttpd .*-h /www-apps' >/dev/null && pkill -f 'uhttpd .*-h /www-apps'
	return 0
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
