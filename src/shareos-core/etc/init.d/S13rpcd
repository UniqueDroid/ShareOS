#!/bin/sh
# rpcd – ubus RPC daemon: sessions/ACLs, uci, ShareOS backend (ucode plugins)
PID=/var/run/rpcd.pid
case "$1" in
	start)
		printf "Starting rpcd: "
		start-stop-daemon -S -q -b -m -p $PID -x /usr/sbin/shareos-supervise -- rpcd /usr/sbin/rpcd -s /var/run/ubus/ubus.sock -t 30 \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping rpcd: "
		start-stop-daemon -K -q -p $PID && echo "OK" || echo "FAIL"
		;;
	reload|restart) "$0" stop; sleep 1; "$0" start ;;
	*) echo "Usage: $0 {start|stop|restart|reload}"; exit 1 ;;
esac
