# SMB (ksmbd) and NFS shares – applied by shareos-shares
# (web interface: Shares). Example:
#
# config share 'fotos'
#	option volume 'data'
#	option path 'Fotos'          # folder on the volume
#	option smb '1'
#	option guest '0'             # 1 = everyone may read without a password
#	list rw 'jan'                # users and @groups with write access
#	list ro '@familie'           # users and @groups with read access
#	option nfs '0'
#	option nfs_rw '0'
#	list nfs_hosts '192.168.1.0/24'
#	option vault '0'             # 1 = locked, unlocked on demand for some minutes
#	option vault_ttl '15'        # default minutes when unlocking (1-480)

config global 'global'
	option workgroup 'WORKGROUP'
	option smb '1'
	option nfs '1'
