#!/bin/sh
#
# shareos-cloud – cloud sync with rclone
#
#   shareos-cloud install              download rclone into the apps area
#                                      (/mnt/<apps>/.shareos/bin) and check it
#   shareos-cloud remote-add <owner> <name> <type> [key=value ...]
#                                      secrets (pass=, secret_access_key=) on
#                                      stdin as key=value lines; type raw =
#                                      an rclone.conf section on stdin
#   shareos-cloud auth-start <owner> <type>
#                                      sign in at an OAuth service (Google
#                                      Drive, OneDrive, Dropbox …): prints
#                                      url=<sign-in page>
#   shareos-cloud auth-finish <owner> <address>
#                                      the address the browser was sent to
#                                      after signing in (http://127.0.0.1:53682/?…,
#                                      not reachable from the PC): handed to
#                                      rclone on the box, which keeps the token
#                                      for the next remote-add of this owner
#   shareos-cloud remote-del <owner> <name>
#   shareos-cloud remote-test <owner> <name>
#   shareos-cloud run <job>            run a job now (also from cron)
#   shareos-cloud stop <job>
#   shareos-cloud status               key=value lines for the web interface
#
# owner "-" = the system (admin), otherwise a ShareOS user. Remotes live in
# the owner's rclone.conf (system: /etc/shareos/cloud/rclone.conf, user:
# ~/.config/rclone/rclone.conf); jobs are UCI sections cloud.<job> and run
# as their owner, so a user's storage limit applies to what they download.
#
PATH=${SHAREOS_TEST_PATH:+$SHAREOS_TEST_PATH:}/usr/sbin:/usr/bin:/sbin:/bin
VERSION=${SHAREOS_RCLONE_VERSION:-1.75.2}
DL=${SHAREOS_RCLONE_URL:-https://github.com/rclone/rclone/releases/download}
ST=/tmp/shareos-cloud
SYSCONF=/etc/shareos/cloud/rclone.conf
NAME_RE='^[a-z][a-z0-9_]{0,31}$'

die() { echo "error: $*" >&2; exit 1; }
log() { logger -t shareos-cloud "$*"; }

apps_dir() {
	a=$(uci -q get storage.global.apps)
	[ -n "$a" ] && grep -q " /mnt/$a " /proc/mounts && echo "/mnt/$a/.shareos"
}
rclone_bin() {
	for b in "$(apps_dir)/bin/rclone" /usr/bin/rclone; do [ -x "$b" ] && { echo "$b"; return 0; }; done
	return 1
}

owner_home() {   # owner -> home directory (users only)
	v=$(uci -q get accounts."$1".home)
	[ -n "$v" ] && echo "/mnt/$v/home/$1"
}
conf_of() {   # owner -> rclone.conf path
	if [ "$1" = - ]; then echo $SYSCONF; else h=$(owner_home "$1") && [ -n "$h" ] && echo "$h/.config/rclone/rclone.conf"; fi
}
check_owner() {
	[ "$1" = - ] && return 0
	[ "$(uci -q get accounts."$1")" = user ] || die "unknown user $1"
	[ -n "$(owner_home "$1")" ] || die "user $1 has no personal folder (needed for cloud settings)"
}
# run a command as the owner (users have no login shell)
as_owner() {   # owner cmd...
	o=$1; shift
	if [ "$o" = - ]; then "$@"; return; fi
	cmd=; for a; do cmd="$cmd '$(printf %s "$a" | sed "s/'/'\\\\''/g")'"; done
	HOME=$(owner_home "$o") su -s /bin/sh "$o" -c "umask 077; $cmd"
}

ensure_conf() {   # owner
	c=$(conf_of "$1") || die "no place for the settings of $1"
	d=${c%/*}
	if [ ! -d "$d" ]; then
		mkdir -p "$d"
		[ "$1" = - ] && chmod 700 "$d" || { chown -R "$1":users "${d%/rclone}" "$d"; chmod 700 "$d"; }
	fi
	[ -f "$c" ] || { : > "$c"; chmod 600 "$c"; [ "$1" = - ] || chown "$1":users "$c"; }
	echo "$c"
}

# --- install ----------------------------------------------------------------------
cmd_install() {
	ad=$(apps_dir) || die "no apps area – set up a volume first (Storage)"
	mkdir -p $ST
	echo "state=installing" > $ST/install
	t=$ad/tmp/rclone.$$; rm -rf "$t"; mkdir -p "$t"
	zip=rclone-v$VERSION-linux-arm.zip
	if ! curl -fsSL --retry 2 -o "$t/$zip" "$DL/v$VERSION/$zip" || ! curl -fsSL -o "$t/SHA256SUMS" "$DL/v$VERSION/SHA256SUMS"; then
		rm -rf "$t"; echo "state=error" > $ST/install; echo "error=download failed" >> $ST/install; die "download failed"
	fi
	want=$(grep " $zip\$" "$t/SHA256SUMS" | awk '{print $1}' | head -1)
	have=$(sha256sum "$t/$zip" | awk '{print $1}')
	if [ -z "$want" ] || [ "$want" != "$have" ]; then
		rm -rf "$t"; printf 'state=error\nerror=checksum mismatch\n' > $ST/install; die "checksum mismatch"
	fi
	(cd "$t" && unzip -q "$zip") || { rm -rf "$t"; printf 'state=error\nerror=unzip failed\n' > $ST/install; die "unzip failed"; }
	mkdir -p "$ad/bin"
	install -m 0755 "$t"/rclone-v$VERSION-linux-arm/rclone "$ad/bin/rclone.new" && mv "$ad/bin/rclone.new" "$ad/bin/rclone"
	rm -rf "$t"
	v=$("$ad/bin/rclone" version 2>/dev/null | head -1)
	[ -n "$v" ] || { printf 'state=error\nerror=rclone does not run on this box\n' > $ST/install; die "rclone does not run"; }
	ln -sf "$ad/bin/rclone" /usr/bin/rclone
	uci set cloud.global=global; uci set cloud.global.version="$VERSION"; uci commit cloud
	printf 'state=done\nversion=%s\n' "$v" > $ST/install
	log "installed $v"
	echo "$v"
}

# --- remotes ----------------------------------------------------------------------
cmd_remote_add() {   # owner name type [k=v...]; secrets on stdin
	o=$1 n=$2 type=$3; shift 3 || die "usage: remote-add <owner> <name> <type>"
	check_owner "$o"
	echo "$n" | grep -qE "$NAME_RE" || die "invalid name (a-z, 0-9 and _)"
	rc=$(rclone_bin) || die "rclone is not installed"
	c=$(ensure_conf "$o")
	grep -q "^\[$n\]" "$c" && die "a connection named $n exists"
	# known services: our names -> rclone backends; OAuth ones take the token
	# from auth-finish
	case "$type" in
		webdav|s3|sftp|ftp|smb|mega|b2|koofr) btype=$type ;;
		gdrive) btype=drive ;; gphotos) btype='google photos' ;;
		onedrive|dropbox|box|pcloud|yandex) btype=$type ;;
		raw) btype=raw ;;
		*) die "unknown type $type" ;;
	esac
	if [ "$type" = raw ]; then
		sect=$(cat)
		echo "$sect" | head -1 | grep -qE '^\[[A-Za-z0-9_-]+\]$' || die "the pasted text must start with [name]"
		echo "$sect" | sed "1s/.*/[$n]/" >> "$c"
	else
		for kv; do echo "$kv" | grep -qE '^[a-z_]+=' || die "invalid option $kv"; done
		# secrets from stdin, appended to the arguments
		while IFS= read -r kv; do [ -n "$kv" ] && set -- "$@" "$kv"; done
		case "$type" in gdrive|gphotos|onedrive|dropbox|box|pcloud|yandex)
			[ -s $ST/auth.token ] && [ "$(cat $ST/auth.owner 2>/dev/null)" = "$o" ] && [ "$(cat $ST/auth.type 2>/dev/null)" = "$type" ] \
				|| die "sign in first (the sign-in is missing or for another service)"
			tok=$(cat $ST/auth.token)
			set -- "$@" "token=$tok"
			# OneDrive: rclone only asks for the drive interactively, and
			# without drive_id/drive_type the remote does not work (#92)
			if [ "$type" = onedrive ]; then
				case " $* " in *" drive_id="*) ;; *)
					od_drive "$tok" || die "OneDrive: the drive of the account could not be read – sign in again"
					set -- "$@" "drive_id=$OD_ID" "drive_type=$OD_TYPE" ;;
				esac
			fi ;;
		esac
		as_owner "$o" "$rc" config create "$n" "$btype" "$@" --obscure --non-interactive --config "$c" >/dev/null 2>$ST.err \
			|| { e=$(tail -n1 $ST.err); rm -f $ST.err; die "${e:-rclone config failed}"; }
		rm -f $ST.err
		# the sign-in is used up only now: after a failure "Add" can be tried again
		rm -f $ST/auth.token
	fi
	[ "$o" = - ] || chown "$o":users "$c"
	echo "ok"
}

# a value of a JSON object on stdin
json_get() { K=$1 ucode -l fs -e 'let d = json(fs.stdin.read("all") || "null"); print(d?.[getenv("K")] ?? "")' 2>/dev/null; }

# the OneDrive of a signed-in account (Microsoft Graph /me/drive): OD_ID, OD_TYPE
od_drive() {   # token JSON
	at=$(printf '%s' "$1" | json_get access_token)
	[ -n "$at" ] || return 1
	d=$(printf 'Authorization: Bearer %s\n' "$at" | curl -fsS --max-time 30 -H @- "${SHAREOS_GRAPH_URL:-https://graph.microsoft.com/v1.0}/me/drive") || return 1
	OD_ID=$(printf '%s' "$d" | json_get id); OD_TYPE=$(printf '%s' "$d" | json_get driveType)
	echo "$OD_ID" | grep -qE '^[A-Za-z0-9!._-]+$' && echo "$OD_TYPE" | grep -qE '^(personal|business|documentLibrary)$'
}

# --- OAuth sign-in (rclone authorize on the box) -------------------------------------
# rclone waits on 127.0.0.1:53682 for the browser to come back. The browser of
# the PC cannot reach that, so the user copies the address it ended up on and
# auth-finish hands it to rclone here.
auth_kill() {
	[ -f $ST/auth.pid ] && { p=$(cat $ST/auth.pid); pkill -P "$p" 2>/dev/null; kill "$p" 2>/dev/null; }
	rm -f $ST/auth.pid
}

cmd_auth_start() {   # owner type
	o=$1 type=$2
	check_owner "$o"
	case "$type" in gdrive) b=drive ;; gphotos) b='google photos' ;; onedrive|dropbox|box|pcloud|yandex) b=$type ;; *) die "no sign-in for $type" ;; esac
	rc=$(rclone_bin) || die "rclone is not installed"
	mkdir -p $ST; auth_kill; rm -f $ST/auth.token $ST/auth.out
	printf '%s' "$o" > $ST/auth.owner; printf '%s' "$type" > $ST/auth.type
	umask 077
	HOME=$ST timeout 900 "$rc" authorize "$b" --auth-no-open-browser --config /dev/null > $ST/auth.out 2>&1 < /dev/null &
	echo $! > $ST/auth.pid
	i=0; url=
	while [ $i -lt 40 ] && [ -z "$url" ]; do
		sleep 0.5; i=$((i + 1))
		url=$(sed -n 's/.*go to the following link: \(http[^ ]*\).*/\1/p' $ST/auth.out 2>/dev/null | head -1)
	done
	[ -n "$url" ] || { auth_kill; die "rclone did not start the sign-in: $(tail -n1 $ST/auth.out 2>/dev/null)"; }
	# the local page only forwards to the service: hand out the real address
	real=$(curl -s -o /dev/null -w '%{redirect_url}' --max-time 10 "$url")
	echo "url=${real:-$url}"
}

cmd_auth_finish() {   # owner address
	o=$1 a=$2
	[ "$(cat $ST/auth.owner 2>/dev/null)" = "$o" ] && [ -f $ST/auth.pid ] || die "start the sign-in again"
	q=$(printf '%s' "$a" | sed -n 's#^ *https\{0,1\}://\(127\.0\.0\.1\|localhost\):53682/\(?[^ ]*\) *$#\2#p')
	[ -n "$q" ] || die "paste the whole address from the browser (starts with http://127.0.0.1:53682/)"
	curl -s -o /dev/null --max-time 60 "http://127.0.0.1:53682/$q"
	i=0
	while [ $i -lt 60 ] && ! grep -q '<---End paste' $ST/auth.out 2>/dev/null && kill -0 "$(cat $ST/auth.pid 2>/dev/null)" 2>/dev/null; do sleep 0.5; i=$((i + 1)); done
	tok=$(sed -n '/Paste the following into your remote machine --->/,/<---End paste/p' $ST/auth.out | sed '1d;$d' | tr -d '\n')
	auth_kill
	if [ -z "$tok" ]; then
		e=$(grep -i 'error\|failed' $ST/auth.out | tail -n1 | sed 's/^[0-9/ :]*\(NOTICE\|ERROR\|CRITICAL\): *//' | cut -c1-200)
		die "sign-in failed: ${e:-no answer from the service}"
	fi
	( umask 077; printf '%s' "$tok" > $ST/auth.token )
	echo "ok"
}

cmd_remote_del() {
	o=$1 n=$2
	c=$(conf_of "$o") || die "unknown owner"
	[ -f "$c" ] && grep -q "^\[$n\]" "$c" || die "unknown connection $n"
	awk -v s="[$n]" '/^\[/ {skip = ($0 == s)} !skip' "$c" > "$c.new" && cat "$c.new" > "$c" && rm -f "$c.new"
	echo "ok"
}

cmd_remote_test() {
	o=$1 n=$2
	rc=$(rclone_bin) || die "rclone is not installed"
	c=$(conf_of "$o") || die "unknown owner"
	out=$(as_owner "$o" timeout 40 "$rc" lsd "$n:" --max-depth 1 --config "$c" --contimeout 15s --low-level-retries 1 --retries 1 2>&1)
	if [ $? = 0 ]; then echo "ok folders=$(echo "$out" | grep -c .)"; else echo "error: $(echo "$out" | grep -v '^$' | tail -n1 | cut -c1-200)"; exit 1; fi
}

cmd_remotes() {   # owner -> name:type lines
	c=$(conf_of "$1") || return 0
	[ -f "$c" ] || return 0
	# section name and type per remote ("name:type")
	sed -n -e 's/^\[\(.*\)\]$/S \1/p' -e 's/^type *= *//p' "$c" | awk '/^S / {n = substr($0, 3); next} {print n ":" $0}'
}

# --- jobs -------------------------------------------------------------------------
job() { uci -q get cloud."$J".$1; }

local_path() {   # job -> local directory
	l=$(job local); o=$(job owner); o=${o:--}
	case "$l" in
		home) [ "$o" != - ] && owner_home "$o" ;;
		share:*)
			s=${l#share:}; v=$(uci -q get shares."$s".volume); p=$(uci -q get shares."$s".path); p=${p:-$s}
			[ -n "$v" ] && echo "/mnt/$v/$p" ;;
		home:*) [ "$o" != - ] && h=$(owner_home "$o") && echo "$h/${l#home:}" ;;
	esac
}

cmd_run() {
	J=$1
	[ "$(uci -q get cloud."$J")" = job ] || die "unknown job $J"
	rc=$(rclone_bin) || die "rclone is not installed"
	o=$(job owner); o=${o:--}
	c=$(conf_of "$o") || die "no settings for $o"
	src=$(local_path) || true
	[ -n "$src" ] && [ -d "$src" ] || die "local folder missing ($(job local))"
	case "$src" in *..*) die "invalid folder" ;; esac
	r=$(job remote):$(job remote_path)
	case "$(job mode)" in
		upload) set -- copy "$src" "$r" ;;
		download) set -- copy "$r" "$src" ;;
		mirror_up) set -- sync "$src" "$r" ;;
		mirror_down) set -- sync "$r" "$src" ;;
		*) die "unknown mode" ;;
	esac
	mkdir -p $ST
	if ! mkdir $ST/$J.lock 2>/dev/null; then
		pid=$(cat $ST/$J.pid 2>/dev/null)
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && die "job $J is already running"
		rm -rf $ST/$J.lock; mkdir $ST/$J.lock
	fi
	trap 'rm -rf $ST/$J.lock $ST/$J.pid' EXIT
	ad=$(apps_dir); logd=${ad:-/tmp}/cloud/logs; mkdir -p "$logd"
	lf=$logd/$J.log
	[ -f "$lf" ] && [ "$(stat -c %s "$lf")" -gt 262144 ] && tail -c 131072 "$lf" > "$lf.old" && mv "$lf.old" "$lf"
	bw=$(job bwlimit); [ -n "$bw" ] || bw=$(uci -q get cloud.global.bwlimit)
	set -- "$@" --config "$c" --transfers 2 --checkers 4 --buffer-size 4M --use-mmap \
		--low-level-retries 5 --retries 2 --stats 1m --stats-one-line -v --log-file "$lf.run"
	[ -n "$bw" ] && set -- "$@" --bwlimit "$bw"
	printf 'state=running\nstarted=%s\n' "$(date +%s)" > $ST/$J.state
	: > "$lf.run"; [ "$o" != - ] && chown "$o":users "$lf.run"
	as_owner "$o" "$rc" "$@" &
	echo $! > $ST/$J.pid
	wait $!; rc_exit=$?
	cat "$lf.run" >> "$lf"
	summary=$(grep -E 'Transferred:' "$lf.run" | tail -n1 | sed 's/.*Transferred: *//' | cut -c1-120)
	err=$(grep -E ' ERROR ' "$lf.run" | tail -n1 | sed 's/.* ERROR : *//' | cut -c1-200)
	rm -f "$lf.run"
	if [ $rc_exit = 0 ]; then
		printf 'state=ok\nended=%s\nsummary=%s\n' "$(date +%s)" "$summary" > $ST/$J.state
		log "job $J finished: $summary"
		shareos-notify clear "cloud-$J" >/dev/null 2>&1
	else
		printf 'state=error\nended=%s\nsummary=%s\nerror=%s\n' "$(date +%s)" "$summary" "${err:-rclone exit $rc_exit}" > $ST/$J.state
		log "job $J failed: ${err:-exit $rc_exit}"
		shareos-notify send warn cloud "cloud-$J" "Cloud-Sync „$J“ fehlgeschlagen" "Cloud sync “$J” failed" "${err:-rclone exit $rc_exit}" "${err:-rclone exit $rc_exit}" >/dev/null 2>&1
	fi
	# keep the last result over a reboot
	cp $ST/$J.state "$logd/$J.state" 2>/dev/null
	[ $rc_exit = 0 ]
}

cmd_stop() {
	pid=$(cat $ST/$1.pid 2>/dev/null)
	[ -n "$pid" ] || die "job $1 is not running"
	pkill -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null
	echo ok
}

cmd_status() {
	b=$(rclone_bin) && echo "rclone=$b" && echo "version=$("$b" version 2>/dev/null | head -1 | sed 's/^rclone //')"
	echo "apps=$(apps_dir)"
	[ -f $ST/install ] && sed 's/^/install_/' $ST/install
	return 0
}

[ -f /etc/config/cloud ] || : > /etc/config/cloud
case "$1" in
	install) cmd_install ;;
	remote-add) shift; cmd_remote_add "$@" ;;
	auth-start) cmd_auth_start "$2" "$3" ;;
	auth-finish) cmd_auth_finish "$2" "$3" ;;
	remote-del) cmd_remote_del "$2" "$3" ;;
	remote-test) cmd_remote_test "$2" "$3" ;;
	remotes) cmd_remotes "$2" ;;
	run) cmd_run "$2" ;;
	stop) cmd_stop "$2" ;;
	status) cmd_status ;;
	*) sed -n '3,32s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
