#!/usr/bin/ucode -S
//
// ShareOS firmware updater – GitHub Releases
//
//   shareos-update check [stable|beta]   list releases for this box (JSON)
//   shareos-update download <tag>        download + verify into /tmp (JSON state)
//   shareos-update apply <tag>           install a verified download, then reboot
//   shareos-update status                current state (JSON)
//   shareos-update cancel                forget a download
//   shareos-update busy                  exit 0 while firmware is being written
//                                        (this updater or shareos-flash-bin):
//                                        switching off or restarting then
//                                        would leave a half-written kernel
//   shareos-update local <file> [sha256] verify an uploaded .sysupgrade.tar (no internet
//                                        needed); then "apply local" installs it
//
// Everything prints one JSON object on stdout; the rpcd plugin
// (/usr/share/rpcd/ucode/shareos.uc) uses the same commands.
//
// A release carries ShareOS-<version>-<fwname>.sysupgrade.tar (+ .sha256):
// uImage, urootfs, rootfs.squashfs, shareos-release, SHA256SUMS.
// apply writes kernel + initramfs into their flash partitions and stages
// rootfs.squashfs in /overlay/upgrade; the new initramfs writes it into the
// UBI volume 'rootfs' on the next boot (it is in use while running).
// Settings and packages in /overlay stay.
//
// Safety checks:
//   - SHA-256 of the bundle against the .sha256 published with the release
//   - SHA256SUMS inside the bundle, fwname of the bundle = this box
//   - U-Boot headers (magic, "ShareOS-" name), 3 MB limit of the stock U-Boot
//   - squashfs magic and size against the UBI volume
//   - every written partition is read back and compared
//
'use strict';

import { readfile, writefile, mkdir, stat, unlink, rename, popen, glob } from 'fs';
import { cursor } from 'uci';

// SHAREOS_ROOT lets the test suite run this against a fake root on a build host
const ROOT = getenv('SHAREOS_ROOT') ?? '';
const STATE_DIR = ROOT + '/tmp/shareos-update';
const STATE = STATE_DIR + '/state.json';
const UBOOT_MAX = 3145728;          // bytes U-Boot copies from uImage/ramdisk
const CA = '/etc/ssl/certs/ca-certificates.crt';
const CURL = [ 'curl', '-fsSL', '--retry', '2', '--connect-timeout', '10',
	...(stat(CA) ? [ '--cacert', CA ] : []) ];

// the box: /tmp/sys/board.env from S05board (/usr/lib/shareos/board.sh) –
// BOARD_FWNAME picks the release files, BOARD_MODEL must be in the
// device-tree model before flashing. Without it (old system, tests): the
// firmware name of the release file and this table.
const BOARDS = {                    // fwname -> string in the device-tree model
	'DNS-320L-rev-Ax': 'DNS-320L'
};
const ROOTFS_MAX = 48 * 1048576;    // fallback when the UBI volume size is unknown
const PARTS = [ 'uImage', 'urootfs', 'rootfs.squashfs' ];

function shq(s) {
	return "'" + replace(s, "'", "'\\''") + "'";
}

function capture(argv) {
	let p = popen(join(' ', map(argv, shq)) + ' 2>&1', 'r');
	if (!p)
		return { rc: -1, out: '' };
	let out = p.read('all') ?? '';
	let rc = p.close();
	return { rc, out };
}

function release_info() {
	let r = {};
	for (let line in split(readfile(ROOT + '/etc/shareos-release') ?? '', '\n')) {
		let m = match(line, /^([A-Z_]+)="?([^"]*)"?$/);
		if (m)
			r[m[1]] = m[2];
	}
	return r;
}

function board_env() {
	let b = {};
	for (let line in split(readfile(ROOT + '/tmp/sys/board.env') ?? '', '\n')) {
		let m = match(line, /^BOARD_([A-Z0-9_]+)="(.*)"$/);
		if (m) b[m[1]] = m[2];
	}
	return b;
}

// firmware name of this box (release files ShareOS-<version>-<fwname>.…)
function box_fwname() {
	return board_env().FWNAME || release_info().SHAREOS_FWNAME;
}

// text the device-tree model of this box must contain
function box_model() {
	let b = board_env();
	return b.FWNAME ? b.MODEL : BOARDS[release_info().SHAREOS_FWNAME];
}

function config() {
	let c = cursor(ROOT + '/etc/config');
	return {
		repo: c.get('shareos', 'update', 'repo') ?? 'UniqueDroid/ShareOS',
		channel: c.get('shareos', 'update', 'channel') ?? 'stable',
		api: c.get('shareos', 'update', 'api') ?? 'https://api.github.com'
	};
}

// states in which an updater process is at work; its PID is kept in the
// state, so a run that was killed does not look as if it were still going on
const BUSY = { downloading: 1, verifying: 1, flashing: 1 };
function self_pid() { return +(split(readfile('/proc/self/stat') ?? '', ' ')[0]) || null; }
function updater_alive(p) { return p > 1 && index(readfile('/proc/' + p + '/cmdline') ?? '', 'shareos-update') >= 0; }

function load_state() {
	let s = null;
	try { s = json(readfile(STATE) ?? 'null'); } catch (e) { }
	if (type(s) != 'object') return { state: 'idle' };
	if (BUSY[s.state] && s.pid != null && !updater_alive(s.pid)) {
		s.error = 'the update was interrupted (' + s.state + (s.step ? ', ' + s.step : '') + ')';
		s.state = 'error';
		delete s.pid;
		delete s.step;
	}
	return s;
}

function save_state(s) {
	mkdir(STATE_DIR);
	s.updated = time();
	if (BUSY[s.state]) s.pid = self_pid(); else delete s.pid;
	writefile(STATE + '.tmp', sprintf('%J', s));
	rename(STATE + '.tmp', STATE);
	return s;
}

// is firmware being written right now? (kernel, initramfs or the staged system)
function flash_busy() {
	let s = load_state();
	if (s.state == 'flashing') return true;
	let p = +trim(readfile(ROOT + '/tmp/shareos-flash-bin.lock/pid') ?? '0');
	return p > 1 && stat('/proc/' + p) != null;
}

function out(o) {
	print(sprintf('%J\n', o));
	return o;
}

function fail(s, msg) {
	s.state = 'error';
	s.error = msg;
	save_state(s);
	out(s);
	exit(1);
}

// "1.2.3", "v1.2.3-beta.1", dev builds "0.0-20261016-abcdef"
function vparse(v) {
	let m = match(v ?? '', /^v?([0-9]+)\.([0-9]+)(\.([0-9]+))?(-(.+))?$/);
	if (!m)
		return null;
	return { n: [ +m[1], +m[2], +(m[4] ?? 0) ], pre: m[6] };
}

function vcmp(a, b) {
	let x = vparse(a), y = vparse(b);
	if (!x || !y)
		return x ? 1 : (y ? -1 : 0);
	for (let i = 0; i < 3; i++)
		if (x.n[i] != y.n[i])
			return x.n[i] < y.n[i] ? -1 : 1;
	if (x.pre == y.pre) return 0;
	if (!x.pre) return 1;           // release > pre-release / dev build
	if (!y.pre) return -1;
	// pre-release parts compare numerically where both are numbers (beta.10 > beta.9)
	let p = split(x.pre, '.'), q = split(y.pre, '.');
	for (let i = 0; i < length(p) && i < length(q); i++) {
		if (p[i] == q[i]) continue;
		let np = match(p[i], /^[0-9]+$/), nq = match(q[i], /^[0-9]+$/);
		if (np && nq) return +p[i] < +q[i] ? -1 : 1;
		if (np || nq) return np ? -1 : 1;
		return p[i] < q[i] ? -1 : 1;
	}
	return length(p) == length(q) ? 0 : (length(p) < length(q) ? -1 : 1);
}

function fetch_releases(cfg) {
	let r = capture([ ...CURL, '--max-time', '20',
		'-H', 'Accept: application/vnd.github+json',
		`${cfg.api}/repos/${cfg.repo}/releases?per_page=30` ]);
	if (r.rc != 0) {
		// first curl message line, e.g. "curl: (6) Could not resolve host: api.github.com"
		let m = match(r.out, /curl: \([0-9]+\)[^\n]*/);
		return { error: m ? m[0] : 'curl exit ' + r.rc };
	}
	let list = json(r.out);
	return type(list) == 'array' ? list : { error: 'unexpected answer from GitHub' };
}

function releases_for_box(list, fwname, channel) {
	let found = [];
	let re_bin = regexp('^ShareOS-.+-' + fwname + '\\.sysupgrade\\.tar$');
	let re_sum = regexp('^ShareOS-.+-' + fwname + '\\.sysupgrade\\.tar\\.sha256$');

	for (let x in list) {
		if (x.draft || (x.prerelease && channel != 'beta'))
			continue;
		let bin = null, sum = null;
		for (let a in x.assets) {
			if (match(a.name, re_bin)) bin = a;
			else if (match(a.name, re_sum)) sum = a;
		}
		if (!bin || !sum)
			continue;
		push(found, {
			tag: x.tag_name,
			version: ltrim(x.tag_name, 'v'),
			prerelease: !!x.prerelease,
			date: x.published_at,
			notes: x.body ?? '',
			url: x.html_url,
			file: bin.name,
			size: bin.size,
			bin_url: bin.browser_download_url,
			sha_url: sum.browser_download_url
		});
	}
	return sort(found, (a, b) => vcmp(b.version, a.version));
}

// auto: the regular background check (cron) – skipped while an update is
// running, and a failure (box offline, GitHub limit) leaves no error state
function cmd_check(channel, auto) {
	let cfg = config();
	let rel = release_info();
	channel = channel ?? cfg.channel;
	let s = load_state();

	if (auto && (s.state in { downloading: 1, verifying: 1, flashing: 1 }))
		exit(0);
	let fwname = box_fwname();
	if (!fwname)
		fail(s, 'unknown firmware name for this box (/tmp/sys/board.env, /etc/shareos-release)');

	let list = fetch_releases(cfg);
	if (type(list) != 'array') {
		if (auto) { warn('shareos-update: check failed: ' + list.error + '\n'); exit(1); }
		fail(s, 'cannot fetch releases from ' + cfg.api + ' (' + cfg.repo + '): ' + list.error);
	}
	// the state may have changed while asking GitHub (a download started)
	s = load_state();

	let found = releases_for_box(list, fwname, channel);
	let latest = found[0];

	s.check = {
		time: time(),
		channel,
		repo: cfg.repo,
		releases: found,
		latest: latest?.tag,
		update_available: !!latest && vcmp(latest.version, rel.SHAREOS_VERSION) > 0
	};
	if (s.state == 'error') {
		s.state = 'idle';
		delete s.error;
	}
	save_state(s);
	return out({
		current: rel.SHAREOS_VERSION,
		fwname,
		...s.check
	});
}

function find_release(s, tag) {
	for (let r in s.check?.releases ?? [])
		if (r.tag == tag)
			return r;
	return null;
}

function parse_release(text) {
	let r = {};
	for (let line in split(text ?? '', '\n')) {
		let m = match(line, /^([A-Z_]+)="?([^"]*)"?$/);
		if (m)
			r[m[1]] = m[2];
	}
	return r;
}

function rootfs_volume() {
	for (let d in glob(ROOT + '/sys/class/ubi/ubi0_*')) {
		if (trim(readfile(d + '/name') ?? '') == 'rootfs')
			return { dev: '/dev/' + substr(d, rindex(d, '/') + 1), size: +trim(readfile(d + '/data_bytes') ?? '0') };
	}
	return null;
}

function check_uimage(s, file, label) {
	let st = stat(file);
	let head = readfile(file, 64) ?? '';
	if (!st || length(head) < 64 || substr(head, 0, 4) != '\x27\x05\x19\x56')
		fail(s, label + ' is not a U-Boot image');
	let name = trim(replace(substr(head, 32, 32), '\0', ''));
	if (substr(name, 0, 8) != 'ShareOS-')
		fail(s, label + ': image name "' + name + '" is not ShareOS');
	if (st.size > UBOOT_MAX)
		fail(s, sprintf('%s is %d bytes, the stock U-Boot only loads %d', label, st.size, UBOOT_MAX));
}

function verify_image(s, dir, rel) {
	let fwname = box_fwname();

	// SHA-256 of the bundle from the release
	let want = match(readfile(dir + '/fw.sha256') ?? '', /^([0-9a-f]{64})/);
	if (!want)
		fail(s, 'checksum file is invalid');
	let have = match(capture([ 'sha256sum', dir + '/fw.tar' ]).out, /^([0-9a-f]{64})/);
	if (!have || have[1] != want[1])
		fail(s, 'SHA-256 mismatch – download is corrupt or was tampered with');

	// unpack
	let x = dir + '/x';
	capture([ 'rm', '-rf', x ]);
	mkdir(x);
	let r = capture([ 'tar', '-xf', dir + '/fw.tar', '-C', x ]);
	if (r.rc != 0)
		fail(s, 'bundle cannot be unpacked: ' + trim(r.out));

	// made for this box?
	let info = parse_release(readfile(x + '/shareos-release'));
	if (info.SHAREOS_FWNAME != fwname)
		fail(s, sprintf('firmware is for "%s", this box needs "%s"', info.SHAREOS_FWNAME ?? '?', fwname));

	// checksums of the parts
	let sums = readfile(x + '/SHA256SUMS') ?? '';
	for (let p in PARTS)
		if (!match(sums, regexp('[0-9a-f]{64}  ' + replace(p, '.', '\\.') + '(\n|$)')))
			fail(s, 'SHA256SUMS does not cover ' + p);
	r = capture([ 'sh', '-c', 'cd ' + shq(x) + ' && sha256sum -c SHA256SUMS' ]);
	if (r.rc != 0)
		fail(s, 'bundle is damaged (SHA256SUMS): ' + trim(r.out));

	check_uimage(s, x + '/uImage', 'kernel');
	check_uimage(s, x + '/urootfs', 'initramfs');

	let sq = stat(x + '/rootfs.squashfs');
	if (!sq || readfile(x + '/rootfs.squashfs', 4) != 'hsqs')
		fail(s, 'rootfs.squashfs is not a squashfs image');
	let vol = rootfs_volume();
	let max = vol?.size || ROOTFS_MAX;
	if (sq.size > max)
		fail(s, sprintf('rootfs is %d bytes, the UBI volume holds %d', sq.size, max));

	s.bundle = { version: info.SHAREOS_VERSION, rootfs: sq.size };
	return true;
}

function cmd_download(tag) {
	let s = load_state();
	let rel = find_release(s, tag);
	if (!rel)
		fail(s, 'unknown release ' + (tag ?? '(none)') + ' – run check first');

	let dir = STATE_DIR + '/dl';
	mkdir(STATE_DIR);
	mkdir(dir);
	unlink(dir + '/fw.tar');
	unlink(dir + '/fw.tar.part');

	s.state = 'downloading';
	s.release = rel;
	delete s.error;
	save_state(s);

	if (capture([ ...CURL, '--max-time', '600', '-o', dir + '/fw.sha256', rel.sha_url ]).rc != 0)
		fail(s, 'download of the checksum failed');
	if (capture([ ...CURL, '--max-time', '600', '-o', dir + '/fw.tar.part', rel.bin_url ]).rc != 0)
		fail(s, 'download of the firmware failed');
	rename(dir + '/fw.tar.part', dir + '/fw.tar');

	s.state = 'verifying';
	save_state(s);
	verify_image(s, dir, rel);

	s.state = 'ready';
	save_state(s);
	return out(s);
}

// a bundle uploaded in the web interface (no internet, GitHub blocked …).
// Same checks as a download; the outer SHA-256 only when the .sha256 of the
// release was given too (otherwise integrity comes from SHA256SUMS inside).
function cmd_local(file, sha) {
	let s = load_state();
	if (s.state == 'downloading' || s.state == 'verifying' || s.state == 'flashing')
		return out({ ...s, error: 'busy: ' + s.state });
	let dir = STATE_DIR + '/dl';
	let st = file ? stat(file) : null;
	if (!st || st.type != 'file') {
		// e.g. the same command run twice: keep a package verified before
		if (s.state == 'ready') {
			out({ ...s, error: 'no uploaded file' });
			exit(1);
		}
		s.release = { tag: 'local', version: '?', local: true, size: 0 };
		fail(s, 'no uploaded file');
	}
	mkdir(STATE_DIR);
	mkdir(dir);
	unlink(dir + '/fw.tar');
	unlink(dir + '/fw.tar.part');
	s.release = { tag: 'local', version: '?', local: true, size: st.size };
	delete s.error;
	if (!rename(file, dir + '/fw.tar') && capture([ 'mv', file, dir + '/fw.tar' ]).rc != 0)
		fail(s, 'cannot move the uploaded file');

	s.state = 'verifying';
	save_state(s);
	let have = match(capture([ 'sha256sum', dir + '/fw.tar' ]).out, /^([0-9a-f]{64})/);
	if (!have)
		fail(s, 'cannot read the uploaded file');
	if (sha) {
		let want = match(sha, /([0-9a-f]{64})/);
		if (!want)
			fail(s, 'checksum file is invalid');
		if (want[1] != have[1])
			fail(s, 'SHA-256 mismatch – the file does not match its .sha256');
		s.release.sha_checked = true;
	}
	writefile(dir + '/fw.sha256', have[1] + '  fw.tar\n');
	verify_image(s, dir, s.release);
	s.release.version = s.bundle.version;

	s.state = 'ready';
	save_state(s);
	return out(s);
}

function mtd_by_name(name) {
	for (let line in split(readfile(ROOT + '/proc/mtd') ?? '', '\n')) {
		let m = match(line, /^(mtd[0-9]+): ([0-9a-f]+) [0-9a-f]+ "([^"]+)"/);
		if (m && m[3] == name)
			return { dev: ROOT + '/dev/' + m[1], size: hex(m[2]) };
	}
	return null;
}

function flash_part(s, file, name) {
	let mtd = mtd_by_name(name);
	let st = stat(file);
	if (!mtd)
		fail(s, 'flash partition "' + name + '" not found');
	if (st.size > mtd.size)
		fail(s, name + ': image larger than the partition');

	s.step = 'erase ' + name;
	save_state(s);
	let r = capture([ 'flash_erase', '-q', mtd.dev, '0', '0' ]);
	if (r.rc != 0)
		fail(s, 'flash_erase ' + name + ': ' + trim(r.out));

	s.step = 'write ' + name;
	save_state(s);
	r = capture([ 'nandwrite', '-q', '-p', mtd.dev, file ]);
	if (r.rc != 0)
		fail(s, 'nandwrite ' + name + ': ' + trim(r.out));

	s.step = 'verify ' + name;
	save_state(s);
	let back = file + '.readback';
	r = capture([ 'nanddump', '-q', '-l', '' + st.size, '-f', back, mtd.dev ]);
	if (r.rc != 0 || capture([ 'cmp', '-n', '' + st.size, file, back ]).rc != 0)
		fail(s, name + ': read-back differs after writing – DO NOT REBOOT, flash again');
	unlink(back);
}

function mounted_on(dir) {
	for (let line in split(readfile(ROOT + '/proc/mounts') ?? '', '\n')) {
		let f = split(line, ' ');
		if (f[1] == dir)
			return f[2];
	}
	return null;
}

function cmd_apply(tag) {
	let s = load_state();
	let dir = STATE_DIR + '/dl';

	if (s.state != 'ready' || s.release?.tag != tag)
		fail(s, 'release ' + (tag ?? '(none)') + ' is not downloaded and verified');

	let model = trim(replace(readfile(ROOT + '/proc/device-tree/model') ?? '', '\0', ''));
	let board_model = box_model();
	if (!board_model || index(model, board_model) < 0)
		fail(s, 'refusing to flash: unexpected board "' + model + '"');

	// the system is replaced on the next boot from /overlay/upgrade
	if (mounted_on('/overlay') != 'ubifs')
		fail(s, 'not running from flash (no UBIFS on /overlay) – use shareos-install-ubi');

	// re-check right before writing; /tmp could have been touched. This takes
	// a while on the box, so report it as the first step of flashing.
	s.state = 'flashing';
	s.step = 'check bundle';
	save_state(s);
	verify_image(s, dir, s.release);
	let x = dir + '/x';

	s.step = 'stage rootfs';
	save_state(s);
	let up = ROOT + '/overlay/upgrade';
	capture([ 'rm', '-rf', up ]);
	mkdir(up);
	let r = capture([ 'cp', x + '/rootfs.squashfs', up + '/rootfs.squashfs.part' ]);
	let sum = match(capture([ 'sha256sum', up + '/rootfs.squashfs.part' ]).out, /^([0-9a-f]{64})/);
	let want = match(readfile(x + '/SHA256SUMS'), /([0-9a-f]{64})  rootfs\.squashfs/);
	if (r.rc != 0 || !sum || sum[1] != want[1]) {
		capture([ 'rm', '-rf', up ]);
		fail(s, 'cannot stage the system in /overlay (full?): ' + trim(r.out));
	}
	writefile(up + '/rootfs.squashfs.sha256', sum[1] + '  rootfs.squashfs\n');
	writefile(up + '/version', (s.bundle?.version ?? tag) + '\n');
	rename(up + '/rootfs.squashfs.part', up + '/rootfs.squashfs');
	unlink(ROOT + '/overlay/upgrade-result');
	system('sync');

	flash_part(s, x + '/urootfs', 'ramdisk');
	flash_part(s, x + '/uImage', 'uImage');
	system('sync');

	delete s.step;
	s.state = 'flashed';
	s.flashed = { tag: s.release.tag, time: time() };
	save_state(s);
	return out(s);
}

function cmd_status() {
	let s = load_state();
	if (s.state == 'downloading') {
		let st = stat(STATE_DIR + '/dl/fw.tar.part') ?? stat(STATE_DIR + '/dl/fw.tar');
		s.progress = { bytes: st?.size ?? 0, total: s.release?.size ?? 0 };
	}
	s.current = release_info().SHAREOS_VERSION;
	// a check from before an update would still offer the version now running
	if (s.check)
		s.check.update_available = !!s.check.releases?.[0] && vcmp(s.check.releases[0].version, s.current) > 0;
	// written by the initramfs after installing a staged system
	let res = trim(readfile(ROOT + '/overlay/upgrade-result') ?? '');
	if (res != '')
		s.last_upgrade = res;
	if (stat(ROOT + '/overlay/upgrade/rootfs.squashfs'))
		s.pending_reboot = true;
	return out(s);
}

function cmd_cancel() {
	let s = load_state();
	if (s.state == 'flashing')
		fail(s, 'cannot cancel while flashing');
	capture([ 'rm', '-rf', STATE_DIR + '/dl' ]);
	s.state = 'idle';
	delete s.release;
	delete s.error;
	save_state(s);
	return out(s);
}

// the message about the last installed update was read: forget it
function cmd_ack() {
	unlink(ROOT + '/overlay/upgrade-result');
	cmd_status();
}

let cmd = ARGV[0];
switch (cmd) {
case 'check':    cmd_check(ARGV[1]); break;
case 'auto':     cmd_check(null, true); break;
case 'download': cmd_download(ARGV[1]); break;
case 'apply':    cmd_apply(ARGV[1]); break;
case 'status':   cmd_status(); break;
case 'cancel':   cmd_cancel(); break;
case 'busy':     exit(flash_busy() ? 0 : 1);
case 'local':    cmd_local(ARGV[1], ARGV[2]); break;
case 'ack':      cmd_ack(); break;
default:
	warn('usage: shareos-update check [stable|beta] | auto | download <tag> | apply <tag> | status | cancel | ack\n');
	exit(2);
}
