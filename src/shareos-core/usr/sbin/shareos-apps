#!/usr/bin/ucode -S
//
// shareos-apps – ShareOS apps (packages .sapp) from a catalog or an upload
//
//   shareos-apps catalog            fetch the catalogs of all sources (JSON)
//   shareos-apps cached             the last fetched catalog, no network (JSON)
//   shareos-apps list               installed apps (JSON)
//   shareos-apps install <id> [ver] download from the catalog, verify, install
//   shareos-apps install-file <f>   install an uploaded package (not verified)
//   shareos-apps remove <id> [--force]   (--force: also when another app needs it)
//   shareos-apps status             state of the last install job (JSON)
//   shareos-apps run-job <id> <job> run a scheduled task of an app now (cron)
//   shareos-apps job-log <id> <job> output of the last run
//   shareos-apps notify <id> send <info|warn|error> <key> <title> [text]
//   shareos-apps notify <id> clear <key>
//                                   a message of an app with the permission
//                                   "notify" through shareos-notify (rpcd for
//                                   ShareOS.notify; the spool of its jobs)
//
// A package is a tar.gz with app.json at the top and the app's files:
//   { "id": "webpad", "name": "Webpad", "version": "1.0.0",
//     "publisher": "…", "description": { "de": "…", "en": "…" },
//     "type": "webapp", "entry": "index.html", "icon": "icon.svg",
//     "category": "tools", "license": "…", "homepage": "…",
//     "min_shareos": "0.1.0", "permissions": [],
//     "jobs": [ { "id": "cleanup", "name": "Clean up", "command": "jobs/cleanup.sh",
//                 "schedule": "0 3 * * *", "timeout": 300 } ] }
// Permissions an app asks for (shown before installing, refused when this
// ShareOS does not know them):
//   cron   scheduled tasks ("jobs"): shell scripts from the package, run by
//          crond as the app's own user app-<id> (no login, no access to other
//          users' files) in the app's data folder, with a time limit; the
//          schedules can be changed or switched off under APPS.
//   embed  may be shown as a page inside the ShareOS interface (meant for
//          apps that only have settings); others open in their own window.
//   files  may read and change the files the user may reach in the file
//          browser (his personal folder; admins: all volumes and USB drives),
//          with his rights, through /_shareos/cgi/fs (SDK: ShareOS.fs) –
//          for file managers and editors that save on the box.
// Apps it needs (optional): "requires": [ "transmission-daemon" ] – installed
// from the store first (also for an uploaded package); an app another one
// needs is removed only with --force. Services (daemons): see "service" for
// system apps below – the package names a controller of the firmware, it
// never starts anything by itself.
// Not a permission: "internet": true says the app loads data from the
// internet (online services, streams, maps …); shown in the store. Web apps
// and jobs may always use the network.
// Window and files (optional):
//   "window": { "width": 900, "height": 640 }      size of the app's window
//   "opens": [ { "ext": [".txt", ".md"], "mode": "edit", "label": {…} } ]
//          file types the app opens from the file browser; "edit" may save
//          back, "view" only reads. The app gets the file through the
//          ShareOS app SDK (/_shareos/app.js) with a ticket bound to it.
// System apps ("type": "system", ShareOS 0.2.0-beta.1+): native programs for
// the terminal (System -> Terminal, SSH), e.g. nano or htop, built with the
// firmware's toolchain (ShareOS repository: sysapps/, make sysapps-pack).
//   { "id": "nano", "type": "system", "commands": [ "nano" ], … }
//   bin/<command>   the programs; lib/ libraries the firmware lacks;
//   share/terminfo  terminal descriptions (optional)
// They go to /opt/shareos/sysapps/<id>; for every command a starter in
// /opt/shareos/bin (in PATH after the firmware's folders) sets LD_LIBRARY_PATH
// and TERMINFO_DIRS. A command the firmware has or another app provides is
// refused. They run with the rights of who starts them (in the terminal: root)
// – no permissions, jobs or windows.
// A system app that is a service (daemon) says so (ShareOS 0.2.0-beta.9+):
//   "service": { "control": "tailscale", "boot": true, "on_install": "start",
//                "delay": 5 }
//   control     the firmware's controller /usr/sbin/shareos-<control>; it says
//               what it can do in a line "shareos-service: boot start stop-all"
//               (packages cannot bring their own – only reviewed controllers
//               start daemons as root)
//   boot        started at boot with "<controller> boot" (default true; the
//               controller decides from its settings, e.g. only when switched
//               on); "Services -> Autostart" can switch it off by its name
//   on_install  "start" or "boot": run right after installing (optional)
//   delay       seconds after boot before it starts, 0 … 60 (default 5)
// Removing the app runs "<controller> stop-all"; so does shutting down.
// The boot runs from /etc/init.d/S90services ("shareos-apps services boot").
// Web apps are served by their own web server (port apps.store.port, default
// 8081) from /www-apps/<id>/ – another origin than the admin interface, so an
// app cannot use the admin's login.
//
// Catalog (index.json, one URL per source in apps.store.source):
//   { "schema": 1, "apps": [ { "id", "name", "publisher", "description",
//     "category", "icon_url", "homepage", "type",
//     "versions": [ { "version", "date", "prerelease", "url", "sha256",
//                     "size", "min_shareos", "notes_url" } ] } ] }
//
'use strict';

import { readfile, writefile, mkdir, stat, lstat, lsdir, unlink, rename, popen, readlink } from 'fs';
import { cursor } from 'uci';

const ROOT = getenv('SHAREOS_ROOT') ?? '';
const APPS = ROOT + '/www-apps';
const SYS = ROOT + '/opt/shareos/sysapps';
const SYSBIN = ROOT + '/opt/shareos/bin';
const CMD_RE = /^[a-z0-9][a-z0-9._+-]{0,31}$/;
const MAX_CMDS = 8;
const ST = ROOT + '/tmp/shareos-apps';
const CA = '/etc/ssl/certs/ca-certificates.crt';
const CURL = [ 'curl', '-fsSL', '--retry', '2', '--connect-timeout', '10',
	...(stat(CA) ? [ '--cacert', CA ] : []) ];
const MAX_PKG = 64 * 1048576;       // download / upload
const MAX_FILES = 40 * 1048576;     // unpacked
const ID_RE = /^[a-z][a-z0-9-]{1,31}$/;
const JOB_RE = /^[a-z][a-z0-9-]{0,23}$/;
const PERMISSIONS = { cron: 1, notify: 1, embed: 1, files: 1, torrent: 1, media: 1, vpn: 1, status: 1, tailscale: 1, autobrr: 1, sysinfo: 1, netcheck: 1, docker: 1, tuya: 1 };
const MAX_JOBS = 5;
const MAX_REQUIRES = 5;
const MAX_LOG = 65536;
// the test suite serves catalogs and packages from files
const URL_RE = getenv('SHAREOS_APPS_ALLOW_FILE') ? /^(https|file):\/\// : /^https:\/\//;

function shq(s) { return "'" + replace(s, "'", "'\\''") + "'"; }

function capture(cmd) {
	let p = popen('(' + cmd + ') 2>&1', 'r');
	if (!p) return { rc: -1, out: '' };
	let o = p.read('all') ?? '';
	return { rc: p.close(), out: o };
}

function out(o) { print(sprintf('%J\n', o)); return o; }

function die(msg) { out({ error: msg }); exit(1); }

function vparse(v) {
	let m = match(v ?? '', /^v?([0-9]+)\.([0-9]+)(\.([0-9]+))?(-(.+))?$/);
	return m ? { n: [ +m[1], +m[2], +(m[4] ?? 0) ], pre: m[6] } : null;
}

function vcmp(a, b) {
	let x = vparse(a), y = vparse(b);
	if (!x || !y) return x ? 1 : (y ? -1 : 0);
	for (let i = 0; i < 3; i++)
		if (x.n[i] != y.n[i]) return x.n[i] < y.n[i] ? -1 : 1;
	if (x.pre == y.pre) return 0;
	if (!x.pre) return 1;
	if (!y.pre) return -1;
	// pre-release parts compare numerically where both are numbers (beta.10 > beta.9)
	let p = split(x.pre, '.'), q = split(y.pre, '.');
	for (let i = 0; i < length(p) && i < length(q); i++) {
		if (p[i] == q[i]) continue;
		let np = match(p[i], /^[0-9]+$/), nq = match(q[i], /^[0-9]+$/);
		if (np && nq) return +p[i] < +q[i] ? -1 : 1;
		if (np || nq) return np ? -1 : 1;
		return p[i] < q[i] ? -1 : 1;
	}
	return length(p) == length(q) ? 0 : (length(p) < length(q) ? -1 : 1);
}

function shareos_version() {
	let m = match(readfile(ROOT + '/etc/shareos-release') ?? '', /SHAREOS_VERSION="?([^"\n]*)/);
	return m ? m[1] : '0';
}

// development builds (0.0-<date>-<commit>) take every app. A minimum without
// pre-release ("0.1.0") is met by the betas of that version too (0.1.0-beta.7);
// an app that needs a certain beta names it ("0.1.0-beta.7").
function too_old(min) {
	let v = shareos_version();
	if (!min || match(v, /^0\.0-/) || !vparse(v)) return false;
	let m = vparse(min);
	if (m && !m.pre)
		v = join('.', vparse(v).n);
	return vcmp(v, min) < 0;
}

function conf() {
	let c = ROOT ? cursor(ROOT + '/etc/config') : cursor();
	let src = c.get('apps', 'store', 'source');
	return { c, channel: c.get('apps', 'store', 'channel') ?? 'stable',
		sources: type(src) == 'array' ? src : (src ? [ src ] : []) };
}

function sect(id) { return 'app_' + replace(id, '-', '_'); }
function jsect(id, j) { return 'job_' + replace(id, '-', '_') + '__' + replace(j, '-', '_'); }

/* ---------- scheduled tasks (permission "cron") ---------- */

// 5-field cron time, at most every 5 minutes (the box is small)
function cron_ok(s) {
	if (type(s) != 'string' || !match(s, /^[0-9*\/,-]+( [0-9*\/,-]+){4}$/)) return false;
	let min = split(s, ' ')[0];
	if (min == '*') return false;
	let m = match(min, /^\*\/([0-9]+)$/);
	return !m || +m[1] >= 5;
}

function app_user(id) { return 'app-' + substr(id, 0, 28); }

// large system apps (Tailscale …) live on the apps drive, /opt/shareos/sysapps/<id>
// is a link there – the flash (about 40 MB for settings and system apps) stays
// free; small ones (nano, bash …) stay on the flash and work without a drive
const BIG_SYSAPP = 2 * 1048576;     // services (FFmpeg, Transmission, MiniDLNA, OpenVPN, Tailscale) – they work on the drive anyway
function disk_sys() {
	let area = conf().c.get('storage', 'global', 'apps');
	if (!area || index(readfile('/proc/mounts') ?? '', ' /mnt/' + area + ' ') < 0 && !getenv('SHAREOS_ROOT')) return null;
	if (stat(ROOT + '/mnt/' + area + '/.shareos')?.type != 'directory') return null;
	return ROOT + '/mnt/' + area + '/.shareos/sysapps';
}
// the system apps on the apps drive run as other users too (autobrr,
// Transmission of every account): .shareos must be passable (711 – not
// listable), sysapps readable. .shareos was created root-only when the drive
// was set up from the web interface (rpcd runs with umask 077).
function sys_area_perms(ds) {
	if (!ds) return;
	let base = substr(ds, 0, rindex(ds, '/'));
	capture(sprintf('chmod 711 %s && mkdir -p %s && chmod 755 %s', shq(base), shq(ds), shq(ds)));
}
function du_bytes(dir) { return 1024 * +(match(capture('du -sk ' + shq(dir)).out, /^([0-9]+)/)?.[1] ?? 0); }
// the folder a link in /opt/shareos/sysapps points to (only inside an apps area)
function sys_target(link) {
	if (lstat(link)?.type != 'link') return null;
	let t = readlink(link);
	return t && match(t, /^\/mnt\/[^\/]+\/\.shareos\/sysapps\/[a-z0-9-]+$/) ? ROOT + t : null;
}

function data_dir(id) {
	let c = conf().c, area = c.get('storage', 'global', 'apps');
	if (area && stat(ROOT + '/mnt/' + area + '/.shareos')?.type == 'directory')
		return ROOT + '/mnt/' + area + '/.shareos/appdata/' + id;
	return ROOT + '/var/lib/shareos-apps/' + id;
}

function job_state(id, j) {
	let st = json(readfile(ST + '/jobs/' + id + '.' + j + '.json') ?? 'null');
	return type(st) == 'object' ? st : null;
}

function jobs_of(id, a, c) {
	let list = [];
	for (let j in (type(a.jobs) == 'array' ? a.jobs : [])) {
		let s = jsect(id, j.id);
		push(list, { id: j.id, name: j.name ?? j.id, command: j.command, timeout: +(j.timeout ?? 300),
			schedule: c.get('apps', s, 'schedule') ?? j.schedule, default_schedule: j.schedule,
			enabled: c.get('apps', s, 'enabled') != '0', last: job_state(id, j.id),
			running: stat(ST + '/jobs/' + id + '.' + j.id + '.lock') != null });
	}
	return list;
}

// optional "window" and "opens" of the manifest
function check_ui(a) {
	if (a.window != null) {
		let w = a.window;
		if (type(w) != 'object') return 'invalid window';
		for (let k in [ 'width', 'height' ])
			if (w[k] != null && !(type(w[k]) == 'int' && w[k] >= 200 && w[k] <= 4000)) return 'window ' + k + ': 200 … 4000';
	}
	if (a.opens == null) return null;
	if (type(a.opens) != 'array' || length(a.opens) > 16) return 'invalid opens (at most 16 entries)';
	for (let o in a.opens) {
		if (type(o) != 'object' || type(o.ext) != 'array' || !length(o.ext) || length(o.ext) > 32) return 'opens: ext must list file extensions';
		for (let e in o.ext)
			if (type(e) != 'string' || !match(e, /^\.[a-z0-9]{1,10}$/)) return 'opens: invalid extension ' + e + ' (like ".txt", lower case)';
		if (o.mode != null && o.mode != 'view' && o.mode != 'edit') return 'opens: mode is "view" or "edit"';
	}
	return null;
}

function opens_of(a) {
	return map(type(a.opens) == 'array' ? a.opens : [], (o) => ({ ext: o.ext, mode: o.mode ?? 'view', label: o.label ?? null }));
}

function check_jobs(a, dir) {
	let perms = a.permissions ?? [];
	if (type(perms) != 'array') return 'invalid permissions';
	for (let p in perms)
		if (!PERMISSIONS[p]) return 'permission "' + p + '" is not known to this ShareOS version – update ShareOS first';
	// "torrent": the account's own Transmission daemon (the proxy checks the grant of "files")
	if (index(perms, 'torrent') >= 0 && index(perms, 'files') < 0) return 'the permission "torrent" needs "files"';
	if (index(perms, 'media') >= 0 && index(perms, 'files') < 0) return 'the permission "media" needs "files"';
	// "vpn": the box as a VPN client (admins only, checked when used); "status": a chip in the header
	if (index(perms, 'vpn') >= 0 && index(perms, 'files') < 0) return 'the permission "vpn" needs "files"';
	if (index(perms, 'status') >= 0 && index(perms, 'files') < 0) return 'the permission "status" needs "files"';
	// "tailscale": remote access with Tailscale (admins only, checked when used)
	if (index(perms, 'tailscale') >= 0 && index(perms, 'files') < 0) return 'the permission "tailscale" needs "files"';
	// "autobrr": the box's autobrr (admins only, checked when used)
	if (index(perms, 'autobrr') >= 0 && index(perms, 'files') < 0) return 'the permission "autobrr" needs "files"';
	// "sysinfo" (the box's values), "netcheck" (checks from the box), "docker"
	// (Docker hosts of the homelab), "tuya" (smart-home devices): admins only, checked when used
	for (let p in [ 'sysinfo', 'netcheck', 'docker', 'tuya' ])
		if (index(perms, p) >= 0 && index(perms, 'files') < 0) return 'the permission "' + p + '" needs "files"';
	if (a.jobs == null) return null;
	if (type(a.jobs) != 'array' || length(a.jobs) > MAX_JOBS) return 'invalid jobs (at most ' + MAX_JOBS + ')';
	if (length(a.jobs) && index(perms, 'cron') < 0) return 'jobs need the permission "cron"';
	let seen = {};
	for (let j in a.jobs) {
		if (type(j) != 'object' || !match(j.id ?? '', JOB_RE) || seen[j.id]) return 'invalid job id';
		seen[j.id] = true;
		if (type(j.command) != 'string' || match(j.command, /(^\/|\.\.)/) || stat(dir + '/' + j.command)?.type != 'file')
			return 'job ' + j.id + ': command ' + (j.command ?? '') + ' missing in the package';
		if (!cron_ok(j.schedule)) return 'job ' + j.id + ': invalid schedule (cron time, at most every 5 minutes)';
		if (j.timeout != null && !(+j.timeout >= 10 && +j.timeout <= 3600)) return 'job ' + j.id + ': timeout 10 … 3600 s';
	}
	return null;
}

function cron_sync() {
	if (!ROOT) system('/usr/sbin/shareos-cron sync >/dev/null 2>&1');
}

// user and data folder for apps with jobs; job sections in UCI
function setup_jobs(a, c) {
	let id = a.id, keep = {};
	for (let j in (a.jobs ?? [])) {
		let s = jsect(id, j.id);
		keep[s] = true;
		if (c.get('apps', s) != 'appjob') {
			c.set('apps', s, 'appjob');
			c.set('apps', s, 'enabled', '1');
		}
		c.set('apps', s, 'app', id);
		c.set('apps', s, 'job', j.id);
		// a schedule changed by the admin stays; otherwise follow the package
		if (c.get('apps', s, 'custom') != '1') c.set('apps', s, 'schedule', j.schedule);
	}
	c.foreach('apps', 'appjob', (x) => { if (x.app == id && !keep[x['.name']]) c.delete('apps', x['.name']); });
	if (length(a.jobs ?? [])) {
		let u = app_user(id), d = data_dir(id);
		// own group of the same name (busybox adduser -S would want "nogroup")
		capture(sprintf('grep -q "^%s:" %s/etc/group || addgroup -S %s; grep -q "^%s:" %s/etc/passwd || adduser -S -D -H -G %s -h %s -s /bin/false %s',
			u, ROOT, u, u, ROOT, u, shq(d), u));
		capture(sprintf('mkdir -p %s && chown %s %s && chmod 700 %s', shq(d), u, shq(d), shq(d)));
	}
}

function job(o) {
	mkdir(ST);
	writefile(ST + '/job.json', sprintf('%J', { ...o, time: time() }));
}

/* ---------- installed apps ---------- */

// the icon as data: URL – shown by the admin interface without a request to
// the apps web server (other origin, port and maybe certificate)
const ICON_TYPES = { svg: 'image/svg+xml', png: 'image/png', webp: 'image/webp', jpg: 'image/jpeg', jpeg: 'image/jpeg', gif: 'image/gif' };
function icon_data(base, id, icon) {
	if (type(icon) != 'string' || match(icon, /(^|\/)\.\.(\/|$)/) || substr(icon, 0, 1) == '/') return null;
	let ext = match(lc(icon), /\.([a-z]+)$/), mime = ext ? ICON_TYPES[ext[1]] : null;
	let p = base + '/' + id + '/' + icon, st = stat(p);
	if (!mime || !st || st.type != 'file' || st.size > 65536) return null;
	let d = readfile(p);
	return d ? 'data:' + mime + ';base64,' + b64enc(d) : null;
}

// where an installed app lives: web apps in /www-apps, system apps in /opt
function app_dir(id) {
	for (let d in [ APPS, SYS ])
		if (stat(d + '/' + id + '/app.json')?.type == 'file') return d + '/' + id;
	return null;
}

function installed() {
	let c = conf().c, list = [], seen = {};
	for (let base in [ APPS, SYS ])
	for (let id in sort(lsdir(base) ?? [])) {
		if (!match(id, ID_RE) || seen[id]) continue;
		let a = json(readfile(base + '/' + id + '/app.json') ?? 'null');
		if (type(a) != 'object') continue;
		seen[id] = true;
		let s = sect(id);
		let users = c.get('apps', s, 'users');
		push(list, { id, name: a.name ?? id, version: a.version, publisher: a.publisher ?? '',
			description: a.description ?? '', type: a.type ?? 'webapp', entry: a.entry ?? 'index.html',
			icon: a.icon ?? null, icon_data: icon_data(base, id, a.icon), category: a.category ?? '', homepage: a.homepage ?? '', license: a.license ?? '',
			permissions: a.permissions ?? [], internet: a.internet === true, jobs: jobs_of(id, a, c),
			window: type(a.window) == 'object' ? { width: a.window.width ?? null, height: a.window.height ?? null } : null,
			opens: opens_of(a), commands: base == SYS ? (a.commands ?? []) : [], requires: a.requires ?? [],
			verified: c.get('apps', s, 'verified') == '1', source: c.get('apps', s, 'source') ?? '',
			installed: +(c.get('apps', s, 'installed') ?? 0),
			users: type(users) == 'array' ? users : (users ? [ users ] : []), display: c.get('apps', s, 'display') ?? null });
	}
	return list;
}

/* ---------- catalog ---------- */

function fetch_catalog(url) {
	let r = capture(join(' ', map([ ...CURL, '--max-time', '20', url ], shq)));
	if (r.rc != 0) {
		let m = match(r.out, /curl: \([0-9]+\)[^\n]*/);
		return { error: m ? m[0] : 'curl exit ' + r.rc };
	}
	let d = json(r.out);
	if (type(d) != 'object' || type(d.apps) != 'array') return { error: 'not a ShareOS app catalog' };
	return d;
}

function merge(catalogs, channel) {
	let inst = {}, apps = [];
	for (let a in installed()) inst[a.id] = a;
	for (let cat in catalogs) {
		for (let a in cat.apps) {
			if (type(a) != 'object' || !match(a.id ?? '', ID_RE) || type(a.versions) != 'array') continue;
			let vs = filter(a.versions, (v) => type(v) == 'object' && vparse(v.version) && match(v.url ?? '', URL_RE)
				&& match(v.sha256 ?? '', /^[0-9a-f]{64}$/) && (channel == 'beta' || !v.prerelease));
			vs = sort(vs, (x, y) => -vcmp(x.version, y.version));
			if (!length(vs)) continue;
			let i = inst[a.id];
			push(apps, { id: a.id, name: a.name ?? a.id, publisher: a.publisher ?? '', description: a.description ?? '',
				category: a.category ?? '', icon_url: a.icon_url ?? null, homepage: a.homepage ?? '',
				type: a.type ?? 'webapp', source: cat.url, versions: vs, latest: vs[0].version, requires: vs[0].requires ?? [],
				installed: i?.version ?? null,
				update_available: !!i && vcmp(vs[0].version, i.version) > 0,
				compatible: !too_old(vs[0].min_shareos) });
		}
	}
	return sort(apps, (x, y) => lc(x.name) < lc(y.name) ? -1 : 1);
}

function cmd_catalog() {
	let K = conf(), channel = K.channel, sources = K.sources;
	let cats = [], errors = [];
	for (let u in sources) {
		let d = fetch_catalog(u);
		if (d.error) push(errors, { source: u, error: d.error });
		else push(cats, { ...d, url: u });
	}
	mkdir(ST);
	writefile(ST + '/catalogs.json', sprintf('%J', cats));
	let res = { time: time(), channel, sources, errors, apps: merge(cats, channel) };
	writefile(ST + '/catalog-errors.json', sprintf('%J', errors));
	writefile(ST + '/catalog-time', '' + res.time);
	return out(res);
}

function cmd_cached() {
	let K = conf(), channel = K.channel, sources = K.sources;
	let cats = json(readfile(ST + '/catalogs.json') ?? '[]') ?? [];
	let errors = json(readfile(ST + '/catalog-errors.json') ?? '[]') ?? [];
	return out({ time: +(readfile(ST + '/catalog-time') ?? 0), channel, sources, errors, apps: merge(cats, channel) });
}

/* ---------- install ---------- */

function check_tar(file) {
	// busybox tar here has no -z: unpack with gunzip
	let r = capture('gunzip -c ' + shq(file) + ' | tar -tvf - && gunzip -t ' + shq(file));
	if (r.rc != 0) return 'not a valid package (tar.gz)';
	let total = 0, has_json = false;
	for (let l in split(trim(r.out), '\n')) {
		if (l == '') continue;
		// busybox strips "../" and leading "/" itself, but such a package is not trustworthy
		if (match(l, /^tar: /)) return match(l, /removing leading/) ? 'unsafe path in package' : 'not a valid package (' + trim(l) + ')';
		let f = split(trim(l), /\s+/);
		// busybox: perms owner size date time name
		if (length(f) < 6) return 'unexpected package listing';
		let kind = substr(f[0], 0, 1), name = join(' ', slice(f, 5));
		if (kind != '-' && kind != 'd') return 'package contains links or special files: ' + name;
		name = replace(name, /^\.\//, '');
		if (substr(name, 0, 1) == '/' || match(name, /(^|\/)\.\.(\/|$)/)) return 'unsafe path in package: ' + name;
		if (name == 'app.json') has_json = true;
		total += +f[2];
	}
	if (!has_json) return 'app.json missing at the top of the package';
	if (total > MAX_FILES) return 'package too large when unpacked';
	return null;
}

/* ---------- system apps ---------- */

// the firmware's own commands (and shell builtins) are not taken over
function firmware_has(cmd) {
	for (let d in [ '/bin', '/sbin', '/usr/bin', '/usr/sbin' ])
		if (stat(ROOT + d + '/' + cmd) || lstat(ROOT + d + '/' + cmd)) return true;
	return false;
}

const STARTER_TAG = '# shareos-sysapp: ';
function starter_owner(cmd) {
	let m = match(readfile(SYSBIN + '/' + cmd, 512) ?? '', regexp(STARTER_TAG + '([a-z0-9-]+)'));
	return m ? m[1] : null;
}

/* ---------- services of system apps ---------- */

const CTL_RE = /^[a-z][a-z0-9-]{1,23}$/;
const SVC_VERBS = { start: true, boot: true };
// packages built before ShareOS 0.2.0-beta.9 have no "service" yet
const LEGACY_SERVICE = {
	tailscaled: { control: 'tailscale', on_install: 'start', delay: 5 },
	openvpn: { control: 'vpn', delay: 8 },
	'transmission-daemon': { control: 'transmission', delay: 5 },
	minidlna: { control: 'dlna', delay: 5 },
	ffmpeg: { control: 'media', boot: false }
};

function controller(name) { return ROOT + '/usr/sbin/shareos-' + name; }

// what a controller of the firmware can do: its line "shareos-service: …"
function ctl_verbs(name) {
	if (!match(name ?? '', CTL_RE)) return null;
	let m = match(readfile(controller(name), 4096) ?? '', /shareos-service:([ a-z-]*)/);
	if (!m) return null;
	let v = {};
	for (let w in split(trim(m[1]), /[ ]+/)) if (w != '') v[w] = true;
	return v;
}

function check_service(s) {
	if (s == null) return null;
	if (type(s) != 'object') return 'system app: "service" is an object { "control": … }';
	let v = ctl_verbs(s.control);
	if (!v) return 'system app: this ShareOS has no service controller "' + (s.control ?? '') + '" (shareos-<control>)';
	if (s.boot != null && type(s.boot) != 'bool') return 'system app: service.boot is true or false';
	if (s.boot !== false && !v.boot) return 'system app: the controller ' + s.control + ' cannot start at boot – set "boot": false';
	if (s.on_install != null && (!SVC_VERBS[s.on_install] || !v[s.on_install])) return 'system app: service.on_install must be one of: ' + join(', ', filter(keys(SVC_VERBS), (k) => v[k]));
	if (s.delay != null && (type(s.delay) != 'int' || s.delay < 0 || s.delay > 60)) return 'system app: service.delay is 0 … 60 seconds';
	for (let k in keys(s)) if (!(k in { control: 1, boot: 1, on_install: 1, delay: 1 })) return 'system app: unknown service field ' + k;
	return null;
}

// the service of an installed (or just checked) system app, or null
function service_of(a) {
	if (type(a) != 'object' || a.type != 'system') return null;
	let s = a.service ?? LEGACY_SERVICE[a.id];
	if (type(s) != 'object' || check_service(s)) return null;
	return { control: s.control, boot: s.boot !== false, on_install: s.on_install ?? null, delay: s.delay ?? 5, legacy: a.service == null };
}

// runs "<controller> <verb>"; in the background its output goes to the log
function service_run(svc, verb, bg, delay) {
	if (!ctl_verbs(svc.control)?.[verb]) return false;
	let cmd = shq(controller(svc.control)) + ' ' + verb;
	if (bg) capture(sprintf('( (%s%s </dev/null 2>&1 | logger -t shareos-%s) & ) >/dev/null 2>&1',
		delay ? 'sleep ' + delay + '; ' : '', cmd, svc.control));
	else capture(cmd + ' </dev/null >/dev/null 2>&1');
	return true;
}

function sysapp_json(id) {
	let a = json(readfile(SYS + '/' + id + '/app.json') ?? 'null');
	return type(a) == 'object' && a.id == id ? a : null;
}

// installed system apps that are services, sorted by delay then id
function services() {
	let l = [];
	for (let id in lsdir(SYS) ?? []) {
		if (!match(id, ID_RE)) continue;
		let a = sysapp_json(id), s = service_of(a);
		if (s) push(l, { id, name: a.name, proc: a.commands?.[0], ...s });
	}
	return sort(l, (x, y) => x.delay != y.delay ? x.delay - y.delay : (x.id < y.id ? -1 : 1));
}

// "Services -> Autostart": names switched off (UCI shareos.autostart.disabled)
function autostart_off() {
	let l = conf().c.get('shareos', 'autostart', 'disabled') ?? [];
	if (type(l) != 'array') l = split(l, ' ');
	let o = {};
	for (let n in l) if (n != '') o[n] = true;
	return o;
}

function cmd_services(what) {
	let l = services();
	if (what == 'list') return out({ services: l });
	if (what == 'boot') {
		let off = autostart_off(), started = [];
		for (let s in l)
			if (s.boot && !off[s.control] && service_run(s, 'boot', true, s.delay)) push(started, s.control);
		return out({ started });
	}
	if (what == 'stop') {
		let stopped = [];
		for (let s in reverse(l)) if (service_run(s, 'stop-all', false)) push(stopped, s.control);
		return out({ stopped });
	}
	die('usage: shareos-apps services list|boot|stop');
}

function check_system(a, dir) {
	let cmds = a.commands;
	if (type(cmds) != 'array' || !length(cmds) || length(cmds) > MAX_CMDS) return 'system app: "commands" lists 1 … ' + MAX_CMDS + ' programs';
	for (let c in cmds) {
		if (type(c) != 'string' || !match(c, CMD_RE)) return 'system app: invalid command ' + c;
		if (stat(dir + '/bin/' + c)?.type != 'file') return 'system app: program bin/' + c + ' missing in the package';
		if (firmware_has(c)) return 'system app: the command ' + c + ' is part of ShareOS already';
		let o = starter_owner(c);
		if (o && o != a.id) return 'system app: the command ' + c + ' comes from the app ' + o + ' already';
	}
	for (let k in [ 'permissions', 'jobs', 'opens', 'window' ])
		if (a[k] != null && !(type(a[k]) == 'array' && !length(a[k]))) return 'system app: "' + k + '" is only for web apps';
	return check_service(a.service);
}

function drop_starters(id, keep) {
	for (let c in (lsdir(SYSBIN) ?? []))
		if (!keep?.[c] && starter_owner(c) == id) unlink(SYSBIN + '/' + c);
}

// /opt/shareos, its sysapps and bin: readable for every account – rpcd runs
// with umask 077, so folders made from the web interface were root-only and
// programs of users (Transmission, FFmpeg) could not start
function opt_dirs() {
	capture(sprintf('mkdir -p %s %s && chmod 755 %s %s %s', shq(SYS), shq(SYSBIN), shq(ROOT + '/opt/shareos'), shq(SYS), shq(SYSBIN)));
}

// a starter per command; old starters of the app go
function write_starters(a) {
	let id = a.id, d = '/opt/shareos/sysapps/' + id, keep = {};
	opt_dirs();
	for (let c in a.commands) {
		keep[c] = true;
		writefile(SYSBIN + '/' + c, sprintf('#!/bin/sh
%s%s
D=%s
' +
			'[ -d "$D/share/terminfo" ] && export TERMINFO_DIRS="$D/share/terminfo${TERMINFO_DIRS:+:$TERMINFO_DIRS}"
' +
			'LD_LIBRARY_PATH="$D/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" exec "$D/bin/%s" "$@"
', STARTER_TAG, id, d, c));
		capture('chmod 755 ' + shq(SYSBIN + '/' + c));
	}
	drop_starters(id, keep);
}

function check_requires(a) {
	if (a.requires == null) return null;
	if (type(a.requires) != 'array' || length(a.requires) > MAX_REQUIRES) return 'requires: a list of at most ' + MAX_REQUIRES + ' app ids';
	for (let r in a.requires)
		if (type(r) != 'string' || !match(r, ID_RE) || r == a.id) return 'requires: invalid app id ' + r;
	return null;
}

function check_app(dir) {
	let a = json(readfile(dir + '/app.json') ?? 'null');
	if (type(a) != 'object') return { error: 'app.json is not valid JSON' };
	if (!match(a.id ?? '', ID_RE)) return { error: 'invalid app id (a-z, 0-9 and -)' };
	let re = check_requires(a);
	if (re) return { error: re };
	if (!vparse(a.version)) return { error: 'invalid version' };
	if (type(a.name) != 'string' || !length(a.name) || length(a.name) > 64) return { error: 'invalid name' };
	let t = a.type ?? 'webapp';
	if (t == 'system') {
		let se = check_system(a, dir);
		if (se) return { error: se };
		if (too_old(a.min_shareos)) return { error: 'needs ShareOS ' + a.min_shareos + ' or newer' };
		return a;
	}
	if (t != 'webapp') return { error: 'app type "' + t + '" is not supported by this ShareOS version yet' };
	let e = a.entry ?? 'index.html';
	if (match(e, /(^\/|\.\.)/) || stat(dir + '/' + e)?.type != 'file') return { error: 'entry file ' + e + ' missing' };
	if (too_old(a.min_shareos))
		return { error: 'needs ShareOS ' + a.min_shareos + ' or newer' };
	let je = check_jobs(a, dir) ?? check_ui(a);
	if (je) return { error: je };
	return a;
}

function install_file(file, verified, source) {
	let err = check_tar(file);
	if (err) return { error: err };
	mkdir(APPS);
	// unpacked on the apps drive when there is one (a large system app never touches the flash)
	let ds = disk_sys();
	sys_area_perms(ds);
	let tmp = (ds ?? APPS) + '/.new-' + time();
	capture('rm -rf ' + shq(tmp));
	mkdir(tmp);
	let r = capture(sprintf('gunzip -c %s | tar -xf - -C %s', shq(file), shq(tmp)));
	if (r.rc != 0) { capture('rm -rf ' + shq(tmp)); return { error: 'unpacking failed: ' + trim(r.out) }; }
	let a = check_app(tmp);
	if (a.error) { capture('rm -rf ' + shq(tmp)); return a; }
	capture(sprintf('chown -R 0:0 %s; chmod -R u=rwX,go=rX %s', shq(tmp), shq(tmp)));
	let sys = (a.type ?? 'webapp') == 'system';
	let base = sys ? SYS : APPS, dst = base + '/' + a.id;
	let on_disk = null;
	if (sys) {
		opt_dirs();
		capture(sprintf('chmod 755 %s/bin/* %s/lib/* 2>/dev/null', shq(tmp), shq(tmp)));
		// large: stays on the apps drive (a link in /opt), small: to /opt on the flash
		on_disk = ds && du_bytes(tmp) > BIG_SYSAPP ? ds : null;
		if (!on_disk) {
			let t2 = SYS + '/.new-' + time();
			let r2 = capture(sprintf('rm -rf %s; mv %s %s', shq(t2), shq(tmp), shq(t2)));
			if (r2.rc != 0) { capture('rm -rf ' + shq(tmp) + ' ' + shq(t2)); return { error: 'installing failed: ' + trim(r2.out) }; }
			tmp = t2;
		}
	} else if (ds) {
		// web apps live on the flash
		let t2 = APPS + '/.new-' + time();
		let r2 = capture(sprintf('rm -rf %s; mv %s %s', shq(t2), shq(tmp), shq(t2)));
		if (r2.rc != 0) { capture('rm -rf ' + shq(tmp) + ' ' + shq(t2)); return { error: 'installing failed: ' + trim(r2.out) }; }
		tmp = t2;
	}
	// an app that changed its type: the old one goes
	let other = (sys ? APPS : SYS) + '/' + a.id;
	if (stat(other)) { capture('rm -rf ' + shq(other)); if (!sys) drop_starters(a.id); }
	let old_target = sys ? sys_target(dst) : null;
	if (on_disk) {
		// the new version beside the old one on the drive, then the link in /opt
		let ddst = on_disk + '/' + a.id;
		capture(sprintf('rm -rf %s.old; [ -d %s ] && mv %s %s.old; mv %s %s && rm -rf %s && ln -s %s %s && rm -rf %s.old',
			shq(ddst), shq(ddst), shq(ddst), shq(ddst), shq(tmp), shq(ddst), shq(dst), shq(substr(ddst, length(ROOT))), shq(dst), shq(ddst)));
		if (old_target && old_target != ddst) capture('rm -rf ' + shq(old_target));
	} else {
		capture(sprintf('rm -rf %s.old; [ -L %s ] && rm -f %s; [ -d %s ] && mv %s %s.old; mv %s %s && rm -rf %s.old',
			shq(dst), shq(dst), shq(dst), shq(dst), shq(dst), shq(dst), shq(tmp), shq(dst), shq(dst)));
		// was on a drive before (now small, or no drive): the copy there goes
		if (old_target) capture('rm -rf ' + shq(old_target));
	}
	if (stat(dst + '/app.json')?.type != 'file') return { error: 'installing failed' };
	if (sys) write_starters(a);
	let c = conf().c, s = sect(a.id);
	let first = c.get('apps', s) != 'app';
	c.set('apps', s, 'app');
	c.set('apps', s, 'id', a.id);
	c.set('apps', s, 'version', a.version);
	c.set('apps', s, 'verified', verified ? '1' : '0');
	c.set('apps', s, 'source', source ?? 'upload');
	c.set('apps', s, 'installed', '' + time());
	if (first && !sys) c.set('apps', s, 'users', [ '*' ]);
	setup_jobs(a, c);
	c.commit('apps');
	cron_sync();
	// a service: start it right away when it asks for that (in the background)
	let svc = sys ? service_of(a) : null;
	if (svc?.on_install) service_run(svc, svc.on_install, true, 0);
	return { ok: true, id: a.id, version: a.version, verified, requires: a.requires ?? [] };
}

// install_catalog and ensure_requires call each other (no hoisting in ucode)
let ensure_requires;

// from the catalog: download, verify, install – apps it needs first
function install_catalog(id, version, depth) {
	if (!match(id ?? '', ID_RE)) return { error: 'invalid app id' };
	let cats = json(readfile(ST + '/catalogs.json') ?? '[]') ?? [];
	let channel = conf().channel;
	let app = filter(merge(cats, 'beta'), (a) => a.id == id)[0];
	if (!app) return { error: depth ? id + ' is not in the store' : 'unknown app – refresh the store first' };
	let v = version ? filter(app.versions, (x) => x.version == version)[0] : filter(app.versions, (x) => channel == 'beta' || !x.prerelease)[0];
	if (!v) return { error: 'unknown version' };
	let need = ensure_requires(v.requires, depth);
	if (need.error) return need;
	job({ state: 'downloading', id, version: v.version });
	mkdir(ST);
	let f = ST + '/dl-' + id + '.sapp';
	let r = capture(join(' ', map([ ...CURL, '--max-time', '600', '--max-filesize', '' + MAX_PKG, '-o', f, v.url ], shq)));
	if (r.rc != 0) { unlink(f); return { error: 'download failed: ' + trim(r.out) }; }
	job({ state: 'verifying', id, version: v.version });
	let sum = split(trim(capture('sha256sum ' + shq(f)).out), ' ')[0];
	if (sum != v.sha256) { unlink(f); return { error: 'checksum mismatch – package not installed' }; }
	job({ state: 'installing', id, version: v.version });
	let res = install_file(f, true, app.source);
	unlink(f);
	if (res.error) return res;
	if (res.id != id) return { error: 'package contains another app (' + res.id + ')' };
	// the package may name more than the catalog did
	let more = ensure_requires(res.requires, depth);
	if (more.error) res.warning = more.error;
	if (length(need.installed) || length(more.installed)) res.also = [ ...need.installed, ...(more.installed ?? []) ];
	return res;
}

// apps an app needs: install the missing ones from the store
ensure_requires = function(reqs, depth) {
	let done = [];
	if (type(reqs) != 'array') return { installed: done };
	if (depth > 2) return { error: 'requires: too deep' };
	for (let r in reqs) {
		if (type(r) != 'string' || !match(r, ID_RE) || app_dir(r)) continue;
		let res = install_catalog(r, null, depth + 1);
		if (res.error) return { error: 'needs ' + r + ': ' + res.error, installed: done };
		push(done, r);
	}
	return { installed: done };
};

function cmd_install(id, version) {
	if (!match(id ?? '', ID_RE)) die('invalid app id');
	let res = install_catalog(id, version, 0);
	if (res.error) { job({ state: 'error', id, error: res.error }); die(res.error); }
	job({ state: 'done', id, version: res.version, also: res.also, warning: res.warning });
	return out(res);
}

function cmd_install_file(f) {
	let st = stat(f ?? '');
	if (st?.type != 'file') die('file not found');
	if (st.size > MAX_PKG) die('package too large');
	job({ state: 'installing', id: '', version: '' });
	let res = install_file(f, false, 'upload');
	if (res.error) { job({ state: 'error', error: res.error }); die(res.error); }
	// apps it needs, from the store (the uploaded app stays even if that fails)
	let need = ensure_requires(res.requires, 0);
	if (need.error) res.warning = need.error;
	if (length(need.installed ?? [])) res.also = need.installed;
	job({ state: 'done', id: res.id, version: res.version, also: res.also, warning: res.warning });
	return out(res);
}

// permission "notify": messages of apps through the box's notification service
// (web interface, e-mail, push). Key, title and text are checked here, the
// title gets the app's name in front, and an app may send at most
// NOTIFY_MAX messages an hour (the messages are kept on the flash).
const NOTIFY_MAX = 20;
const NOTIFY_KEY_RE = /^[A-Za-z0-9._-]{1,32}$/;
const NOTIFY_LEVELS = { info: 1, warn: 1, error: 1 };
const NOTIFY_SPOOL_MAX = 10;
function notify_app(id) {
	let d = match(id ?? '', ID_RE) ? app_dir(id) : null;
	let a = d ? json(readfile(d + '/app.json') ?? 'null') : null;
	return type(a) == 'object' && index(a.permissions ?? [], 'notify') >= 0 ? a : null;
}
function notify_text_ok(s, max, nl) {
	return type(s) == 'string' && length(s) <= max && !match(s, nl ? /[\x01-\x09\x0b-\x1f\x7f]/ : /[[:cntrl:]]/);
}
function app_notify(id, op, level, key, title, text) {
	let a = notify_app(id);
	if (!a) return { error: 'the app has no permission "notify"' };
	if (!match(key ?? '', NOTIFY_KEY_RE)) return { error: 'invalid key (1–32 characters A-Z a-z 0-9 . _ -)' };
	let full = 'app-' + id + '-' + key;
	if (op == 'clear') {
		system('/usr/sbin/shareos-notify clear ' + shq(full) + ' >/dev/null 2>&1');
		return { ok: true };
	}
	if (op != 'send') return { error: 'invalid operation' };
	if (!NOTIFY_LEVELS[level]) return { error: 'invalid level (info, warn, error)' };
	title = trim(title ?? ''); text = trim(text ?? '');
	if (title == '' || !notify_text_ok(title, 100, false)) return { error: 'invalid title (1–100 characters)' };
	if (!notify_text_ok(text, 1000, true)) return { error: 'invalid text (at most 1000 characters)' };
	// the last hour's sends of this app (RAM)
	mkdir(ST); mkdir(ST + '/notify');
	let rf = ST + '/notify/' + id, now = time();
	let sent = filter(map(split(readfile(rf) ?? '', '\n'), (x) => +x), (t) => t > now - 3600);
	if (length(sent) >= NOTIFY_MAX) return { error: 'too many messages (at most ' + NOTIFY_MAX + ' an hour)' };
	push(sent, now);
	writefile(rf, join('\n', sent) + '\n');
	let t = (a.name ?? id) + ': ' + title;
	let r = capture(sprintf('/usr/sbin/shareos-notify send %s apps %s %s %s %s %s', level, shq(full), shq(t), shq(t), shq(text), shq(text)));
	let j = json(trim(r.out) || 'null');
	return type(j) == 'object' && j.ok ? { ok: true, sent: j.sent } : { error: 'sending failed' };
}

// the messages a job left in its spool folder (shareos-app-notify): at most
// NOTIFY_SPOOL_MAX, only plain files of the app's user, 4 KB each
function notify_spool(id, dir, uid) {
	let n = 0;
	for (let f in sort(lsdir(dir) ?? [])) {
		let p = dir + '/' + f, s = lstat(p);
		if (!s || s.type != 'file' || s.uid != +uid || s.size > 4096) continue;
		if (++n > NOTIFY_SPOOL_MAX) break;
		let m = null;
		try { m = json(readfile(p) ?? 'null'); } catch (e) { }
		if (type(m) == 'object') app_notify(id, m.op, m.level, m.key, m.title, m.text);
	}
	capture('rm -rf ' + shq(dir));
}

function cmd_notify(id, op, a1, a2, a3, a4) {
	let r = op == 'clear' ? app_notify(id, op, null, a1) : app_notify(id, op, a1, a2, a3, a4);
	out(r);
	if (r.error) exit(1);
}

function cmd_remove(id, force) {
	let dir = match(id ?? '', ID_RE) ? app_dir(id) : null;
	if (!dir) die('unknown app');
	let users = map(filter(installed(), (a) => a.id != id && index(a.requires, id) >= 0), (a) => a.name);
	if (length(users) && force != '--force') die('needed by ' + join(', ', users));
	// a service: stop it first (e.g. the Transmission daemons of all accounts)
	let svc = service_of(sysapp_json(id));
	if (svc) service_run(svc, 'stop-all', false);
	let target = sys_target(dir);
	capture('rm -rf ' + shq(dir));
	if (target) capture('rm -rf ' + shq(target));
	drop_starters(id);
	let c = conf().c;
	c.delete('apps', sect(id));
	c.foreach('apps', 'appjob', (x) => { if (x.app == id) c.delete('apps', x['.name']); });
	c.commit('apps');
	cron_sync();
	// its messages are no longer a cause
	if (!ROOT) system('/usr/sbin/shareos-notify clear ' + shq('app-' + id + '-*') + ' >/dev/null 2>&1');
	// private folders of the app for accounts without "Dateien" (rpcd, ShareOS.fs)
	let area = c.get('storage', 'global', 'apps');
	if (area && match(area, /^[a-z0-9_-]+$/))
		capture(sprintf('rm -rf %s/mnt/%s/.shareos/userdata/*/%s', ROOT, area, id));
	// the app's user and its data on the box go with it
	let u = app_user(id);
	if (match(readfile(ROOT + '/etc/passwd') ?? '', regexp('(^|\n)' + u + ':'))) {
		capture('rm -rf ' + shq(data_dir(id)));
		capture('deluser ' + u + '; delgroup ' + u + ' 2>/dev/null');
	}
	return out({ ok: true });
}

// run a job: as the app's user, in its data folder, with a time limit; one at a time
function cmd_run_job(id, j) {
	if (!match(id ?? '', ID_RE) || !match(j ?? '', JOB_RE)) die('invalid app or job');
	let a = json(readfile(APPS + '/' + id + '/app.json') ?? 'null');
	let def = type(a) == 'object' ? filter(a.jobs ?? [], (x) => x.id == j)[0] : null;
	if (!def || index(a.permissions ?? [], 'cron') < 0) die('unknown job');
	mkdir(ST); mkdir(ST + '/jobs');
	let base = ST + '/jobs/' + id + '.' + j, lock = base + '.lock';
	if (!mkdir(lock)) die('job is already running');
	let u = app_user(id), d = data_dir(id), t0 = time();
	let uid = trim(capture('id -u ' + u).out);
	if (!match(uid, /^[0-9]+$/) || +uid < 100) { system('rmdir ' + shq(lock)); die('the app user is missing – reinstall the app'); }
	// permission "notify": the job leaves its messages in a spool folder
	// (shareos-app-notify); they are sent when it has finished
	let spool = index(a.permissions ?? [], 'notify') >= 0 ? ST + '/spool/' + id : null;
	if (spool) {
		mkdir(ST + '/spool');
		capture(sprintf('rm -rf %s && mkdir -m 700 %s && chown %s:%s %s', shq(spool), shq(spool), u, u, shq(spool)));
	}
	// the job and everything it starts runs as the app user; at the time limit
	// all processes of that user are stopped (TERM, then KILL)
	let sh = sprintf(`
cd %s || exit 1
export APP_ID=%s APP_DIR=%s APP_DATA=%s HOME=%s%s
kill_app() { for p in /proc/[0-9]*; do [ "$(awk '/^Uid:/ {print $2; exit}' $p/status 2>/dev/null)" = %s ] && kill -$1 \${p#/proc/} 2>/dev/null; done; }
nice -n 10 su -p -s /bin/sh %s -c %s &
pid=$!
( sleep %d; kill -0 $pid 2>/dev/null || exit 0; touch %s; kill_app TERM; sleep 3; kill_app KILL ) </dev/null >/dev/null 2>&1 &
w=$!
wait $pid; rc=$?
kill $w 2>/dev/null
kill_app KILL
exit $rc`, shq(d), id, shq(APPS + '/' + id), shq(d), shq(d), spool ? ' SHAREOS_NOTIFY_DIR=' + shq(spool) : '', uid, u,
		shq('exec /bin/sh ' + shq(APPS + '/' + id + '/' + def.command)), +(def.timeout ?? 300), shq(base + '.timeout'));
	unlink(base + '.timeout');
	let r = capture('/bin/sh -c ' + shq(sh));
	let o = r.out;
	if (length(o) > MAX_LOG) o = '…\n' + substr(o, -MAX_LOG);
	writefile(base + '.log', o);
	let st = { time: t0, duration: time() - t0, rc: r.rc, timeout: stat(base + '.timeout') != null };
	unlink(base + '.timeout');
	writefile(base + '.json', sprintf('%J', st));
	system('rmdir ' + shq(lock));
	if (spool) notify_spool(id, spool, uid);
	system(sprintf('logger -t shareos-apps "job %s/%s finished (exit %d, %d s)"', id, j, r.rc, st.duration));
	if (!ROOT) {
		let key = 'appjob-' + id + '-' + j;
		if (r.rc != 0 || st.timeout)
			system(sprintf('/usr/sbin/shareos-notify send warn apps %s %s %s %s %s >/dev/null 2>&1', shq(key),
				shq('Aufgabe „' + j + '“ von ' + id + ' fehlgeschlagen'), shq('Task “' + j + '” of ' + id + ' failed'),
				shq(st.timeout ? 'Zeitlimit überschritten.' : 'Exit-Code ' + r.rc + ' – siehe Protokoll unter APPS → Aufgaben.'),
				shq(st.timeout ? 'Time limit exceeded.' : 'Exit code ' + r.rc + ' – see the log under APPS → Tasks.')));
		else system('/usr/sbin/shareos-notify clear ' + shq(key) + ' >/dev/null 2>&1');
	}
	return out(st);
}

function cmd_job_log(id, j) {
	if (!match(id ?? '', ID_RE) || !match(j ?? '', JOB_RE)) die('invalid app or job');
	return out({ log: readfile(ST + '/jobs/' + id + '.' + j + '.log') ?? '', last: job_state(id, j) });
}

switch (ARGV[0]) {
case 'catalog': cmd_catalog(); break;
case 'cached': cmd_cached(); break;
case 'list': out({ apps: installed() }); break;
case 'fix-perms': {
	if (!stat(ROOT + '/opt/shareos')) { out({ ok: true }); break; }
	opt_dirs();
	// large system apps still on the flash (older versions): to the apps drive
	let ds = disk_sys(), moved = [];
	sys_area_perms(ds);
	if (ds) for (let id in lsdir(SYS) ?? []) {
		let d = SYS + '/' + id;
		if (!match(id, ID_RE) || lstat(d)?.type != 'directory' || du_bytes(d) <= BIG_SYSAPP) continue;
		let t = ds + '/' + id;
		let r = capture(sprintf('mkdir -p %s && chmod 755 %s && rm -rf %s.new && cp -a %s %s.new && rm -rf %s && mv %s.new %s && mv %s %s.old && ln -s %s %s && rm -rf %s.old',
			shq(ds), shq(ds), shq(t), shq(d), shq(t), shq(t), shq(t), shq(t), shq(d), shq(d), shq(substr(t, length(ROOT))), shq(d), shq(d)));
		if (r.rc == 0) push(moved, id); else capture('rm -rf ' + shq(t) + '.new');
	}
	out({ ok: true, moved });
	break;
}
case 'services': cmd_services(ARGV[1]); break;
case 'install': cmd_install(ARGV[1], ARGV[2]); break;
case 'install-file': cmd_install_file(ARGV[1]); break;
case 'remove': cmd_remove(ARGV[1], ARGV[2]); break;
case 'status': out(json(readfile(ST + '/job.json') ?? 'null') ?? { state: 'idle' }); break;
case 'run-job': cmd_run_job(ARGV[1], ARGV[2]); break;
case 'job-log': cmd_job_log(ARGV[1], ARGV[2]); break;
case 'notify': cmd_notify(ARGV[1], ARGV[2], ARGV[3], ARGV[4], ARGV[5], ARGV[6]); break;
default:
	warn('usage: shareos-apps catalog | cached | list | install <id> [version] | install-file <file> | remove <id> | status | run-job <id> <job> | job-log <id> <job> | notify <id> send|clear … | services list|boot|stop\n');
	exit(2);
}
