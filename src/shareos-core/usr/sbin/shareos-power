#!/usr/bin/ucode -S
//
// shareos-power – switch the box off and on by a weekly schedule
//
//   shareos-power status        schedule, next switch-on and switch-off (JSON)
//   shareos-power arm           program the next switch-on into the box's
//                               wake-up alarm (boot, every hour, after saving)
//   shareos-power off           the scheduled switch-off (cron): arm, then
//                               power off – not while a storage job runs
//
// Schedule: UCI shareos.power (enabled '1'; on_mon … on_sun and off_mon …
// off_sun as HH:MM, empty: nothing that day). Switching on needs the wake-up
// alarm of the Weltrend MCU (DNS-320L, DNS-320 rev B, DNS-327L; board.env
// BOARD_RTC=mcu), set through dns320l-daemon (local time). Other boxes:
// switch-off only. The alarm holds one time, so it is set again every hour
// and before every scheduled switch-off.
//   SHAREOS_ROOT=<dir>            fake root (tests)
//   SHAREOS_POWER_NOW=<epoch>     the current time (tests)
//   SHAREOS_POWER_DAEMON=<cmd>    instead of dns320l-daemon (tests)
//   SHAREOS_POWER_DRY=1           print instead of powering off (tests)
//
'use strict';

import { readfile, stat, popen } from 'fs';
import { cursor } from 'uci';

const ROOT = getenv('SHAREOS_ROOT') ?? '';
const DAYS = [ 'sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat' ];   // localtime().wday % 7
const DAEMON = getenv('SHAREOS_POWER_DAEMON') ?? '/usr/sbin/dns320l-daemon';
const TIME_RE = /^([01][0-9]|2[0-3]):([0-5][0-9])$/;
// the alarm counts whole minutes and the MCU cuts the power 3 s after the
// shutdown: a switch-on at least one minute ahead is still reached
const MARGIN = 60;

function out(o) { print(sprintf('%J\n', o)); }
function shq(s) { return "'" + replace('' + s, "'", "'\\''") + "'"; }
function capture(cmd) {
	let f = popen('(' + cmd + ') 2>&1', 'r');
	if (!f) return '';
	let o = f.read('all') ?? '';
	f.close();
	return trim(o);
}
function now() { let n = getenv('SHAREOS_POWER_NOW'); return n ? +n : time(); }
function log(msg) { system('logger -t shareos-power ' + shq(msg) + ' 2>/dev/null'); }

// switching on needs the MCU's wake-up alarm
function supported() {
	if (getenv('SHAREOS_POWER_DAEMON')) return true;
	let env = readfile(ROOT + '/tmp/sys/board.env') ?? '';
	return !!match(env, /BOARD_RTC="?mcu/) && stat(DAEMON) != null;
}

function conf() {
	let c = ROOT ? cursor(ROOT + '/etc/config') : cursor();
	let p = c.get_all('shareos', 'power') ?? {}, days = {};
	for (let d in DAYS) {
		let on = p['on_' + d] ?? '', off = p['off_' + d] ?? '';
		days[d] = { on: match(on, TIME_RE) ? on : '', off: match(off, TIME_RE) ? off : '' };
	}
	return { enabled: p.enabled == '1', days };
}

// the next time (epoch, local time) after t where kind ('on'/'off') is due
function next_time(cf, kind, t) {
	if (!cf.enabled) return null;
	// from noon, so a day of 23 or 25 hours (summer time) is not skipped
	let b = localtime(t), noon = timelocal({ year: b.year, mon: b.mon, mday: b.mday, hour: 12, min: 0, sec: 0 });
	for (let i = 0; i < 8; i++) {
		let day = localtime(noon + i * 86400);
		let v = cf.days[DAYS[day.wday % 7]][kind];   // ucode: Sunday is 7
		if (!v) continue;
		let m = match(v, TIME_RE);
		let at = timelocal({ year: day.year, mon: day.mon, mday: day.mday, hour: +m[1], min: +m[2], sec: 0 });
		if (at > t) return at;
	}
	return null;
}

function fmt(t) {
	if (t == null) return null;
	let l = localtime(t);
	return sprintf('%04d-%02d-%02d %02d:%02d', l.year, l.mon, l.mday, l.hour, l.min);
}

function status() {
	let cf = conf(), t = now(), sup = supported();
	let alarm = sup ? capture(DAEMON + ' -x ReadAlarm') : null;
	return { supported: sup, enabled: cf.enabled, days: cf.days,
		next_on: sup ? fmt(next_time(cf, 'on', t + MARGIN)) : null, next_off: fmt(next_time(cf, 'off', t)), alarm };
}

// the next switch-on into the MCU
function arm() {
	if (!supported()) return { ok: true, armed: null };
	let cf = conf(), at = next_time(cf, 'on', now() + MARGIN);
	let r;
	if (at == null) r = capture(DAEMON + ' -x WriteAlarm disable');
	else {
		let l = localtime(at);
		r = capture(sprintf('%s -x WriteAlarm %d %d %d %d', DAEMON, l.mon, l.mday, l.hour, l.min));
	}
	if (match(r, /^ERR/)) { log('setting the wake-up alarm failed: ' + r); return { error: r }; }
	return { ok: true, armed: fmt(at), alarm: r };
}

function power_off() {
	if (!conf().enabled) return { error: 'the schedule is off' };
	if (stat(ROOT + '/tmp/shareos-storage/lock')) {
		log('scheduled switch-off skipped: a storage job is running');
		return { error: 'a storage job is running' };
	}
	let a = arm();
	log('scheduled switch-off' + (a.armed ? ', back on ' + a.armed : ''));
	if (getenv('SHAREOS_POWER_DRY')) { print('poweroff\n'); return a; }
	system('/sbin/poweroff');
	return a;
}

switch (ARGV[0]) {
case 'status': out(status()); break;
case 'arm': out(arm()); break;
case 'off': out(power_off()); break;
default:
	print(join('\n', map(filter(split(readfile(sourcepath()) ?? '', '\n'), (l) => match(l, /^\/\/ {1,3}shareos-power/)), (l) => substr(l, 3))) + '\n');
	exit(2);
}
