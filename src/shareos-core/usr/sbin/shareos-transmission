#!/usr/bin/ucode -S
//
// shareos-transmission – one Transmission daemon per account
//
//   shareos-transmission start <account>   start (or confirm) the account's daemon
//   shareos-transmission stop <account>
//   shareos-transmission status <account>
//   shareos-transmission boot              start the daemons of all accounts that used it
//   shareos-transmission stop-all          stop all (system app removed, shutdown)
//   shareos-transmission watch <account> <folder|"">   the account's own watch folder
//                                          (new .torrent files there are added; restarts it)
//
// shareos-service: boot stop-all
//
// The daemon comes from the system app "transmission-daemon" (the store).
// Every account gets its own daemon, with its own torrents:
//   - it runs with the account's rights (admins: root, like their file browser),
//     so files belong to the account and storage limits apply;
//   - state (settings, resume files, .torrent files) on the account's drive:
//     users  /mnt/<home volume>/home/<account>/.config/transmission-daemon
//     admins /mnt/<first volume>/.shareos/transmission/<account>
//     (not in the flash: the daemon writes them often);
//   - default download folder: <personal folder>/Downloads, admins
//     /mnt/<volume>/Downloads;
//   - remote control only through a Unix socket in /tmp/shareos-transmission/
//     <account>/ (0700), reached by the apps web server's proxy
//     /_shareos/cgi/transmission – no TCP port for the RPC;
//   - peer port 51413 for root, 51413 + (uid - 999) for the others, or the
//     account's own one (app setting, .shareos-peerport, checked: 1024-65535,
//     not the default or own port of another account, not a port of the
//     box's services, not in use).
// Every JSON line printed is the result; exit code 1 on errors.
//
import { readfile, writefile, stat, lsdir, popen, unlink, rename } from 'fs';
import { cursor } from 'uci';

// JSON text -> value; null when the text is not JSON (never an exception:
// a damaged file or a tool that printed an error must not end the call)
function jparse(s) { try { return json(s); } catch (e) { return null; } }

const ROOT = getenv('SHAREOS_ROOT') ?? '';
const BIN = ROOT + '/opt/shareos/bin/transmission-daemon';
const ENABLED = ROOT + '/etc/shareos/transmission';     // <account> -> state dir (persists)
const RUN = ROOT + '/tmp/shareos-transmission';
const NAME_RE = /^[a-z_][a-z0-9_-]{0,31}$/;

function out(o) { print(sprintf('%J\n', o)); }
function die(msg) { out({ error: msg }); exit(1); }
function shq(s) { return "'" + replace(s, "'", "'\\''") + "'"; }
function sh(cmd) {
	let p = popen(cmd + ' 2>&1', 'r');
	if (!p) return { rc: -1, out: '' };
	let o = p.read('all') ?? '';
	return { rc: p.close(), out: o };
}

function mounted(mp) { return index(readfile(ROOT + '/proc/mounts') ?? '', ' ' + mp + ' ') >= 0; }
function role(u) { return u == 'root' ? 'admin' : (cursor().get('accounts', u, 'role') ?? null); }
function uid_of(u) {
	for (let l in split(readfile(ROOT + '/etc/passwd') ?? '', '\n')) {
		let f = split(l, ':');
		if (f[0] == u) return +f[2];
	}
	return null;
}
function small_ram() { return match(readfile(ROOT + '/tmp/sys/board.env') ?? '', /BOARD_RAM_SMALL="?1/) != null; }

// where the account keeps state and downloads; null when no drive is there
function places(u) {
	let c = cursor(), r = role(u);
	if (r == 'admin') {
		let vol = null;
		c.foreach('storage', 'volume', (x) => { if (!vol && mounted('/mnt/' + x['.name'])) vol = x['.name']; });
		if (!vol) return null;
		return { state: '/mnt/' + vol + '/.shareos/transmission/' + u, download: '/mnt/' + vol + '/Downloads', run_as: 'root' };
	}
	if (r != 'user') return null;
	let v = c.get('accounts', u, 'home'), home = '/mnt/' + v + '/home/' + u;
	if (!v || !mounted('/mnt/' + v) || stat(ROOT + home)?.type != 'directory') return null;
	return { state: home + '/.config/transmission-daemon', download: home + '/Downloads', run_as: u };
}

function dir_of(u) { return RUN + '/' + u; }
function pid_of(u) {
	let p = +trim(readfile(dir_of(u) + '/pid') ?? '0');
	if (!(p > 1)) return null;
	let cmd = readfile(ROOT + '/proc/' + p + '/cmdline') ?? '';
	return index(cmd, 'transmission-daemon') >= 0 ? p : null;
}
function sock_of(u) { return dir_of(u) + '/rpc.sock'; }

// the hand-over folder of autobrr (shareos-autobrr) when this account gets its torrents
function autobrr_drop(u) {
	let c = cursor();
	if (c.get('autobrr', 'main', 'account') != u || c.get('autobrr', 'main', 'enabled') == '0') return null;
	let a = c.get('storage', 'global', 'apps');
	let d = a && match(a, /^[a-z0-9_-]+$/) ? '/mnt/' + a + '/.shareos/autobrr-drop' : null;
	return d && stat(ROOT + d)?.type == 'directory' ? d : null;
}

// the account's own watch folder (set by an app through the proxy)
function own_watch(pl) {
	let d = trim(readfile(ROOT + pl.state + '/.shareos-watch') ?? '');
	return d != '' && substr(d, 0, 5) == '/mnt/' && index(d, '/../') < 0 && stat(ROOT + d)?.type == 'directory' ? d : null;
}

// --- peer port -----------------------------------------------------------------
const PORT_BASE = 51413, PORT_SPAN = 1000;
// ports of the box's own services (and Syncthing's per-account range)
const RESERVED = [ 21, 22, 23, 25, 53, 67, 68, 80, 111, 123, 137, 138, 139, 161, 443, 445, 548, 631, 1900, 2049, 3260,
	5353, 8080, 8200, 8384, 9091, 9092, 10050, 10051, 21027 ];
const RESERVED_RANGES = [ [ 22000, 22999 ] ];

function default_port(uid) { return uid == 0 ? PORT_BASE : PORT_BASE + ((uid - 999) % PORT_SPAN); }
function run_uid(pl) { return pl.run_as == 'root' ? 0 : (uid_of(pl.run_as) ?? 1000); }

// the account's own peer port as stored (null: none or not a port)
function own_port(pl) {
	let t = trim(readfile(ROOT + pl.state + '/.shareos-peerport') ?? '');
	let p = match(t, /^[0-9]{4,5}$/) ? +t : 0;
	return p >= 1024 && p <= 65535 ? p : null;
}

// ports something listens on (TCP) or has bound (UDP), from /proc/net
function busy_ports() {
	let busy = {};
	for (let f in [ 'tcp', 'tcp6', 'udp', 'udp6' ])
		for (let l in split(readfile(ROOT + '/proc/net/' + f) ?? '', '\n')) {
			let m = match(l, /^ *[0-9]+: [0-9A-F]+:([0-9A-F]{4}) [0-9A-F]+:[0-9A-F]{4} ([0-9A-F]{2})/);
			if (m && (substr(f, 0, 3) == 'udp' || m[2] == '0A')) busy[hex(m[1])] = true;
		}
	return busy;
}

// the default ports of all accounts (root and uid >= 1000), so a later start
// of another account's daemon finds its port free
function account_defaults() {
	let ports = [ default_port(0) ];
	for (let l in split(readfile(ROOT + '/etc/passwd') ?? '', '\n')) {
		let uid = +(split(l, ':')[2] ?? -1);
		if (uid >= 1000 && uid < 65534) push(ports, default_port(uid));
	}
	return ports;
}

// the port the daemon gets: the own one while it fits (a stored value is checked
// again – the file lies in the account's folder), else the default
function effective_port(u, pl) {
	let p = own_port(pl), mine = default_port(run_uid(pl));
	if (p == null || p == mine) return mine;
	if (index(account_defaults(), p) >= 0) return mine;
	if (index(RESERVED, p) >= 0) return mine;
	for (let rg in RESERVED_RANGES) if (p >= rg[0] && p <= rg[1]) return mine;
	return p;
}

// why the port cannot be the account's peer port (null: it can)
function port_problem(u, pl, port, cur) {
	if (!(port >= 1024 && port <= 65535)) return 'the peer port must be between 1024 and 65535';
	let mine = default_port(run_uid(pl));
	if (port != mine && index(account_defaults(), port) >= 0) return 'port ' + port + ' is the default of another account';
	if (index(RESERVED, port) >= 0) return 'port ' + port + ' is used by a service of the box';
	for (let rg in RESERVED_RANGES)
		if (port >= rg[0] && port <= rg[1]) return 'ports ' + rg[0] + '-' + rg[1] + ' are used by Syncthing';
	for (let a in lsdir(ENABLED) ?? []) {
		if (a == u || !match(a, NAME_RE)) continue;
		let p2 = places(a);
		if (p2 && effective_port(a, p2) == port) return 'port ' + port + ' is used by Transmission of another account';
	}
	// in use by something else (the account's own running daemon may hold it)
	if (port != cur && busy_ports()[port]) return 'port ' + port + ' is in use';
	return null;
}

// watch: the folder the daemon watches for .torrent files; watch_autobrr: it is
// autobrr's hand-over folder (the account's own one cannot be set then)
function status(u) {
	let p = pid_of(u), pl = places(u), drop = autobrr_drop(u);
	return { account: u, installed: stat(BIN)?.type == 'file', running: !!p, pid: p, socket: p ? sock_of(u) : null,
		enabled: stat(ENABLED + '/' + u)?.type == 'file',
		watch: drop ?? (pl ? own_watch(pl) : null), watch_autobrr: !!drop,
		peer_port: pl ? effective_port(u, pl) : null, peer_port_own: pl ? own_port(pl) != null : false };
}

// settings the box decides; the rest (speed limits …) stays as the user set it
function settings(u, pl) {
	let file = ROOT + pl.state + '/settings.json';
	let s = jparse(readfile(file) ?? '{}') ?? {};
	if (type(s) != 'object') s = {};
	let uid = pl.run_as == 'root' ? 0 : (uid_of(pl.run_as) ?? 1000);
	let small = small_ram();
	s['rpc-enabled'] = true;
	s['rpc-bind-address'] = 'unix:' + sock_of(u);
	s['rpc-socket-mode'] = '0700';
	s['rpc-authentication-required'] = false;
	s['rpc-whitelist-enabled'] = false;
	s['rpc-host-whitelist-enabled'] = false;
	s['peer-port'] = effective_port(u, pl);
	s['peer-port-random-on-start'] = false;
	// nothing the remote control could use to run programs
	s['script-torrent-done-enabled'] = false;
	s['script-torrent-added-enabled'] = false;
	s['script-torrent-done-seeding-enabled'] = false;
	// watch folder: the hand-over folder of autobrr (torrents it found) for
	// its account, otherwise the account's own one (app setting, kept in
	// .shareos-watch: a folder of the account, checked when it was set)
	let drop = autobrr_drop(u), own = own_watch(pl);
	s['watch-dir-enabled'] = !!(drop ?? own);
	if (drop ?? own) s['watch-dir'] = drop ?? own; else delete s['watch-dir'];
	s['trash-original-torrent-files'] = !!drop;
	s['umask'] = pl.run_as == 'root' ? '002' : '077';
	if (s['download-dir'] == null) s['download-dir'] = pl.download;
	if (s['incomplete-dir-enabled'] == null) s['incomplete-dir-enabled'] = false;
	// a small NAS: little cache, few connections (128 MB boxes even fewer).
	// The daemon writes every key into settings.json, so "not set" cannot tell
	// the defaults apart from the user's choice: they are put in once per set
	// of defaults (marker .shareos-defaults next to it); afterwards whatever is
	// changed in the app (Transmission settings) stays.
	// Set 2 (#115): µTP off – on the 800 MHz ARM it costs more CPU than the
	// TCP peers together – and fewer peers.
	const DEFAULTS = 2;
	let mark = ROOT + pl.state + '/.shareos-defaults';
	if (+trim(readfile(mark) ?? '0') < DEFAULTS) {
		s['cache-size-mb'] = small ? 2 : 4;
		s['peer-limit-global'] = small ? 30 : 60;
		s['peer-limit-per-torrent'] = small ? 15 : 30;
		s['download-queue-enabled'] = true;
		s['download-queue-size'] = small ? 2 : 3;
		s['utp-enabled'] = false;
		writefile(mark, DEFAULTS + '\n');
	}
	// beside its place, then moved there: a power cut must not leave a
	// cut-off settings.json (Transmission would not start with it)
	writefile(file + '.new', sprintf('%.J\n', s));
	rename(file + '.new', file);
}

function start(u) {
	if (!match(u ?? '', NAME_RE)) die('invalid account');
	if (stat(BIN)?.type != 'file') die('Transmission is not installed (system app "transmission-daemon" in the store)');
	if (pid_of(u)) return out(status(u));
	let pl = places(u);
	if (!pl) die(role(u) == 'admin' ? 'no drive set up' : 'no personal folder on a drive');
	let ug = pl.run_as == 'root' ? 'root:root' : pl.run_as;
	if (pl.run_as != 'root' && sh(sprintf('su -s /bin/sh %s -c %s', shq(pl.run_as), shq('test -x ' + shq(BIN)))).rc != 0)
		die('the account cannot run Transmission (/opt/shareos is not readable for it – restart the box once)');
	let run = dir_of(u);
	sh('mkdir -p ' + shq(RUN) + ' && chmod 711 ' + shq(RUN) + ' && rm -rf ' + shq(run) + ' && mkdir -m 700 ' + shq(run) + ' && chown ' + shq(ug) + ' ' + shq(run));
	let mk = sprintf('mkdir -p %s %s', shq(ROOT + pl.state), shq(ROOT + pl.download));
	let r = pl.run_as == 'root' ? sh(mk) : sh(sprintf('su -s /bin/sh %s -c %s', shq(pl.run_as), shq(mk)));
	if (r.rc != 0) die('cannot create the folders: ' + trim(r.out));
	settings(u, pl);
	if (pl.run_as != 'root') sh(sprintf('chown %s %s %s', shq(pl.run_as), shq(ROOT + pl.state + '/settings.json'), shq(ROOT + pl.state + '/.shareos-defaults')));
	// nice 10: file shares and the web interface stay quick while it hashes
	r = sh(sprintf('start-stop-daemon -S -b -m -N 10 -p %s -c %s -x %s -- -f -g %s --logfile %s',
		shq(run + '/pid'), shq(ug), shq(BIN), shq(pl.state), shq(run + '/log')));
	if (r.rc != 0) die('cannot start: ' + trim(r.out));
	// remember the account for the next start of the box
	sh('mkdir -p ' + shq(ENABLED));
	writefile(ENABLED + '/' + u, pl.state + '\n');
	// the socket appears when the daemon is ready
	for (let i = 0; i < 50 && !stat(sock_of(u)); i++) sh('sleep 0.2');
	let st = status(u);
	if (!st.running || !stat(sock_of(u))) die('Transmission did not start: ' + trim(sh('tail -n 3 ' + shq(run + '/log')).out));
	out(st);
}

function stop(u, quiet) {
	if (!match(u ?? '', NAME_RE)) die('invalid account');
	let p = pid_of(u);
	if (p) {
		sh('kill ' + p);
		// it saves its state on the way out
		for (let i = 0; i < 50 && pid_of(u); i++) sh('sleep 0.2');
		if (pid_of(u)) sh('kill -9 ' + p);
	}
	if (!quiet) out(status(u));
}

let cmd = ARGV[0], u = ARGV[1];
switch (cmd) {
case 'start': start(u); break;
case 'stop': stop(u); break;
case 'status': if (!match(u ?? '', NAME_RE)) die('invalid account'); out(status(u)); break;
// watch <account> <folder|"">: the account's own watch folder (rpcd checked
// that the folder belongs to the account); autobrr's account keeps autobrr's
case 'watch': {
	if (!match(u ?? '', NAME_RE)) die('invalid account');
	let pl = places(u), d = ARGV[2] ?? '';
	if (!pl) die('no personal folder on a drive');
	if (autobrr_drop(u)) die('the watch folder of this account is used by autobrr');
	if (d != '' && (substr(d, 0, 5) != '/mnt/' || stat(ROOT + d)?.type != 'directory')) die('invalid folder');
	let f = ROOT + pl.state + '/.shareos-watch';
	if (d == '') unlink(f);
	else {
		writefile(f, d + '\n');
		if (pl.run_as != 'root') sh('chown ' + shq(pl.run_as) + ' ' + shq(f));
	}
	// the daemon reads its watch folder only when it starts (not over RPC)
	if (pid_of(u)) { sh('/usr/sbin/shareos-transmission stop ' + shq(u)); sh('/usr/sbin/shareos-transmission start ' + shq(u)); }
	out({ ok: true, watch: d == '' ? null : d });
	break;
}
// port <account> <port|"">: the account's own peer port ("" = the default);
// the daemon restarts with it
case 'port': {
	if (!match(u ?? '', NAME_RE)) die('invalid account');
	let pl = places(u), v = ARGV[2] ?? '';
	if (!pl) die('no personal folder on a drive');
	let f = ROOT + pl.state + '/.shareos-peerport';
	if (v == '') unlink(f);
	else {
		if (!match(v, /^[0-9]{1,5}$/)) die('the peer port must be a number');
		let cur = pid_of(u) ? effective_port(u, pl) : null;
		let why = port_problem(u, pl, +v, cur);
		if (why) die(why);
		sh('mkdir -p ' + shq(ROOT + pl.state));
		writefile(f, v + '\n');
		if (pl.run_as != 'root') sh('chown ' + shq(pl.run_as) + ' ' + shq(f));
	}
	if (pid_of(u)) { sh('/usr/sbin/shareos-transmission stop ' + shq(u)); sh('/usr/sbin/shareos-transmission start ' + shq(u)); }
	out({ ok: true, peer_port: effective_port(u, pl) });
	break;
}
case 'boot':
	if (stat(BIN)?.type != 'file') { out({ started: [] }); break; }
	let started = [];
	for (let a in lsdir(ENABLED) ?? []) {
		if (!match(a, NAME_RE) || !role(a)) continue;
		let r = sh('/usr/sbin/shareos-transmission start ' + shq(a));
		if (r.rc == 0) push(started, a);
	}
	out({ started });
	break;
case 'stop-all':
	for (let a in lsdir(RUN) ?? []) if (match(a, NAME_RE)) stop(a, true);
	sh('rm -rf ' + shq(RUN));
	out({ ok: true });
	break;
default:
	die('usage: shareos-transmission start|stop|status <account> | watch <account> <folder> | port <account> <port> | boot | stop-all');
}
