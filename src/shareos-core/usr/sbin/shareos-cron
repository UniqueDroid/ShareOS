#!/bin/sh
#
# shareos-cron – the ShareOS part of root's crontab, generated from UCI
#
#   shareos-cron sync      rewrite the block between the ShareOS markers in
#                          /etc/crontabs/root (lines outside stay untouched)
#
# Entries: firmware update check every 6 hours (shareos.update.auto, default
# on; the minute differs per box so not all ask GitHub at once), Paperless
# inboxes (every paperless.global.interval minutes) and cloud jobs with a
# schedule (cloud.<job>.schedule, a 5-field cron time) and scheduled tasks of
# apps (apps.<job>=appjob, see shareos-apps), snapshots (snapshots.<job>:
# every hour/6h/day/week at its time); every 10 minutes the checks of
# shareos-notify. Areas switched off under System -> Appearance
# (shareos.ui.area_apps/area_cloud/area_paperless = 0) get no entries.
#
PATH=/usr/sbin:/usr/bin:/sbin:/bin
TAB=/etc/crontabs/root
BEGIN='# --- ShareOS (generated by shareos-cron, do not edit) ---'
END='# --- end ShareOS ---'

area_on() { [ "$(uci -q get shareos.ui.area_$1)" != 0 ]; }

entries() {
	# messages: RAID, volumes, temperature, SMART, updates (shareos-notify)
	echo "*/10 * * * * /usr/sbin/shareos-notify check >/dev/null 2>&1"
	if [ "$(uci -q get shareos.update.auto)" != 0 ]; then
		m=$(( $(cat /sys/class/net/eth0/address /proc/sys/kernel/hostname 2>/dev/null | cksum | cut -d' ' -f1) % 60 ))
		h=$(( m % 6 ))
		echo "$m $h-23/6 * * * /usr/sbin/shareos-update auto >/dev/null 2>&1"
	fi
	if area_on paperless && [ -n "$(uci -q get paperless.global.url)" ] && [ "$(uci -q get paperless.global.enabled)" != 0 ] \
		&& uci -q show paperless | grep -q '=inbox$'; then
		i=$(uci -q get paperless.global.interval); echo "$i" | grep -qE '^[0-9]+$' && [ "$i" -ge 1 ] && [ "$i" -le 60 ] || i=2
		echo "*/$i * * * * /usr/sbin/shareos-paperless run >/dev/null 2>&1"
	fi
	area_on cloud && for j in $(uci -q show cloud | sed -n "s/^cloud\.\([^.=]*\)=job$/\1/p"); do
		[ "$(uci -q get cloud."$j".enabled)" = 0 ] && continue
		s=$(uci -q get cloud."$j".schedule)
		echo "$s" | grep -qE '^[0-9*/,-]+( [0-9*/,-]+){4}$' || continue
		echo "$s /usr/sbin/shareos-cloud run $j >/dev/null 2>&1"
	done
	# snapshots: every hour / 6 hours / day / week (Sunday) at the job's time
	for j in $(uci -q show snapshots | sed -n "s/^snapshots\.\([^.=]*\)=job$/\1/p"); do
		[ "$(uci -q get snapshots."$j".enabled)" = 0 ] && continue
		echo "$j" | grep -qE '^[a-z][a-z0-9_]{0,31}$' || continue
		t=$(uci -q get snapshots."$j".time); echo "$t" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$' || t=03:15
		h=${t%:*}; h=${h#0}; m=${t#*:}; m=${m#0}
		case "$(uci -q get snapshots."$j".every)" in
			hour) s="$m * * * *" ;;
			6h) s="$m $((h % 6))-23/6 * * *" ;;
			week) s="$m $h * * 0" ;;
			*) s="$m $h * * *" ;;
		esac
		echo "$s /usr/sbin/shareos-snapshot run $j >/dev/null 2>&1"
	done
	# scheduled tasks of apps (permission "cron"); shareos-apps run-job checks the rest
	area_on apps && for j in $(uci -q show apps | sed -n "s/^apps\.\([^.=]*\)=appjob$/\1/p"); do
		[ "$(uci -q get apps."$j".enabled)" = 0 ] && continue
		s=$(uci -q get apps."$j".schedule); a=$(uci -q get apps."$j".app); n=$(uci -q get apps."$j".job)
		echo "$s" | grep -qE '^[0-9*/,-]+( [0-9*/,-]+){4}$' || continue
		echo "$a" | grep -qE '^[a-z][a-z0-9-]{1,31}$' && echo "$n" | grep -qE '^[a-z][a-z0-9-]{0,23}$' || continue
		echo "$s /usr/sbin/shareos-apps run-job $a $n >/dev/null 2>&1"
	done
}

cmd_sync() {
	mkdir -p /etc/crontabs
	touch $TAB
	new=$(mktemp)
	awk -v b="$BEGIN" -v e="$END" '$0 == b {skip = 1; next} $0 == e {skip = 0; next} !skip' $TAB > "$new"
	lines=$(entries)
	if [ -n "$lines" ]; then
		{ echo "$BEGIN"; echo "$lines"; echo "$END"; } >> "$new"
	fi
	if ! cmp -s "$new" $TAB; then
		cat "$new" > $TAB
		# busybox crond rereads changed crontabs once a minute; poke it anyway
		touch /etc/crontabs/cron.update 2>/dev/null
	fi
	rm -f "$new"
}

case "$1" in
	sync) cmd_sync ;;
	*) sed -n '3,14s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
