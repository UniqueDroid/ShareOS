#!/bin/sh
#
# shareos-storage – disks, RAID and volumes for ShareOS
#
#   shareos-storage boot | shutdown            (S20storage)
#   shareos-storage setup mirror|stripe|span <name> <disk> <disk> [--swap=MiB] [--fs=FS] --yes
#                                              one volume over two disks: mirror = RAID 1
#                                              (copy on both), stripe = RAID 0 (sum, faster,
#                                              no redundancy), span = JBOD (sum, one after
#                                              the other, no redundancy)
#   shareos-storage setup single <name>=<disk>[:FS] [<name>=<disk>[:FS]] [--swap=MiB] [--fs=FS] --yes
#                                              erase the disks and create volumes
#                                              (--swap: swap partition per disk,
#                                              default 1024, 0 = none; FS: ext4
#                                              (default), ext3, ext2, btrfs, exfat,
#                                              ntfs, vfat)
#   shareos-storage repair <name> <disk> [--swap=MiB] --yes
#                                              a mirror with a missing disk: erase <disk>,
#                                              add it to the mirror; the rebuild runs in
#                                              the background (see the RAID status)
#   shareos-storage mount <name> | umount <name>
#   shareos-storage forget <name>              unmount and remove from the config
#   shareos-storage spindown <minutes>         0 = never
#   shareos-storage smart-test short|long      SMART self-test on the disks in the bays
#                                              (not USB); the values are read again
#                                              when the tests are done
#   shareos-storage job                        state of the last setup job
#
# Disks are given as sda, sdb, ... (whole disks). Each disk gets an optional
# swap partition (label shareos-swap, used with equal priority on all disks)
# and a data partition. Volumes are mounted at /mnt/<name> and stored in
# /etc/config/storage (UCI). ext4 has everything (owners, storage limit per
# user); btrfs has owners but no storage limit; exfat and ntfs have neither
# (every user of a share may write) and cannot hold personal folders or the
# app area. The first ext4/btrfs volume also gets the app area
# /mnt/<name>/.shareos (storage.global.apps) for packages and app data. Names: a-z, 0-9,
# - and _, at most 16 characters (ext4 label limit).
#
# setup erases everything on the given disks – it refuses without --yes.
#
PATH=/usr/sbin:/usr/bin:/sbin:/bin
JOBDIR=/tmp/shareos-storage
JOB=$JOBDIR/job
MDCONF=/etc/mdadm.conf
PARTITIONS=/proc/partitions
SYSBLOCK=/sys/class/block
RAID_WAIT=40   # seconds to wait for late RAID members at boot

log() { logger -t shareos-storage "$*"; echo "$*"; }
die() {
	log "ERROR: $*"; job_set state error error "$*"
	[ -n "$IN_JOB" ] && shareos-notify send error storage storage-job "Speicher-Auftrag fehlgeschlagen" "Storage job failed" "$*" "$*" >/dev/null 2>&1
	exit 1
}

# --- job state (read by the rpcd plugin) ---------------------------------------
job_set() {
	[ -n "$IN_JOB" ] || return 0
	while [ $# -ge 2 ]; do
		grep -v "^$1=" $JOB > $JOB.tmp 2>/dev/null
		echo "$1=$2" >> $JOB.tmp
		mv $JOB.tmp $JOB
		shift 2
	done
}
job_start() {
	mkdir -p $JOBDIR
	if ! mkdir $JOBDIR/lock 2>/dev/null; then
		echo "another storage job is running" >&2; exit 1
	fi
	trap 'rmdir $JOBDIR/lock 2>/dev/null' EXIT
	IN_JOB=1
	printf 'state=running\nstarted=%s\naction=%s\n' "$(date +%s)" "$*" > $JOB
}
step() { log "$*"; job_set step "$*"; }

valid_name() { echo "$1" | grep -qE '^[a-z0-9][a-z0-9_-]{0,15}$'; }
# SHAREOS_STORAGE_DISKS: other disk names for tests (e.g. 'loop[0-9]+')
valid_disk() { echo "$1" | grep -qE "^(sd[a-z]${SHAREOS_STORAGE_DISKS:+|$SHAREOS_STORAGE_DISKS})\$" && [ -e /sys/block/$1 ]; }
partn() { case "$1" in *[0-9]) echo /dev/${1}p$2 ;; *) echo /dev/${1}$2 ;; esac; }
# is the device name $1 the disk $2 or one of its partitions? (loop1 is not part of loop10)
of_disk() { case "$2" in *[0-9]) case "$1" in "$2"|"$2"p[0-9]*) return 0 ;; esac ;; *) case "$1" in "$2"|"$2"[0-9]*) return 0 ;; esac ;; esac; return 1; }
SWAP_MB=1024
FS=ext4
valid_fs() { case "$1" in ext4|ext3|ext2|btrfs|exfat|ntfs|vfat) return 0 ;; esac; return 1; }
linux_fs() { case "$1" in ext4|ext3|ext2|btrfs) return 0 ;; esac; return 1; }
# file systems without owners: everybody may write, access is decided by the share
mount_args() {   # fs -> "-t <type> -o <options>"
	case "$1" in
		ntfs) echo "-t ntfs3 -o noatime,umask=000" ;;
		exfat) echo "-t exfat -o noatime,umask=000" ;;
		vfat) echo "-t vfat -o noatime,umask=000,utf8=1,shortname=mixed" ;;
		*) echo "-t $1 -o noatime" ;;
	esac
}

# ext4 user quota needs CONFIG_QUOTA and the v2 quota format in the kernel;
# a volume with the quota feature cannot be mounted at all without them
quota_supported() { grep -qE ' (v2_read_file_info|qtree_read_dquot)( |$)' /proc/kallsyms 2>/dev/null; }
has_quota() { tune2fs -l "$1" 2>/dev/null | grep -q '^Filesystem features:.* quota'; }

# block devices worth probing: disks, their partitions and RAID arrays (never
# the raw flash), plus test disks
disk_devs() {
	for d in /dev/sd[a-z]* /dev/md[0-9]* ${SHAREOS_STORAGE_DISKS:+/dev/loop[0-9]*}; do [ -b "$d" ] && echo "$d"; done
}
find_dev() {   # TAG=value -> devices
	set -- "$1" $(disk_devs)
	[ $# -gt 1 ] && blkid -o device -t "$@" 2>/dev/null
}

volume_dev() {   # name -> block device of the file system (by UUID)
	local u
	u=$(uci -q get storage.$1.uuid) || return 1
	find_dev UUID="$u" | head -1
}

is_mounted() { grep -q " $1 " /proc/mounts; }

mount_volume() {
	local n=$1 dev fs
	[ "$(uci -q get storage.$n)" = volume ] || { echo "unknown volume $n" >&2; return 1; }
	is_mounted /mnt/$n && return 0
	dev=$(volume_dev $n) || { log "volume $n: file system not found"; return 1; }
	fs=$(uci -q get storage.$n.fstype || echo ext4)
	# a quick check only fixes what is safe to fix; a dirty file system is still mounted
	opts=noatime
	if [ "$fs" = ext4 ]; then
		e2fsck -p "$dev" >/dev/null 2>&1
		# storage limits per user: the ext4 "quota" feature keeps the usage in
		# hidden inodes (older volumes get it here, it needs the volume unmounted)
		if quota_supported; then
			has_quota "$dev" || { tune2fs -O quota "$dev" >/dev/null 2>&1 && log "volume $n: user quota enabled"; }
			has_quota "$dev" && opts=$opts,usrquota
		elif has_quota "$dev"; then
			tune2fs -O ^quota "$dev" >/dev/null 2>&1 && log "volume $n: kernel without quota support, quota feature removed"
		fi
	fi
	mkdir -p /mnt/$n
	if [ "$fs" != ext4 ]; then
		mount $(mount_args "$fs") "$dev" /mnt/$n || { log "volume $n: mount failed"; return 1; }
	elif ! mount -t "$fs" -o $opts "$dev" /mnt/$n 2>/dev/null; then
		# without quota support in the kernel the volume still has to come up
		[ "$opts" != noatime ] && mount -t "$fs" -o noatime "$dev" /mnt/$n && log "volume $n: mounted without user quota" \
			|| { log "volume $n: mount failed"; return 1; }
	fi
	log "volume $n mounted ($dev)"
}

umount_volume() {
	is_mounted /mnt/$1 || return 0
	sync
	umount /mnt/$1 2>/dev/null || umount -l /mnt/$1 || return 1
	log "volume $1 unmounted"
}

write_mdconf() {
	{
		echo "# written by shareos-storage"
		echo "DEVICE partitions"
		echo "HOMEHOST <ignore>"
		mdadm --detail --scan 2>/dev/null
	} > $MDCONF
}

# minutes -> hdparm -S value
spindown_value() {
	m=$1
	if [ "$m" -le 0 ]; then echo 0
	elif [ "$m" -le 20 ]; then echo $((m * 12))
	else v=$((240 + (m + 29) / 30)); [ $v -gt 251 ] && v=251; echo $v
	fi
}

apply_spindown() {
	m=$(uci -q get storage.global.spindown || echo 0)
	v=$(spindown_value "$m")
	for d in /sys/block/sd?; do
		[ -e "$d" ] || continue
		[ "$(cat $d/removable 2>/dev/null)" = 1 ] && continue
		hdparm -q -S "$v" /dev/${d##*/} 2>/dev/null
	done
}

# stop everything ShareOS uses on a disk before it is erased
release_disk() {
	local disk=$1 n dev base on_disk md sw sl p mp rest
	for n in $(uci -q show storage | sed -n "s/^storage\.\([^.=]*\)=volume$/\1/p"); do
		dev=$(volume_dev $n)
		[ -n "$dev" ] || continue
		base=${dev#/dev/}
		on_disk=0
		case "$base" in
			md*) for sl in $(ls /sys/block/$base/slaves 2>/dev/null); do of_disk $sl $disk && on_disk=1; done ;;
			*) of_disk $base $disk && on_disk=1 ;;
		esac
		if [ $on_disk = 1 ]; then
			umount_volume $n || die "volume $n on $disk is busy"
			uci delete storage.$n
		fi
	done
	uci commit storage
	# arrays that use a partition of this disk
	for md in /sys/block/md*; do
		[ -e "$md/slaves" ] || continue
		on_disk=0
		for sl in $(ls $md/slaves); do of_disk $sl $disk && on_disk=1; done
		if [ $on_disk = 1 ]; then
			grep -q "^/dev/${md##*/} " /proc/mounts && umount /dev/${md##*/}
			mdadm --stop /dev/${md##*/} >/dev/null 2>&1
		fi
	done
	# swap on this disk
	for sw in $(awk 'NR>1 {print $1}' /proc/swaps); do
		of_disk "${sw#/dev/}" $disk && swapoff $sw
	done
	# any other mount of this disk (e.g. mounted by hand)
	while read dev mp rest; do
		of_disk "${dev#/dev/}" $disk && { umount "$mp" || umount -l "$mp"; }
	done < /proc/mounts
	for p in $(partn $disk '[0-9]*'); do
		[ -e "$p" ] && mdadm --zero-superblock "$p" >/dev/null 2>&1
	done
}

partition() {   # disk type(L|R) -> [swap partition] + data partition; prints the data partition
	local disk=$1 sw p i
	# still claimed by something (RAID, device mapper)? say what instead of failing blindly
	for h in /sys/block/$disk/holders/* /sys/block/$disk/$disk*/holders/*; do
		[ -e "$h" ] && die "$disk is still in use by ${h##*/} (RAID or another firmware) – restart the box and try again"
	done
	out=$(wipefs -q -a /dev/$disk 2>&1) || {
		# the kernel may still hold the old partition table for a moment
		sleep 2; blockdev --rereadpt /dev/$disk 2>/dev/null
		out=$(wipefs -q -a -f /dev/$disk 2>&1) || die "erasing $disk failed: $(echo "$out" | tail -1)"
	}
	if [ "$SWAP_MB" -gt 0 ]; then
		printf 'label: gpt\n,%sMiB,S\n,,%s\n' "$SWAP_MB" "$2"
	else
		printf 'label: gpt\n,,%s\n' "$2"
	fi | sfdisk -q --wipe always --wipe-partitions always /dev/$disk >/dev/null \
		|| die "partitioning $disk failed"
	if [ "$SWAP_MB" -gt 0 ]; then sw=$(partn $disk 1); p=$(partn $disk 2); else sw=; p=$(partn $disk 1); fi
	i=0
	while [ ! -b $p ] && [ $i -lt 20 ]; do
		[ $i = 4 ] && blockdev --rereadpt /dev/$disk 2>/dev/null
		sleep 0.5; i=$((i + 1))
	done
	[ -b $p ] || die "partition $p did not appear"
	wipefs -q -a $p
	if [ -n "$sw" ]; then
		mkswap -L shareos-swap $sw >/dev/null || die "mkswap on $sw failed"
		swapon -p 10 $sw 2>/dev/null
	fi
	DATA=$p
}

swap_on() {
	for d in $(find_dev LABEL=shareos-swap); do
		grep -q "^$d " /proc/swaps || swapon -p 10 $d 2>/dev/null
	done
}

apps_area() {   # first ext4/btrfs volume becomes the app area unless one is set
	linux_fs "$(uci -q get storage.$1.fstype)" || return 0
	a=$(uci -q get storage.global.apps)
	[ -n "$a" ] && [ "$(uci -q get storage.$a)" = volume ] && return 0
	uci set storage.global.apps="$1"
	uci commit storage
	# passable for the app users (autobrr, Transmission …), not listable
	mkdir -p /mnt/$1/.shareos && chmod 711 /mnt/$1/.shareos
}

make_fs() {   # dev name fs
	step "creating file system ($3) on $1"
	case "$3" in
		ext4) mkfs.ext4 -F -q -L "$2" -m 1 $(quota_supported && echo -O quota) -E lazy_itable_init=1,lazy_journal_init=1 "$1" ;;
		ext3|ext2) mke2fs -t "$3" -F -q -L "$2" -m 1 -E lazy_itable_init=1 "$1" ;;
		vfat) mkfs.vfat -F 32 -n "$(printf %.11s "$2" | tr a-z A-Z)" "$1" >/dev/null ;;   # FAT labels: 11 characters
		btrfs) mkfs.btrfs -f -q -L "$2" "$1" >/dev/null ;;
		exfat) mkfs.exfat -L "$(printf %.15s "$2")" "$1" >/dev/null ;;   # exFAT labels: 15 characters
		ntfs) mkntfs -Q -F -q -L "$2" "$1" >/dev/null ;;
	esac || die "mkfs ($3) on $1 failed"
}

# GPT partition type: Linux, RAID or "Microsoft basic data" (exFAT/NTFS, so
# Windows and macOS show the disk when it is connected to a computer)
part_type() { case "$1" in R) echo R ;; exfat|ntfs|vfat) echo EBD0A0A2-B9E5-4433-87C0-68B6B72699C7 ;; *) echo L ;; esac; }

add_volume() {   # name dev layout fs
	local uuid
	uuid=$(blkid -s UUID -o value "$2")
	[ -n "$uuid" ] || die "no UUID on $2"
	uci -q delete storage.$1
	uci set storage.$1=volume
	uci set storage.$1.uuid="$uuid"
	uci set storage.$1.fstype="${4:-ext4}"
	uci set storage.$1.layout="$3"
	uci set storage.$1.enabled=1
	uci commit storage
	mount_volume $1 || die "mounting $1 failed"
}

free_md() {
	i=0
	while [ -e /sys/block/md$i ]; do i=$((i + 1)); done
	echo /dev/md$i
}

# --- commands ---------------------------------------------------------------------
cmd_setup() {
	layout=$1; shift
	yes=0; args=
	for a; do
		case "$a" in
			--yes) yes=1 ;;
			--swap=*) SWAP_MB=${a#--swap=} ;;
			--fs=*) FS=${a#--fs=} ;;
			*) args="$args $a" ;;
		esac
	done
	echo "$SWAP_MB" | grep -qE '^[0-9]+$' && [ "$SWAP_MB" -le 8192 ] || { echo "invalid --swap" >&2; exit 2; }
	valid_fs "$FS" || { echo "invalid --fs (ext4, ext3, ext2, btrfs, exfat, ntfs, vfat)" >&2; exit 2; }
	[ $yes = 1 ] || { echo "setup erases the disks – add --yes" >&2; exit 2; }
	set -- $args
	job_start "setup $layout $*"

	case "$layout" in
	mirror|stripe|span)
		name=$1 d1=$2 d2=$3
		case "$layout" in mirror) what=mirror ;; stripe) what="RAID 0" ;; span) what=JBOD ;; esac
		valid_name "$name" || die "invalid name '$name'"
		valid_disk "$d1" && valid_disk "$d2" && [ "$d1" != "$d2" ] || die "$what needs two different disks"
		uci -q get storage.$name >/dev/null && [ "$(uci -q get storage.$name)" = volume ] && \
			{ dev=$(volume_dev $name); case "$dev" in /dev/$d1*|/dev/$d2*|/dev/md*) ;; *) die "volume $name exists" ;; esac; }
		step "preparing $d1 and $d2"
		release_disk $d1; release_disk $d2
		step "partitioning $d1"; partition $d1 R; p1=$DATA
		step "partitioning $d2"; partition $d2 R; p2=$DATA
		md=$(free_md)
		step "creating $what $md"
		case "$layout" in
			mirror) mdadm --create $md --run --quiet --level=1 --raid-devices=2 --metadata=1.2 \
				--name="$name" --bitmap=internal $p1 $p2 ;;
			stripe) mdadm --create $md --run --quiet --level=0 --raid-devices=2 --metadata=1.2 \
				--name="$name" --chunk=512 $p1 $p2 ;;
			span) mdadm --create $md --run --quiet --level=linear --raid-devices=2 --metadata=1.2 \
				--name="$name" $p1 $p2 ;;
		esac || die "mdadm --create failed"
		write_mdconf
		make_fs $md "$name" $FS
		add_volume "$name" $md $layout $FS
		apps_area "$name"
		;;
	single)
		[ $# -ge 1 ] || die "no disks given"
		for v; do
			n=${v%%=*} d=${v#*=}; f=$FS
			case "$d" in *:*) f=${d#*:}; d=${d%%:*} ;; esac
			valid_name "$n" || die "invalid name '$n'"
			valid_disk "$d" || die "invalid disk '$d'"
			valid_fs "$f" || die "invalid file system '$f'"
		done
		for v; do
			n=${v%%=*} d=${v#*=}; f=$FS
			case "$d" in *:*) f=${d#*:}; d=${d%%:*} ;; esac
			step "preparing $d"
			release_disk $d
			step "partitioning $d"; partition $d $(part_type $f)
			make_fs $DATA "$n" $f
			add_volume "$n" $DATA single $f
			apps_area "$n"
		done
		write_mdconf
		;;
	*) die "unknown layout '$layout' (mirror|stripe|span|single)" ;;
	esac
	apply_spindown
	job_set state done step "finished"
	log "setup finished"
}

cmd_repair() {
	name=$1 disk=$2; shift 2
	yes=0
	for a; do
		case "$a" in --yes) yes=1 ;; --swap=*) SWAP_MB=${a#--swap=} ;; esac
	done
	echo "$SWAP_MB" | grep -qE '^[0-9]+$' && [ "$SWAP_MB" -le 8192 ] || { echo "invalid --swap" >&2; exit 2; }
	[ $yes = 1 ] || { echo "repair erases $disk – add --yes" >&2; exit 2; }
	job_start "repair $name $disk"
	[ "$(uci -q get storage.$name.layout)" = mirror ] || die "$name is not a mirror"
	md=$(volume_dev $name)
	case "$md" in /dev/md*) ;; *) die "mirror $name not found" ;; esac
	b=${md#/dev/}
	[ "$(cat /sys/block/$b/md/degraded 2>/dev/null || echo 0)" -ge 1 ] || die "mirror $name is complete – nothing to repair"
	valid_disk "$disk" || die "invalid disk '$disk'"
	need=0
	for sl in $(ls /sys/block/$b/slaves 2>/dev/null); do
		of_disk $sl $disk && die "$disk already belongs to $name"
		need=$(cat /sys/class/block/$sl/size)
	done
	# room for the data partition: disk minus swap and the partition table (sectors)
	have=$(( $(cat /sys/block/$disk/size) - SWAP_MB * 2048 - 4096 ))
	[ "$have" -ge "$need" ] || die "$disk is too small for $name"
	step "preparing $disk"
	release_disk $disk
	step "partitioning $disk"; partition $disk R; p=$DATA
	mdadm --manage $md --remove failed >/dev/null 2>&1
	mdadm --manage $md --remove detached >/dev/null 2>&1
	step "adding $disk to $name"
	mdadm --manage $md --add $p || die "mdadm --add failed"
	write_mdconf
	swap_on
	job_set state done step "rebuilding $name"
	log "repair of $name with $disk started"
}

# RAID members known to mdadm.conf (UUIDs of its ARRAY lines) and the ones
# that run already (inactive, half-assembled arrays are not counted)
conf_uuids() { [ -s $MDCONF ] && sed -n 's/^ARRAY .*UUID=\([0-9a-fA-F:]*\).*/\1/p' $MDCONF; }
running_uuids() { mdadm --detail --scan 2>/dev/null | sed -n 's/^ARRAY .*UUID=\([0-9a-fA-F:]*\).*/\1/p'; }
# partitions that are in no array yet: sdXN (or the test disks' pN)
free_parts() {
	awk 'NR > 2 { print $4 }' "$PARTITIONS" | grep -E "^(sd[a-z]+[0-9]+${SHAREOS_STORAGE_DISKS:+|(${SHAREOS_STORAGE_DISKS})p[0-9]+})\$" | while read -r p; do
		[ -n "$(ls -A "$SYSBLOCK/$p/holders" 2>/dev/null)" ] || echo "$p"
	done
}

# Disks can come up one after the other: the DNS-325 brings its second bay
# about 10 s after the first, after S20storage may have started (#65). A
# single "assemble --scan" then starts a mirror with one disk (or leaves a
# stripe/span inactive). So the members of the arrays in mdadm.conf are
# offered to "mdadm --incremental" as they appear – mdadm starts an array
# when its last member is there – for at most RAID_WAIT seconds; after that
# whatever is complete enough is started (a really missing disk gives a
# degraded mirror, as before). No mdadm.conf, no wait.
wait_members() {
	want=$(conf_uuids | sort -u)
	[ -n "$want" ] || return 0
	t=0
	while :; do
		for p in $(free_parts); do
			u=$(mdadm --examine --export /dev/$p 2>/dev/null | sed -n 's/^MD_UUID=//p')
			[ -n "$u" ] && echo "$want" | grep -qixF "$u" && mdadm --incremental /dev/$p >/dev/null 2>&1
		done
		run=$(running_uuids)
		missing=$want
		[ -n "$run" ] && missing=$(echo "$want" | grep -vixF "$run")
		[ -z "$missing" ] && return 0
		[ $t -ge "$RAID_WAIT" ] && break
		sleep 1; t=$((t + 1))
	done
	log "RAID incomplete after ${t}s: $(echo $missing) – starting what is there"
	mdadm --incremental --run --scan >/dev/null 2>&1
	return 0
}

cmd_boot() {
	wait_members
	if [ -s $MDCONF ]; then
		mdadm --assemble --scan --config=$MDCONF >/dev/null 2>&1
	else
		mdadm --assemble --scan >/dev/null 2>&1
	fi
	swap_on
	rc=0
	for n in $(uci -q show storage | sed -n "s/^storage\.\([^.=]*\)=volume$/\1/p"); do
		[ "$(uci -q get storage.$n.enabled)" = 0 ] && continue
		mount_volume $n || rc=1
	done
	apply_spindown
	return $rc
}

# SMART self-test on every disk in a bay (cron: storage.global.smart_test).
# When all tests are done (long: hours) the values are read again through
# rpcd, so the overview and the messages (shareos-notify) see the result.
cmd_smart_test() {
	case "$1" in short|long) ;; *) echo "smart-test short|long" >&2; return 2 ;; esac
	started=
	for d in /sys/block/sd?; do
		[ -e "$d" ] || continue
		n=${d##*/}
		case "$(readlink -f "$d")" in */usb*) continue ;; esac
		smartctl -t "$1" /dev/$n >/dev/null 2>&1 && started="$started $n"
	done
	[ -n "$started" ] || { log "SMART $1 self-test: no disk"; return 0; }
	log "SMART $1 self-test started:$started"
	(
		[ "$1" = short ] && sleep 300 || sleep 3600
		i=0
		while [ $i -lt 48 ]; do
			busy=0
			for n in $started; do smartctl -n standby -c /dev/$n 2>/dev/null | grep -q 'in progress' && busy=1; done
			[ $busy = 0 ] && break
			sleep 1800; i=$((i + 1))
		done
		for n in $started; do ubus call shareos.storage smart "{\"disk\":\"$n\"}" >/dev/null 2>&1; done
		/usr/sbin/shareos-notify check >/dev/null 2>&1
	) >/dev/null 2>&1 </dev/null &
	return 0
}

cmd_shutdown() {
	for sw in $(find_dev LABEL=shareos-swap); do swapoff $sw 2>/dev/null; done
	for n in $(uci -q show storage | sed -n "s/^storage\.\([^.=]*\)=volume$/\1/p"); do
		umount_volume $n
	done
	mdadm --stop --scan >/dev/null 2>&1
	return 0
}

case "$1" in
	boot) cmd_boot ;;
	repair) shift; cmd_repair "$@" ;;
	shutdown) cmd_shutdown ;;
	setup) shift; cmd_setup "$@" ;;
	mount)
		valid_name "$2" || exit 2
		uci set storage.$2.enabled=1 && uci commit storage
		mount_volume "$2" ;;
	umount)
		valid_name "$2" || exit 2
		umount_volume "$2" || { echo "volume $2 is busy" >&2; exit 1; }
		uci set storage.$2.enabled=0 && uci commit storage ;;
	forget)
		valid_name "$2" || exit 2
		umount_volume "$2" || { echo "volume $2 is busy" >&2; exit 1; }
		uci -q delete storage.$2
		[ "$(uci -q get storage.global.apps)" = "$2" ] && uci -q delete storage.global.apps
		uci commit storage
		rmdir /mnt/$2 2>/dev/null; true ;;
	smart-test) cmd_smart_test "$2" ;;
	spindown)
		echo "$2" | grep -qE '^[0-9]+$' || exit 2
		uci set storage.global.spindown="$2" && uci commit storage
		apply_spindown ;;
	job) cat $JOB 2>/dev/null ;;
	*) sed -n '3,27s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
