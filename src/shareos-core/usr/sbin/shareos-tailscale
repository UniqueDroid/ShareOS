#!/usr/bin/ucode -S
//
// shareos-tailscale – remote access to the box with Tailscale (system app "tailscale")
//
//   shareos-tailscale status            state, own addresses, tailnet, devices (JSON)
//   shareos-tailscale up                stdin JSON {authkey}: connect; without a key
//                                       the answer carries auth_url (sign-in link)
//   shareos-tailscale login             sign in again (other account): auth_url
//   shareos-tailscale down              disconnect (the daemon keeps running)
//   shareos-tailscale logout            sign out, the box leaves the tailnet
//   shareos-tailscale ping <address>    latency to a device of the tailnet
//   shareos-tailscale log               the last lines of the daemon log
//   shareos-tailscale start             start the daemon (system app installed)
//   shareos-tailscale boot | stop-all   start at boot / stop (app removed)
//
// tailscale changes the network of the whole box, so only admins reach this
// (rpcd shareos.apptailscale checks it). The box runs tailscaled with the
// kernel TUN device, without firewall rules and without changing its DNS;
// Go is held to a memory limit (256 MB boxes). The state (keys) is kept in
// /etc/shareos/tailscale (root only). The CLI is the same binary (TS_BE_CLI).
//
import { readfile, writefile, unlink, stat, popen, mkdir } from 'fs';
import { cursor } from 'uci';

const BIN = '/opt/shareos/bin/tailscaled';
const STATE = '/etc/shareos/tailscale';
const RUN = '/tmp/shareos-tailscale';
const SOCK = RUN + '/tailscaled.sock';
const PID = RUN + '/pid';
const LOG = RUN + '/log';
const KEY_RE = /^tskey-[A-Za-z0-9_-]{8,200}$/;
const PEER_RE = /^([0-9]{1,3}\.){3}[0-9]{1,3}$|^[0-9a-fA-F:]{2,39}$|^[A-Za-z0-9]([A-Za-z0-9.-]{0,250}[A-Za-z0-9])?$/;

function shq(s) { return "'" + replace(s, "'", "'\\''") + "'"; }
function sh(cmd) {
	let p = popen(cmd + ' 2>&1', 'r');
	if (!p) return { rc: -1, out: '' };
	let o = p.read('all') ?? '';
	return { rc: p.close(), out: o };
}
function out(o) { print(sprintf('%J\n', o)); }
function die(msg) { out({ error: msg }); exit(1); }
function stdin_json() { let j = json(readfile('/dev/stdin') ?? 'null'); return type(j) == 'object' ? j : {}; }
function installed() { return stat(BIN)?.type == 'file'; }
function hostname() { return trim(readfile('/proc/sys/kernel/hostname') ?? 'shareos'); }

function cli(args) { return sh('TS_BE_CLI=1 ' + shq(BIN) + ' --socket=' + shq(SOCK) + ' ' + join(' ', map(args, shq))); }

function pid() {
	let p = +trim(readfile(PID) ?? '0');
	return p > 1 && index(readfile('/proc/' + p + '/cmdline') ?? '', 'tailscaled') >= 0 ? p : null;
}

function set_enabled(on) {
	let c = cursor();
	c.set('tailscale', 'main', 'tailscale');
	c.set('tailscale', 'main', 'enabled', on ? '1' : '0');
	c.commit('tailscale');
}
function enabled() { return cursor().get('tailscale', 'main', 'enabled') == '1'; }

function start() {
	if (!installed()) die('Tailscale is not installed (system app "tailscale" in the store)');
	if (stat('/dev/net/tun') == null) die('this firmware has no tunnel support (TUN) – update ShareOS');
	if (pid()) return;
	sh('mkdir -p ' + RUN + ' ' + STATE + ' && chmod 700 ' + RUN + ' ' + STATE);
	unlink(SOCK);
	// GOMEMLIMIT/GOGC: the Go runtime keeps its heap small on a 256 MB box
	let cmd = sprintf('exec env GOMEMLIMIT=40MiB GOGC=25 %s --tun=tailscale0 --statedir=%s --socket=%s --port=41641 --no-logs-no-support >>%s 2>&1',
		shq(BIN), shq(STATE), shq(SOCK), shq(LOG));
	let r = sh(sprintf('start-stop-daemon -S -b -m -p %s -x /bin/sh -- -c %s', shq(PID), shq(cmd)));
	for (let i = 0; i < 50 && !stat(SOCK); i++) sh('sleep 0.2');
	if (!pid() || !stat(SOCK)) die('Tailscale did not start: ' + trim(sh('tail -n 3 ' + shq(LOG)).out || r.out));
}

function stop() {
	let p = pid();
	if (p) {
		sh('kill ' + p);
		for (let i = 0; i < 40 && pid(); i++) sh('sleep 0.2');
		if (pid()) sh('kill -9 ' + p);
	}
	unlink(PID); unlink(SOCK);
}

function peer_of(x) {
	return { name: x.HostName ?? '', dns: replace(x.DNSName ?? '', /\.$/, ''), os: x.OS ?? '', ips: x.TailscaleIPs ?? [],
		online: !!x.Online, last_seen: x.LastSeen ?? null, exit_node: !!x.ExitNodeOption, relay: x.Relay ?? '',
		direct: (x.CurAddr ?? '') != '', rx: x.RxBytes ?? 0, tx: x.TxBytes ?? 0 };
}

function status() {
	let st = { installed: installed(), tun: stat('/dev/net/tun') != null, running: !!pid(), enabled: enabled(),
		state: 'Stopped', auth_url: null, self: null, tailnet: null, peers: [], version: null };
	if (!st.running) return st;
	let r = cli([ 'status', '--json' ]);
	let j = json(trim(r.out) || 'null');
	if (type(j) != 'object') { st.state = 'Starting'; return st; }
	st.state = j.BackendState ?? 'NoState';
	st.version = j.Version ? split(j.Version, '-')[0] : null;
	st.auth_url = length(j.AuthURL ?? '') ? j.AuthURL : null;
	if (j.Self && st.state == 'Running') {
		let s = peer_of(j.Self);
		st.self = { name: s.name, dns: s.dns, ips: s.ips, online: s.online, key_expiry: j.Self.KeyExpiry ?? null };
	}
	if (j.CurrentTailnet) st.tailnet = { name: j.CurrentTailnet.Name ?? '', suffix: j.CurrentTailnet.MagicDNSSuffix ?? '' };
	for (let k in j.Peer ?? {}) push(st.peers, peer_of(j.Peer[k]));
	st.peers = sort(st.peers, (a, b) => (a.online != b.online) ? (a.online ? -1 : 1) : (lc(a.name) < lc(b.name) ? -1 : 1));
	return st;
}

// connect: "tailscale up" runs in the background (without a key it waits for
// the sign-in in the browser); the answer comes once there is a link or a connection
function up(reauth) {
	let a = reauth ? {} : stdin_json();
	if (a.authkey != null && a.authkey != '' && !match(a.authkey, KEY_RE)) die('invalid auth key (tskey-…)');
	start();
	set_enabled(true);
	let args = [ 'up', '--reset', '--netfilter-mode=off', '--accept-dns=false', '--hostname=' + hostname() ];
	if (a.authkey) push(args, '--auth-key=' + a.authkey);
	if (reauth) push(args, '--force-reauth');
	let cmd = 'TS_BE_CLI=1 ' + shq(BIN) + ' --socket=' + shq(SOCK) + ' ' + join(' ', map(args, shq));
	sh('(timeout 600 sh -c ' + shq(cmd) + ' >>' + shq(LOG) + ' 2>&1 &) </dev/null >/dev/null 2>&1');
	// at most about 15 s (the web interface waits for the answer): the app polls
	// status afterwards until the link or the connection is there
	let st = null, until = time() + 15;
	while (true) {
		sh('sleep 1');
		st = status();
		if (time() >= until || st.state == 'Running' || st.auth_url) break;
	}
	out(st);
}

function cmd_ping(p) {
	if (!match(p ?? '', PEER_RE)) die('invalid address');
	if (!pid()) die('Tailscale is not running');
	let r = cli([ 'ping', '--c', '1', '--timeout', '5s', p ]);
	let m = match(r.out, /pong from (\S+) \(([^)]*)\) via (.+?) in ([0-9.]+)ms/);
	if (!m) die('no answer' + (length(trim(r.out)) ? ': ' + trim(split(trim(r.out), '\n')[-1]) : ''));
	out({ ok: true, name: m[1], ip: m[2], via: m[3], ms: +m[4], direct: !match(m[3], /^DERP/) });
}

let arg = ARGV[1];
switch (ARGV[0]) {
case 'status': out(status()); break;
case 'up': up(false); break;
case 'login': up(true); break;
case 'down': {
	if (!pid()) die('Tailscale is not running');
	let r = cli([ 'down' ]);
	if (r.rc != 0) die(trim(r.out) || 'failed');
	out(status());
	break;
}
case 'logout': {
	if (!pid()) die('Tailscale is not running');
	cli([ 'logout' ]);
	set_enabled(false);
	out(status());
	break;
}
case 'ping': cmd_ping(arg); break;
case 'log': { let t = readfile(LOG) ?? ''; out({ log: length(t) > 16384 ? substr(t, length(t) - 16384) : t }); break; }
// the daemon runs whenever the system app is installed: it waits for the sign-in,
// and a box that was signed in connects again by itself (tailscaled keeps that)
case 'start': start(); out(status()); break;
case 'boot': if (installed()) { start(); out(status()); } else out({ started: false }); break;
case 'stop-all': stop(); out({ ok: true }); break;
default:
	print('usage: shareos-tailscale status|up|login|down|logout|ping <address>|log|boot|stop-all\n');
	exit(2);
}
