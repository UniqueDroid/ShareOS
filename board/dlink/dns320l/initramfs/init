#!/bin/sh
#
# ShareOS initramfs (lives in the 3 MB 'ramdisk' partition)
#
# Mounts the real system and switches to it:
#
#   flash (default)   UBI on the 'image' partition:
#                       volume rootfs      squashfs, read-only system
#                       volume rootfs_data UBIFS, writable overlay (settings, packages)
#   shareos.netroot=<tftp-server>
#                     fetch rootfs.squashfs via TFTP into RAM, overlay in tmpfs.
#                     Nothing is written to flash (development / testing).
#   shareos.rescue    stay in this initramfs
#
# If anything fails, the box stays in rescue mode: network via DHCP, SSH
# (dropbear) and the serial console, with the flash tools and
# shareos-install-ubi available. The USB LED (orange/red) blinks in rescue mode.
#
# SSH in rescue mode means root with the well-known password "shareos". After a
# failure it is therefore closed until someone at the box presses the USB
# button on the front; it then stays open for 30 minutes (the LED blinks
# fast). With shareos.rescue on the kernel command line – that needs the
# serial console – it is open at once.
#

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /mnt/ro /mnt/rw /newroot
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0755 tmpfs /run
exec </dev/console >/dev/console 2>&1

# which box: LED names and release file names (/usr/lib/shareos/board.sh)
. /usr/lib/shareos/board.sh
board_detect
LED=$BOARD_LED_USB

CMDLINE=$(cat /proc/cmdline)
log() { echo "shareos-init: $*"; }
arg() { for x in $CMDLINE; do case "$x" in "$1"=*) echo "${x#*=}"; return;; esac; done; }
has() { case " $CMDLINE " in *" $1 "*) return 0;; esac; return 1; }
led() { [ -e "/sys/class/leds/$1/trigger" ] && echo "$2" > "/sys/class/leds/$1/trigger"; }

mtd_by_name() { sed -n "s/^\(mtd[0-9]*\):.*\"$1\"\$/\1/p" /proc/mtd; }

# real MAC from the first 2 KB of the "mini firmware" partition (as Alt-F/D-Link)
set_mac() {
	m=$(mtd_by_name "mini firmware")
	[ -n "$m" ] || return
	mac=$(nanddump -q -l 2048 /dev/$m 2>/dev/null | grep -aoE '[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}' | head -1)
	[ -n "$mac" ] && ip link set dev eth0 address "$mac"
}

net_up() {
	set_mac
	ip link set lo up
	ip link set eth0 up
	i=0; while [ $i -lt 20 ] && [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" != 1 ]; do sleep 0.5; i=$((i+1)); done
	udhcpc -i eth0 -t 10 -T 2 -n -q -s /usr/share/udhcpc/default.script -x hostname:shareos
}

# /overlay/factory-reset (shareos-factory-reset): drop all settings and packages
factory_reset() {
	[ -e /mnt/rw/factory-reset ] || return 0
	log "factory reset: removing settings and packages"
	rm -rf /mnt/rw/upper /mnt/rw/work /mnt/rw/factory-reset /mnt/rw/upgrade
	sync
}

# /overlay/upgrade (shareos-update apply): write the staged system into the
# UBI volume 'rootfs' while it is not in use. The staged file is removed only
# after success, so an interrupted write is retried on the next boot.
apply_upgrade() {
	U=/mnt/rw/upgrade
	[ -f $U/rootfs.squashfs ] || return 0
	ver=$(cat $U/version 2>/dev/null)
	want=$(cut -c1-64 $U/rootfs.squashfs.sha256 2>/dev/null)
	have=$(sha256sum $U/rootfs.squashfs | cut -c1-64)
	if [ -z "$want" ] || [ "$want" != "$have" ] || [ "$(head -c 4 $U/rootfs.squashfs)" != hsqs ]; then
		log "upgrade: staged system is damaged, ignored"
		echo "failed $ver: staged image damaged" > /mnt/rw/upgrade-result
		rm -rf $U; sync
		return 0
	fi
	log "upgrade: installing system $ver – do not switch off"
	led "$LED" timer
	if ubiupdatevol "/dev/$ROOTVOL" $U/rootfs.squashfs; then
		echo "ok $ver" > /mnt/rw/upgrade-result
		rm -rf $U
		log "upgrade: done"
	else
		echo "failed $ver: ubiupdatevol" > /mnt/rw/upgrade-result
		log "upgrade: ubiupdatevol failed – will retry on the next boot"
	fi
	sync
	led "$LED" none
}

# the event device of the buttons (gpio-keys; "gpio_keys" on DNS-325/DNS-320)
button_dev() {
	for d in "${SHAREOS_INIT_SYS:-/sys}"/class/input/event*; do
		case "$(cat "$d/device/name" 2>/dev/null)" in
			gpio-keys|gpio_keys) echo "${SHAREOS_INIT_DEV:-/dev}/input/${d##*/}"; return 0 ;;
		esac
	done
	return 1
}

blink() {
	[ -d "/sys/class/leds/$LED" ] || return 0
	for d in delay_on delay_off; do echo "$1" > "/sys/class/leds/$LED/$d"; done
}

ssh_open() {
	mkdir -p /etc/dropbear 2>/dev/null
	dropbear -R -P "$RUN/dropbear.pid" 2>/dev/null
}

# Rescue mode after a failure: SSH opens when the USB button is pressed and
# closes again after RESCUE_SSH_TIME seconds (sessions that are open stay).
# A box without the buttons' device could not be reached at all: open at once.
RESCUE_SSH_TIME=${SHAREOS_INIT_SSH_TIME:-1800}
RUN=${SHAREOS_INIT_RUN:-/run}
ssh_gate() {
	dev=$(button_dev) || { log "no buttons found – SSH is open"; ssh_open; return; }
	log "SSH is closed: press the USB button on the front to open it for $((RESCUE_SSH_TIME / 60)) minutes"
	while :; do
		# one event of the kernel (16 bytes): seconds, microseconds, type,
		# code, value – od -d prints them as 16-bit numbers after the offset.
		# type 1 = key; code 133 (KEY_COPY) or 161 (KEY_EJECTCD) = USB button
		ev=$(dd if="$dev" bs=16 count=1 2>/dev/null | od -d | head -n 1)
		[ -n "$ev" ] || { sleep 1; continue; }
		read -r _ _ _ _ _ typ code _ <<-EOF
		$ev
		EOF
		[ "$typ" = 1 ] || continue
		case "$code" in 133|161) ;; *) continue ;; esac
		log "USB button: SSH is open for $((RESCUE_SSH_TIME / 60)) minutes"
		ssh_open
		blink 100
		sleep "$RESCUE_SSH_TIME"
		kill "$(cat "$RUN/dropbear.pid" 2>/dev/null)" 2>/dev/null
		blink 500
		log "SSH is closed again (USB button: open it once more)"
	done
}

RESCUE_ASKED=0
rescue() {
	log "RESCUE MODE: $*"
	led "$LED" timer
	# slow blink (the first installation blinks fast)
	blink 500
	net_up || udhcpc -i eth0 -b -s /usr/share/udhcpc/default.script -x hostname:shareos
	ip=$(ip -4 addr show eth0 | sed -n 's/.*inet \([0-9.]*\).*/\1/p')
	if [ "$RESCUE_ASKED" = 1 ]; then
		ssh_open
		how="ssh root@${ip:-<no ip>}   (password: shareos)"
	else
		ssh_gate &
		how="press the USB button on the front, then within $((RESCUE_SSH_TIME / 60)) minutes:
	  ssh root@${ip:-<no ip>}   (password: shareos)"
	fi
	cat > /etc/motd <<-EOF

	ShareOS rescue system – $*
	  $how
	  shareos-install-ubi <rootfs.squashfs>   install the system into flash
	  reboot

	EOF
	cat /etc/motd
	while true; do
		getty -L 115200 ttyS0 vt100
		sleep 1
	done
}

# ShareOS .bin flashed from the Alt-F/D-Link web interface: fetch and install
# the system (USB stick/disk or GitHub), then restart into it
first_install() {
	log "$1 – starting the first installation"
	net_up >/dev/null 2>&1 || log "no DHCP lease (only a USB stick can be used)"
	if shareos-firstinstall; then
		sync
		log "first installation done – restarting"
		sleep 2
		reboot -f
	fi
	rescue "first installation failed: $(cat /tmp/firstinstall.err 2>/dev/null)
	  Put ShareOS-<version>-${BOARD_FWNAME:-<model>}.sysupgrade.tar on a USB stick (FAT/exFAT/ext4)
	  and restart the box, or check the network cable. Log: /tmp/firstinstall.log"
}

has shareos.rescue && { RESCUE_ASKED=1; rescue "requested on the kernel command line"; }

NETROOT=$(arg shareos.netroot)

if [ -n "$NETROOT" ]; then
	log "network root from tftp://$NETROOT/rootfs.squashfs"
	net_up || rescue "no DHCP lease"
	mount -t tmpfs -o mode=0755 tmpfs /mnt/rw
	tftp -b 1468 -g -r rootfs.squashfs -l /mnt/rw/rootfs.squashfs "$NETROOT" || rescue "TFTP download failed"
	mount -t squashfs -o ro,loop /mnt/rw/rootfs.squashfs /mnt/ro || rescue "cannot mount the downloaded rootfs"
	log "running from RAM – nothing is written to flash"
else
	MTD=$(mtd_by_name image)
	[ -n "$MTD" ] || rescue "flash partition 'image' not found"
	# only touch the partition if it really carries UBI (never attach foreign data)
	# a read error must never look like "no system" (that would format the flash)
	nanddump -q -l 2048 -f /tmp/mtd-head /dev/$MTD 2>/dev/null || rescue "cannot read flash partition 'image'"
	[ "$(stat -c %s /tmp/mtd-head 2>/dev/null)" = 2048 ] || rescue "cannot read flash partition 'image'"
	if [ "$(head -c 4 /tmp/mtd-head)" != "UBI#" ]; then
		first_install "no ShareOS system in flash yet"
	fi
	ubiattach -m "${MTD#mtd}" >/dev/null || rescue "ubiattach failed"
	ROOTVOL=""; DATAVOL=""
	for v in /sys/class/ubi/ubi0_*; do
		case "$(cat "$v/name" 2>/dev/null)" in
			rootfs) ROOTVOL=$(basename "$v") ;;
			rootfs_data) DATAVOL=$(basename "$v") ;;
		esac
	done
	if [ -z "$ROOTVOL" ] && [ -z "$DATAVOL" ]; then
		# UBI of another firmware (Alt-F keeps its extra packages there)
		ubidetach -m "${MTD#mtd}" 2>/dev/null
		first_install "flash holds another firmware's data, no ShareOS system"
	fi
	[ -n "$ROOTVOL" ] || rescue "UBI volume 'rootfs' missing"
	if mount -t ubifs ubi0:rootfs_data /mnt/rw 2>/dev/null; then
		factory_reset
		apply_upgrade
	else
		log "WARNING: rootfs_data not available, settings will not be kept"
		mount -t tmpfs -o mode=0755 tmpfs /mnt/rw
	fi
	ubiblock --create "/dev/$ROOTVOL" || rescue "ubiblock failed"
	mount -t squashfs -o ro "/dev/ubiblock${ROOTVOL#ubi}" /mnt/ro || rescue "cannot mount rootfs"
fi

# a new overlay (first installation, factory reset, no settings volume): the
# box is new and waits to be claimed (/overlay/claim, see S03claim). An update
# keeps the overlay, so boxes in use are never locked by it.
[ -d /mnt/rw/upper ] || : > /mnt/rw/claim
mkdir -p /mnt/rw/upper /mnt/rw/work
mount -t overlay overlay -o lowerdir=/mnt/ro,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work /newroot \
	|| rescue "overlay mount failed"
[ -x /newroot/sbin/init ] || rescue "rootfs has no /sbin/init"

mkdir -p /newroot/rom /newroot/overlay
mount --move /mnt/ro /newroot/rom
mount --move /mnt/rw /newroot/overlay

# hand the network back unconfigured (the MAC stays): the system's own
# S40network brings up lo and eth0 again and fails on existing addresses
if [ -n "$NETROOT" ]; then
	killall udhcpc 2>/dev/null
	ip addr flush dev eth0
	ip route flush dev eth0 2>/dev/null
	ip addr flush dev lo
	ip link set lo down
fi

umount /dev/pts /run 2>/dev/null
umount /proc /sys
mount --move /dev /newroot/dev 2>/dev/null || umount /dev
exec switch_root /newroot /sbin/init
