# ShareOS additions to buildroot's busybox config
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
CONFIG_FEATURE_NTPD_CONF=y
CONFIG_CHPASSWD=y
# cloud jobs: time limits and stopping a running rclone
CONFIG_TIMEOUT=y
CONFIG_PGREP=y
CONFIG_PKILL=y
# file age/size for Paperless inboxes and logs
CONFIG_STAT=y
CONFIG_FEATURE_STAT_FORMAT=y
# snapshots: rsync at the lowest disk priority
CONFIG_IONICE=y
