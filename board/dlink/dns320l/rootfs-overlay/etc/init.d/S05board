#!/bin/sh
#
# ShareOS – board bring-up for the D-Link boxes (models: /usr/lib/shareos/board.sh)
#
# - /tmp/sys/board.env: which box this is (read by the other scripts and rpcd)
# - LEDs and the Alt-F style /tmp/sys interface (temperature, fan, power LED)
# - BOARD_CONTROL=mcu: dns320l-daemon talks to the Weltrend MCU on /dev/ttyS1
#   (fan, temperature, power LED, RTC, power-off)
# - shareos-board: fan curve, temperature of kernel sensors, polled power button
# - shareos-buttons: reset, USB and power buttons (gpio-keys events)
#

DAEMON=/usr/sbin/dns320l-daemon
PIDFILE=/var/run/dns320l-daemon.pid
BOARDPID=/var/run/shareos-board.pid
BUTTONPID=/var/run/shareos-buttons.pid
BUTTONDDPID=/var/run/shareos-buttons-dd.pid   # the dd that feeds shareos-buttons

. /usr/lib/shareos/board.sh
board_detect

# The real MAC address is stored at the start of the "mini firmware"
# partition; without this eth0 keeps the Marvell default 00:50:43:00:02:02.
set_mac() {
	mtd=$(sed -n 's/^\(mtd[0-9]*\):.*"mini firmware"$/\1/p' /proc/mtd)
	[ -n "$mtd" ] || return
	mac=$(nanddump -q -l 2048 /dev/$mtd 2>/dev/null | grep -aoE '[[:xdigit:]]{2}(:[[:xdigit:]]{2}){5}' | head -1)
	cur=$(cat /sys/class/net/eth0/address 2>/dev/null)
	# already set by the initramfs (netroot) -> nothing to do
	if [ -n "$mac" ] && [ "$(echo "$mac" | tr A-F a-f)" != "$cur" ]; then
		ip link set dev eth0 address "$mac" && echo -n "MAC $mac, "
	fi
}

# "chip:line" -> set the line high (the box switches on again after a power cut)
gpio_high() {
	[ -n "$1" ] || return 0
	# gpioset keeps the line requested (and high) while it runs
	start-stop-daemon -S -q -b -x /usr/bin/gpioset -- -c "${1%%:*}" "${1#*:}=1"
}

start() {
	printf "Starting board support (%s): " "$BOARD_NAME"
	mkdir -p /tmp/sys
	board_env > /tmp/sys/board.env
	set_mac

	mkdir -p /tmp/sys/power_led
	echo none > /tmp/sys/power_led/trigger
	echo 1    > /tmp/sys/power_led/brightness
	echo 100  > /tmp/sys/pwm1          # fan half speed until the first reading
	echo 0    > /tmp/sys/fan1_input

	board_led "$BOARD_LED_USB" none 0
	# status LED (heartbeat by default), disk LEDs, power LED: UCI shareos.led
	/usr/sbin/shareos-leds
	gpio_high "$BOARD_POWER_BACK"

	if [ "$BOARD_ID" = unknown ]; then
		echo "unknown box ($BOARD_NAME), skipped"
		return 0
	fi
	if [ "$BOARD_CONTROL" = mcu ]; then
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" -- -f
	fi
	start-stop-daemon -S -q -b -m -p "$BOARDPID" -x /usr/sbin/shareos-board
	# reset button (access/factory reset), USB button (remove USB drives), power button
	start-stop-daemon -S -q -b -m -p "$BUTTONPID" -x /usr/sbin/shareos-buttons
	# system time from the RTC (UTC); ntpd refines it later
	if [ "$BOARD_RTC" = mcu ]; then
		i=0
		while [ $i -lt 10 ]; do
			"$DAEMON" -x hctosys >/dev/null 2>&1 && { echo -n "time $(date '+%F %T'), "; break; }
			sleep 0.5; i=$((i + 1))
		done
	elif [ -e /dev/rtc0 ]; then
		hwclock -s -u 2>/dev/null && echo -n "time $(date '+%F %T'), "
	fi
	echo "OK"
}

stop() {
	printf "Stopping board support: "
	# keep the RTC in sync, but never write a clock that was never set
	if [ "$(date +%Y)" -ge 2025 ]; then
		if [ "$BOARD_RTC" = mcu ]; then "$DAEMON" -x systohc >/dev/null 2>&1
		elif [ -e /dev/rtc0 ]; then hwclock -w -u 2>/dev/null
		fi
	fi
	start-stop-daemon -K -q -p "$BOARDPID" 2>/dev/null
	start-stop-daemon -K -q -p "$BUTTONPID" 2>/dev/null
	# its dd would wait for the next button press before it notices that nobody reads it
	start-stop-daemon -K -q -p "$BUTTONDDPID" 2>/dev/null
	rm -f "$BUTTONDDPID"
	start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
	sleep 1
	# shut down on UPS battery: the UPS switches its output off now and on
	# again when the power is back – and the box starts with it
	[ -f /tmp/.poweroff ] && [ -x /usr/sbin/shareos-ups ] && /usr/sbin/shareos-ups killpower
	if [ -f /tmp/.poweroff ] && [ "$BOARD_CONTROL" = mcu ]; then
		# ask the MCU to cut power 3 seconds from now (other boxes: gpio-poweroff in the kernel)
		sync
		"$DAEMON" -x DeviceShutdown 3 >/dev/null 2>&1
		echo "power-off requested from MCU"
	else
		echo "OK"
	fi
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
