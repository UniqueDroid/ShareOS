#!/bin/sh
#
# ShareOS – fan control and polled power button (models: /usr/lib/shareos/board.sh)
#
# The temperature (millidegrees) is in /tmp/sys/temp1_input and the fan
# setting in /tmp/sys/pwm1 (0 = stop, 1..127 = half, 128..255 = full) – the
# interface the web interface reads, the same on every box:
#   BOARD_CONTROL=mcu       dns320l-daemon writes the MCU temperature there
#                           and applies pwm1 to the MCU's fan
#   BOARD_CONTROL=hwmon     temperature from the lm75 sensor, fan through the
#                           kernel's gpio-fan (both hwmon)
#   BOARD_CONTROL=mcu-temp  temperature asked from the MCU on ttyS1 (DNS-320
#                           rev A protocol), fan through gpio-fan
# The curve comes from UCI shareos.fan (presets or custom temperatures) and is
# re-read every cycle, so changes apply within seconds.
#
# A reading older than MAX_AGE seconds is not used (the MCU or the sensor does
# not answer any more): after MISS_MAX cycles without a fresh value the fan
# goes to full speed until readings come back. The web interface and
# shareos-notify use the same age limit.
#

. "${SHAREOS_BOARD_LIB:-/usr/lib/shareos/board.sh}"
board_detect
R=${SHAREOS_ROOT:-}          # tests: fake root; SHAREOS_BOARD_ONCE=1: one cycle

PRESETS=${SHAREOS_BOARD_LIB:-/usr/lib/shareos/board.sh}; PRESETS=${PRESETS%/*}/fan-presets
OFF=0; HALF=100; FULL=255
MAX_AGE=90
MISS_MAX=${SHAREOS_BOARD_MISS_MAX:-6}
armed=0
state=half
misses=0

# --- kernel sensors (hwmon) ---
hwmon() {   # name of the hwmon device -> its folder
	for d in $R/sys/class/hwmon/hwmon*; do
		[ "$(cat "$d/name" 2>/dev/null)" = "$1" ] && { echo "$d"; return 0; }
	done
	return 1
}
FAN_HW=; TEMP_HW=
if [ "$BOARD_CONTROL" != mcu ]; then
	FAN_HW=$(hwmon gpio_fan)
	[ -n "$FAN_HW" ] && echo 1 > "$FAN_HW/pwm1_enable" 2>/dev/null
fi
[ "$BOARD_CONTROL" = hwmon ] && TEMP_HW=$(hwmon lm75)

# DNS-320 rev A: the MCU on ttyS1 answers "f0 f0 d0 x 02 <°C> … cs cs cs"
mcu_temp() {
	stty -F /dev/ttyS1 cs8 -cstopb -crtscts -ixon -ixoff -ignpar cread raw -echo 19200 2>/dev/null || return 1
	printf '\360\360\020\004\002\000\000\000\000\000\000\000\000\366\366\366' > /dev/ttyS1
	set -- $(timeout 2 dd if=/dev/ttyS1 bs=1 count=16 2>/dev/null | od -An -tu1)
	while [ $# -ge 6 ]; do
		[ "$1" = 240 ] && [ "$2" = 240 ] && [ "$3" = 208 ] && [ "$6" -gt 0 ] && { echo $(($6 * 1000)); return 0; }
		shift
	done
	return 1
}

read_temp() {
	case "$BOARD_CONTROL" in
		hwmon)
			[ -n "$TEMP_HW" ] && v=$(cat "$TEMP_HW/temp1_input" 2>/dev/null) && echo "$v" > $R/tmp/sys/temp1_input ;;
		mcu-temp)
			v=$(mcu_temp) && echo "$v" > $R/tmp/sys/temp1_input ;;
	esac
	# only a value written in the last MAX_AGE seconds counts
	m=$(stat -c %Y $R/tmp/sys/temp1_input 2>/dev/null) || return 1
	[ $(($(date +%s) - m)) -le $MAX_AGE ] || return 1
	cat $R/tmp/sys/temp1_input 2>/dev/null
}

# power button without interrupt (BOARD_POWER_BUTTON=chip:line): low = pressed;
# it can read low at boot, so only arm it after it has been seen released once.
read_button() {
	gpioget --numeric -c "${BOARD_POWER_BUTTON%%:*}" "${BOARD_POWER_BUTTON#*:}" 2>/dev/null
}

# "off full half" (°C) of a preset
preset_curve() {
	awk -v p="$1" '$1 == p && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ {print $2, $3, $4; exit}' "$PRESETS" 2>/dev/null
}

# sets OFF_T FULL_T HALF_T (millidegrees; OFF_T=0 means never stop)
read_curve() {
	p=$(uci -q get shareos.fan.preset || echo balanced)
	if [ "$p" = custom ]; then
		o=$(uci -q get shareos.fan.off_temp || echo 0)
		f=$(uci -q get shareos.fan.full_temp || echo 50)
		h=$(uci -q get shareos.fan.half_temp || echo 45)
	else
		# the presets are defined in one file (the web interface reads it too);
		# an unknown name or a missing file: the fan never stops
		c=$(preset_curve "$p"); [ -n "$c" ] || c=$(preset_curve balanced); [ -n "$c" ] || c="0 50 45"
		o=${c%% *}; h=${c##* }; f=${c#* }; f=${f% *}
	fi
	OFF_T=$((o * 1000)); FULL_T=$((f * 1000)); HALF_T=$((h * 1000))
	[ $HALF_T -lt $FULL_T ] || HALF_T=$((FULL_T - 3000))
}

set_fan() {
	[ "$state" = "$1" ] && return
	case "$1" in off) v=$OFF ;; half) v=$HALF ;; full) v=$FULL ;; esac
	echo $v > $R/tmp/sys/pwm1
	# gpio-fan: the kernel picks the nearest speed of the box's speed map
	[ -n "$FAN_HW" ] && echo $v > "$FAN_HW/pwm1" 2>/dev/null
	logger -t shareos-board "temperature ${t:-unknown }m°C, fan $1"
	state=$1
}

[ -n "$FAN_HW" ] && echo $HALF > "$FAN_HW/pwm1" 2>/dev/null

while true; do
	read_curve
	t=$(read_temp)
	case "$t" in
		''|*[!0-9]*)
			# no fresh reading: after a while cool as much as possible
			t=
			misses=$((misses + 1))
			if [ $misses -eq "$MISS_MAX" ]; then
				logger -t shareos-board "no temperature reading for $MISS_MAX cycles - fan to full speed"
				set_fan full
			fi
			;;
		*)
			misses=0
			if [ "$t" -ge "$FULL_T" ]; then
				set_fan full
			elif [ "$state" = full ] && [ "$t" -gt "$HALF_T" ]; then
				:                                   # stay full until below half_temp
			elif [ "$OFF_T" -gt 0 ] && [ "$t" -lt $((OFF_T - 2000)) ]; then
				set_fan off                         # 2 °C hysteresis around off_temp
			elif [ "$state" = off ] && [ "$t" -lt "$OFF_T" ]; then
				:
			else
				set_fan half
			fi
			;;
	esac

	[ -n "${SHAREOS_BOARD_ONCE:-}" ] && exit 0
	if [ -z "$BOARD_POWER_BUTTON" ]; then
		sleep 5
		continue
	fi
	# poll the power button ten times over the next 5 s
	i=0
	while [ $i -lt 10 ]; do
		b=$(read_button)
		if [ "$b" = 1 ]; then
			armed=1
		elif [ "$b" = 0 ] && [ $armed = 1 ]; then
			# not while kernel or system are being written
			if /usr/sbin/shareos-update busy >/dev/null 2>&1; then
				logger -t shareos-board "power button ignored: firmware is being written"
				armed=0
			else
				logger -t shareos-board "power button pressed, powering off"
				/sbin/poweroff
				exit 0
			fi
		fi
		sleep 0.5
		i=$((i + 1))
	done
done
