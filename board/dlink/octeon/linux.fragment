# ShareOS kernel fragment for the Cavium OCTEON boxes (D-Link DNS-1200-05),
# applied on top of cavium_octeon_defconfig.
#
# The box's U-Boot 1.1.1 (Cavium SDK) starts an ELF file with "bootoctlinux"
# and passes no device tree: the kernel takes its built-in one for the board
# type the bootloader reports (EBH5200) – see arch/mips/cavium-octeon/setup.c.
# The whole system is the initramfs inside that ELF file.

# --- Size / boot ----------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_COMPRESSION_XZ=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_FS is not set
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
# the kernel's .config in /proc/config.gz: asked for with the device info
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# OCTEON Plus CN5230: four cores; the 64-bit system needs no 32-bit programs
CONFIG_NR_CPUS=4
# CONFIG_CAVIUM_CN63XXP1 is not set
# CONFIG_MIPS32_O32 is not set
# CONFIG_MIPS32_N32 is not set
# CONFIG_OCTEON_ILM is not set
# used when the bootloader passes no console (it does: console=ttyS0,115200)
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="panic=10"

# --- Storage ---------------------------------------------------------------------
# five bays: two Silicon Image SiI3132 on PCIe, one port through a SiI5723
CONFIG_ATA=y
CONFIG_SATA_SIL24=y
CONFIG_SATA_PMP=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT2_FS=m
CONFIG_VFAT_FS=m
CONFIG_MSDOS_FS=m
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_BLK_DEV_DM=m
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
# /proc/mtd exists (the scripts read it); mainline has no driver for the NAND
# flash on the OCTEON boot bus, so ShareOS cannot reach the box's flash
CONFIG_MTD=y
# CONFIG_MTD_BLOCK is not set
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_SLRAM is not set
# CONFIG_MMC is not set

# --- USB -------------------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_STORAGE=y
CONFIG_USB_PRINTER=m
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_DWC3 is not set

# --- Network ---------------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=m
CONFIG_PACKET=y
CONFIG_UNIX=y
# two SGMII ports with Marvell 88E1112 PHYs
CONFIG_STAGING=y
CONFIG_OCTEON_ETHERNET=y
CONFIG_MARVELL_PHY=y
# CONFIG_IP_PNP is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_WLAN is not set
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NFS_FS=m
CONFIG_NFSD=m
CONFIG_NFSD_V4=y
CONFIG_SMB_SERVER=m
CONFIG_CIFS=m
CONFIG_TUN=y
CONFIG_NETCONSOLE=y
CONFIG_NETPOLL=y

# --- Board peripherals -------------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_I2C=y
CONFIG_I2C_OCTEON=y
CONFIG_I2C_CHARDEV=m
CONFIG_GPIO_CDEV=y
CONFIG_RTC_CLASS=y
CONFIG_WATCHDOG=y
# as a module: nothing may arm the watchdog before a daemon feeds it
CONFIG_OCTEON_WDT=m
# CONFIG_SPI is not set
# CONFIG_EDAC is not set
# CONFIG_SOUND is not set
# CONFIG_VT is not set

# --- Base system -------------------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_CODEPAGE_850=m
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_ISO8859_15=m
CONFIG_MAGIC_SYSRQ=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y

# --- Hardening (as on the other boxes) ----------------------------------------------
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_LEGACY_PTYS is not set
