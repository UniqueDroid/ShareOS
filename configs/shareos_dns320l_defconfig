# ShareOS – D-Link DNS-320L rev Ax (phase-1 test system)
# Build: make dns320l   (see Makefile / docs/BUILD.md)

# --- Architecture: Marvell Kirkwood 88F6702, ARMv5TE, no FPU ---
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

# --- Build options ---
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_SHAREOS_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_OPTIMIZE_S=y
BR2_SHARED_LIBS=y

# --- Toolchain: buildroot internal, musl ---
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y

# --- System ---
BR2_TARGET_GENERIC_HOSTNAME="shareos"
BR2_TARGET_GENERIC_ISSUE="ShareOS phase-1 test system"
BR2_TARGET_GENERIC_ROOT_PASSWD="shareos"
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Berlin"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/post-image.sh"

# --- Kernel: current LTS, appended DTB for the stock U-Boot ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.57"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="mvebu_v5"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/linux.fragment"
BR2_LINUX_KERNEL_APPENDED_ZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# one kernel for the Kirkwood models, a zImage with appended DTB per model
# (post-image.sh makes a .bin per model)
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/dts/kirkwood-dns320l.dts $(BR2_EXTERNAL_SHAREOS_PATH)/board/dlink/dns320l/dts/kirkwood-dns320b.dts"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="marvell/kirkwood-dns320 marvell/kirkwood-dns325"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- Packages for the test system ---
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_LIBGPIOD2=y
BR2_PACKAGE_LIBGPIOD2_TOOLS=y
BR2_PACKAGE_ALT_F_UTILS=y

# --- Core stack (phase 3): UCI config, ubus, rpcd + ucode backend, uhttpd ---
BR2_PACKAGE_UCI=y
BR2_PACKAGE_UBUS=y
BR2_PACKAGE_UCODE=y
BR2_PACKAGE_RPCD=y
BR2_PACKAGE_UHTTPD=y
BR2_PACKAGE_SHAREOS_CORE=y
BR2_PACKAGE_SHAREOS_TUYA=y
# HTTPS client with certificate checking for the GitHub updater
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_CA_CERTIFICATES=y

# --- Images ---
# Full system as squashfs (goes into the UBI volume "rootfs"); the small
# initramfs for the 'ramdisk' partition is assembled by post-image.sh.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set

# --- Host tools for the D-Link firmware container ---
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_ALT_F_UTILS=y
BR2_PACKAGE_GESFTPSERVER=y
# snapshots (rsync with hard links)
BR2_PACKAGE_RSYNC=y
# setfacl: the rights of a share also as POSIX ACLs on its folder
BR2_PACKAGE_ACL=y
# storage (phase 4): partitioning, ext4, RAID, SMART, spindown
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_BTRFS_PROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_MDADM=y
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_HDPARM=y
# HTTPS for the web interface (uhttpd TLS via ustream-ssl/mbedtls,
# mbedtls programs for the self-signed certificate)
BR2_PACKAGE_USTREAM_SSL=y
BR2_PACKAGE_MBEDTLS_PROGRAMS=y
# web terminal (System -> Terminal)
BR2_PACKAGE_TTYD=y

# shares and users (ksmbd, NFS, quota)
BR2_PACKAGE_KSMBD_TOOLS=y
BR2_PACKAGE_AVAHI=y
# BR2_PACKAGE_AVAHI_AUTOIPD is not set
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_QUOTA=y
