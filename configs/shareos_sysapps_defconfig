# ShareOS system apps (type "system"): native programs such as nano and htop,
# built with the firmware's toolchain and packed as .sapp by
# tools/sysapps/pack.py. Not a firmware image.
# Build: make dns320l (once, for the toolchain), then make sysapps

# --- Architecture: as the firmware (Kirkwood, ARMv5TE, no FPU) ---
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# patches (patches/<package>/), e.g. libevent for Transmission on a Unix socket
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_SHAREOS_PATH)/patches"
BR2_OPTIMIZE_S=y
BR2_SHARED_LIBS=y

# --- Toolchain: the one the firmware build made (same musl, same gcc) ---
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_SHAREOS_PATH)/output/dns320l/host"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="$(ARCH)-buildroot-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_18=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# --- nothing else of a system ---
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_TARGET_ROOTFS_TAR is not set

# --- the system apps ---
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_NANO=y
# BR2_PACKAGE_NANO_TINY is not set
BR2_PACKAGE_BASH=y
# OpenVPN (system app "openvpn", NetTunnel)
BR2_PACKAGE_OPENVPN=y
# Tailscale (system app "tailscale"): one binary, see package/shareos-tailscale
BR2_PACKAGE_HOST_GO_BIN=y
BR2_PACKAGE_SHAREOS_TAILSCALE=y
# autobrr (system app "autobrr"), see package/shareos-autobrr
BR2_PACKAGE_SHAREOS_AUTOBRR=y
# Zabbix agent, classic C version (system app "zabbix-agent"), see
# package/shareos-zabbix-agent
BR2_PACKAGE_SHAREOS_ZABBIX_AGENT=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_TRANSMISSION=y
BR2_PACKAGE_TRANSMISSION_DAEMON=y
# ffmpeg for media conversion (ShareOS media service): remux, trim, audio;
# no video encoders (an ARMv5 without FPU is far too slow for that)
BR2_PACKAGE_LAME=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_OPUS_FIXED_POINT=y
BR2_PACKAGE_FFMPEG=y
# MiniDLNA (system app "minidlna", uses the same FFmpeg libraries)
BR2_PACKAGE_MINIDLNA=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFPROBE=y
# BR2_PACKAGE_FFMPEG_SWSCALE is not set
# BR2_PACKAGE_FFMPEG_INDEVS is not set
# BR2_PACKAGE_FFMPEG_OUTDEVS is not set
BR2_PACKAGE_FFMPEG_ENCODERS="libmp3lame aac flac pcm_s16le libopus"
BR2_PACKAGE_FFMPEG_DECODERS="aac aac_fixed mp3 mp3float mp2 flac vorbis opus alac ac3 ac3_fixed eac3 wmav1 wmav2 pcm_s16le pcm_s16be pcm_s24le pcm_s32le pcm_f32le pcm_u8"
BR2_PACKAGE_FFMPEG_MUXERS="mp4 mov ipod matroska webm mp3 flac ogg opus wav adts mpegts avi"
BR2_PACKAGE_FFMPEG_DEMUXERS="mov matroska avi mpegts mp3 flac ogg wav aac ac3 eac3 asf mpegps"
BR2_PACKAGE_FFMPEG_PARSERS="aac ac3 flac h264 hevc mpeg4video mpegvideo mpegaudio opus vorbis vp8 vp9 av1"
BR2_PACKAGE_FFMPEG_BSFS="aac_adtstoasc h264_mp4toannexb hevc_mp4toannexb extract_extradata vp9_superframe"
BR2_PACKAGE_FFMPEG_PROTOCOLS="file pipe"
BR2_PACKAGE_FFMPEG_FILTERS="aresample aformat anull null abuffer abuffersink buffer buffersink"
BR2_PACKAGE_FFMPEG_EXTRACONF="--disable-network --disable-openssl --disable-autodetect --enable-zlib --enable-libmp3lame --enable-libopus"
