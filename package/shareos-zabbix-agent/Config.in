config BR2_PACKAGE_SHAREOS_ZABBIX_AGENT
	bool "shareos-zabbix-agent"
	depends on BR2_USE_MMU # fork()
	select BR2_PACKAGE_PCRE2
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBOPENSSL
	help
	  The classic Zabbix agent (zabbix_agentd, written in C) for the
	  system app "zabbix-agent": only the agent – no server, proxy,
	  Java gateway or Go agent 2. A few MB of memory, so it fits the
	  small NAS boxes. Buildroot's own "zabbix" package needs glibc;
	  this one builds with musl. OpenSSL for encrypted connections
	  (PSK or certificates).

	  https://www.zabbix.com/
